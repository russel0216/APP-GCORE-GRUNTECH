# G-CORE Gruntech — production configuration.
#
#   Copy to C:\G-CORE-GRUNTECH\api\.env and fill in the two marked values.
#
# Anything left as it ships here is wrong for production. The app refuses to
# start with the development JWT secret, which is the one mistake that would
# otherwise go unnoticed for months.

# ── Database ─────────────────────────────────────────────────────────────────
# Host port 5435, matching deploy/docker-compose.prod.yml. NOT 5433 — that is
# gasion_db, the other apps' database.
# FILL IN: the same password as GCORE_DB_PASSWORD in deploy\.env (hex, so it
# needs no escaping in this URL).
DATABASE_URL="postgresql://gcore:CHANGE_ME_BEFORE_FIRST_START@localhost:5435/gcore"

# ── The app ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5100

# FILL IN. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this later signs everyone out, which is the point of it being a
# secret and not a setting.
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# ── Files ────────────────────────────────────────────────────────────────────
# Outside the repository, so a `git pull` or a fresh clone never touches the
# company logo, the attachments or the clock-in photos.
UPLOAD_DIR="C:\\G-CORE-GRUNTECH\\data\\uploads"
MAX_UPLOAD_MB=25

# ── Origins ──────────────────────────────────────────────────────────────────
# In production the API serves the web app itself, so requests are same-origin
# and CORS is not in play for ordinary use. This is here for the Android app
# and anything else that calls the API cross-origin.
CORS_ORIGIN="https://gruntech.gcore.tech"

# The public address printed in meeting and training invitations (.ics files,
# Google Calendar hand-offs). Defaults to the address below in production.
APP_URL="https://gruntech.gcore.tech"

# ── Email: invitations and password resets ───────────────────────────────────
# Leave SMTP_HOST empty and email stays off: an administrator is shown each
# invitation or reset link to pass on by Messenger or Viber, and the sign-in
# page's "Forgot password?" says to ask an administrator.
#
# Any mailbox's SMTP works. Google Workspace: smtp.gmail.com, port 465, the
# mailbox address as SMTP_USER and an APP PASSWORD (Google Account > Security >
# App passwords — needs 2-step verification) as SMTP_PASS, never the mailbox's
# own password. Microsoft 365: smtp.office365.com, port 587. A web host's
# mailbox: the host's SMTP server and port from its email settings page.
# Port 465 connects encrypted; 587 upgrades with STARTTLS. G-CORE refuses to
# send the password over a connection that is not encrypted.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_USER="no-reply@gruntechnology.com"
# SMTP_PASS="the-app-password"
# MAIL_FROM="G-CORE <no-reply@gruntechnology.com>"

# ── First run only ───────────────────────────────────────────────────────────
# Read by the seed script and by nothing else. Change the password the moment
# you have signed in; it is written to this file in plain text.
SEED_ADMIN_EMAIL="admin@gruntech.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
