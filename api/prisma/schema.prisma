// G-CORE — Phase 1 (Foundation) schema.
//
// One database, one schema. Divisions are modules in this schema, never
// separate databases — see docs/BUSINESS-OPERATIONS-MODEL.md §10.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════════════
//  IDENTITY & ACCESS
// ════════════════════════════════════════════════════════════════════

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  name          String
  employeeNo    String? @unique
  passwordHash  String
  position      String?
  /// The author's mobile, printed under "Sincerely Yours," on a quotation
  /// (carried over from SCORO's quote layout). The login's own number, because
  /// an account need not have an Employee record behind it.
  phone         String?
  isActive      Boolean @default(true)
  isSuperAdmin  Boolean @default(false)
  /// Invited, and not yet in: the account exists (so it can be assigned work
  /// and approvals) but nobody has chosen its password. Cleared when the
  /// invitation — or a password reset — is used. See AccountToken.
  invitePending Boolean @default(false)

  /// Attachment id, not a disk path (same convention as FaceEnrollment.photoPath) —
  /// the most recent verified capture from face enrolment, or a plain upload for
  /// an account with no linked employee. Cosmetic only: nothing reads this for
  /// matching, so replacing it can never affect who clocks in as whom.
  photoPath String?

  // Approval routing: "approvers are to whom they are directly reporting".
  supervisorId String?
  supervisor   User?   @relation("Supervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  reports      User[]  @relation("Supervision")

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  roles     UserRole[]
  overrides UserPermissionOverride[]

  notifications          Notification[]
  savedFilters           SavedFilter[]
  attachments            Attachment[]
  auditLogs              AuditLog[]
  approvalsRaised        ApprovalRequest[] @relation("Requester")
  approvalActions        ApprovalAction[]
  workflowStepsTargeting ApprovalStep[]    @relation("StepUser")

  employee         Employee?
  customersCreated Customer[]        @relation("CustomerCreator")
  suppliersCreated Supplier[]        @relation("SupplierCreator")
  partnerResources PartnerResource[] @relation("PartnerResourceCreator")

  leadsAssigned     Lead[]                 @relation("LeadAssignee")
  leadsCreated      Lead[]                 @relation("LeadCreator")
  costingsOwned     Costing[]              @relation("CostingOwner")
  salesOrdersOwned  SalesOrder[]           @relation("SalesOrderOwner")
  costingsAssigned  Costing[]              @relation("CostingAssigner")
  costingTemplates  CostingTemplate[]      @relation("CostingTemplateAuthor")
  quotationsOwned   Quotation[]            @relation("QuotationOwner")
  revisionsApproved QuotationRevision[]    @relation("RevisionApprover")
  activities        SalesActivity[]        @relation("ActivityAssignee")
  activityInvites   SalesActivityInvitee[]

  clearancesRaised       EmployeeClearance[]  @relation("ClearanceRaiser")
  clearancesReceived     EmployeeClearance[]  @relation("ClearanceReceiver")
  clearanceItemsCleared  ClearanceItem[]      @relation("ClearanceClearer")
  meetingsOrganized      Meeting[]            @relation("MeetingOrganizer")
  meetingInvites         MeetingInvitee[]     @relation("MeetingInvitee")
  evaluationsGiven       EmployeeEvaluation[] @relation("Evaluator")
  evaluationsScheduled   EmployeeEvaluation[] @relation("EvaluationScheduler")
  sessionsTrained        TrainingSession[]    @relation("SessionTrainer")
  sessionsCreated        TrainingSession[]    @relation("SessionCreator")
  attendeesEnrolled      TrainingAttendee[]   @relation("AttendeeEnroller")
  trainingVerified       TrainingRecord[]     @relation("TrainingVerifier")
  trainingRecordsCreated TrainingRecord[]     @relation("TrainingRecordAuthor")

  jobsManaged     Job[]            @relation("JobManager")
  jobsCreated     Job[]            @relation("JobCreator")
  costEntries     JobCostEntry[]
  budgetRequests  BudgetRequest[]  @relation("BudgetRequester")
  reportsPrepared ProgressReport[] @relation("ReportPreparer")
  reportsApproved ProgressReport[] @relation("ReportApprover")
  plansUploaded   ApprovedPlan[]   @relation("PlanUploader")
  tasksAssigned   JobTask[]        @relation("TaskAssignee")

  prsRequested     PurchaseRequest[]      @relation("PrRequester")
  canvassesCreated Canvass[]              @relation("CanvassCreator")
  posCreated       PurchaseOrder[]        @relation("PoCreator")
  receivings       Receiving[]            @relation("Receiver")
  stockIssued      StockIssue[]           @relation("Issuer")
  stockReceivedBy  StockIssue[]           @relation("IssuedTo")
  borrowsTaken     BorrowSlip[]           @relation("Borrower")
  borrowsIssued    BorrowSlip[]           @relation("BorrowIssuer")
  stockMoves       InventoryTransaction[]

  facesEnrolled      FaceEnrollment[] @relation("FaceEnroller")
  attendanceRecorded Attendance[]     @relation("AttendanceRecorder")
  leaveDecided       LeaveRequest[]   @relation("LeaveDecider")

  invoicesCreated  Invoice[]      @relation("InvoiceCreator")
  billsCreated     SupplierBill[] @relation("BillCreator")
  expenseClaims    ExpenseClaim[] @relation("Claimant")
  paymentsRecorded Payment[]      @relation("PaymentRecorder")
  reimbursements   Payment[]      @relation("Payee")
  cashAdvances     CashAdvance[]  @relation("AdvanceRequester")

  assetsCreated      InstalledAsset[]  @relation("AssetCreator")
  contractsCreated   ServiceContract[] @relation("ContractCreator")
  visitsAssigned     ServiceVisit[]    @relation("VisitEngineer")
  templatesAuthored  ReportTemplate[]  @relation("TemplateAuthor")
  reportsPerformed   ServiceReport[]   @relation("ReportAuthor")
  jobOrdersRequested JobOrder[]        @relation("JobOrderRequester")
  jobOrdersAssigned  JobOrder[]        @relation("JobOrderEngineer")

  quoteLinesProvided   QuotationItem[]  @relation("QuoteLineProvider")
  soLinesProvided      SalesOrderLine[] @relation("SoLineProvider")
  legacyQuotesOwned    LegacyQuote[]    @relation("LegacyQuoteOwner")
  legacyQuotesImported LegacyQuote[]    @relation("LegacyQuoteImporter")

  accountTokens AccountToken[]

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@index([supervisorId])
}

enum AccountTokenPurpose {
  INVITE
  RESET
}

/// A one-time link that lets a person choose their password: the invitation
/// to a new account, or a password reset. Only the SHA-256 of the token is
/// stored, so a copy of this table cannot be used to get into an account —
/// the link itself is the only copy of the secret. A link is used once, runs
/// out at `expiresAt`, and is superseded by the next one of its kind.
model AccountToken {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     AccountTokenPurpose
  tokenHash   String              @unique
  expiresAt   DateTime
  usedAt      DateTime?
  /// Who issued it: the administrator behind an invitation or an admin reset;
  /// null for a reset the person asked for from the sign-in page.
  createdById String?
  createdAt   DateTime            @default(now())

  @@index([userId, purpose])
}

model Department {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  users              User[]
  employees          Employee[]
  positions          Position[]
  courseRequirements CourseRequirement[]
  createdAt          DateTime            @default(now())
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  // System roles cannot be deleted, but their permissions remain editable —
  // "Roles should be customizable" (requirements §14).
  isSystem    Boolean @default(false)

  permissions            RolePermission[]
  users                  UserRole[]
  workflowStepsTargeting ApprovalStep[]   @relation("StepRole")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per `module.submodule.action` triple. Seeded from
/// src/permissions/registry.ts — the registry is the source of truth.
model Permission {
  id        String @id @default(cuid())
  key       String @unique
  module    String
  submodule String
  action    String
  label     String

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@index([module, submodule])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

enum OverrideEffect {
  ALLOW
  DENY
}

/// Per-user grant or revoke on top of their roles. This is what makes
/// "I can customize what they can access ... until the menu of this access"
/// work without inventing a role per person. DENY always wins.
model UserPermissionOverride {
  userId       String
  permissionId String
  effect       OverrideEffect
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

// ════════════════════════════════════════════════════════════════════
//  COMPANY & CONFIGURATION
// ════════════════════════════════════════════════════════════════════

/// Single row. Drives every PDF header — "Settings for PDF Details
/// (Company Details, Logo to be used)".
model Company {
  id        String  @id @default("company")
  name      String
  legalName String?
  address   String?
  city      String?
  country   String  @default("Philippines")
  tin       String?
  /// SEC registration number, printed on the letterhead as "REG. NO.".
  regNo     String?
  phone     String?
  fax       String?
  email     String?
  website   String?
  logoPath  String?
  currency  String  @default("PHP")

  /// Where customers pay. Printed on documents that ask for payment.
  bankName        String?
  bankBranch      String?
  bankAccount     String?
  /// Footer strapline, e.g. "INDUSTRIAL UTILITY SOLUTIONS  WWW.GRUNTECHNOLOGY.COM".
  documentTagline String?

  /// Tax rates are configuration, not constants — rates change, and some
  /// customers withhold differently (model §5.4).
  vatRate Decimal @default(0.12) @db.Decimal(6, 4)
  ewtRate Decimal @default(0.02) @db.Decimal(6, 4)

  /// Prefixes every document number, e.g. GT-QT-2026-0001.
  numberPrefix String @default("GT")

  updatedAt DateTime @updatedAt
}

/// Free-form keyed configuration. Anything that must be changeable without a
/// deploy and does not deserve its own column.
model Setting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

enum SequencePeriod {
  YEAR
  MONTH
  NONE
}

/// GLOBAL: one counter per period. OWNER: one counter per period per author.
enum SequenceScope {
  GLOBAL
  OWNER
}

/// Configurable document numbering (model §7).
/// periodKey is composed: YEAR → "2026", MONTH → "2026-09", NONE → "";
/// scope OWNER appends "@" + the author's 3-digit employee token, e.g.
/// "2026-09@001". The template row is always periodKey "".
model NumberSequence {
  id           String         @id @default(cuid())
  documentType String
  label        String
  pattern      String         @default("{PREFIX}-{TYPE}-{YYYY}-{SEQ}")
  typeCode     String
  period       SequencePeriod @default(YEAR)
  scope        SequenceScope  @default(GLOBAL)
  periodKey    String         @default("")
  padding      Int            @default(4)
  lastNumber   Int            @default(0)
  updatedAt    DateTime       @updatedAt

  @@unique([documentType, periodKey])
}

// ════════════════════════════════════════════════════════════════════
//  APPROVAL ENGINE  (one engine for every document type — model §6.1)
// ════════════════════════════════════════════════════════════════════

enum ApproverType {
  ROLE
  USER
  SUPERVISOR
  HR
  /// The manager of the project the document names (ApprovalRequest.jobId);
  /// the step's role — Executive by default — when the project has none or
  /// the requester is that manager.
  PROJECT_MANAGER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalActionType {
  APPROVED
  REJECTED
  RETURNED
}

model ApprovalWorkflow {
  id           String  @id @default(cuid())
  documentType String
  name         String
  isActive     Boolean @default(true)

  /// Amount band this workflow applies to. Null = unbounded. This is how
  /// "approval thresholds should be configurable in Settings" is expressed.
  minAmount Decimal? @db.Decimal(18, 2)
  maxAmount Decimal? @db.Decimal(18, 2)

  /// Set: an OPTIONAL route, offered to the submitter under this label when
  /// the amount is in its band ("Add the CEO as approver") and used only when
  /// they tick it. Null: a standard route, picked by amount alone.
  optionLabel String?

  steps    ApprovalStep[]
  requests ApprovalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentType, isActive])
}

model ApprovalStep {
  id           String           @id @default(cuid())
  workflowId   String
  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sequence     Int
  name         String
  approverType ApproverType

  roleId String?
  role   Role?   @relation("StepRole", fields: [roleId], references: [id], onDelete: SetNull)
  userId String?
  user   User?   @relation("StepUser", fields: [userId], references: [id], onDelete: SetNull)

  actions ApprovalAction[]

  @@unique([workflowId, sequence])
}

model ApprovalRequest {
  id             String   @id @default(cuid())
  documentType   String
  documentId     String
  documentNumber String?
  subject        String
  amount         Decimal? @db.Decimal(18, 2)

  /// Deep link to the actual record — notifications must not land on a list
  /// screen (model §8).
  link String?

  requesterId String
  requester   User   @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)

  /// The project the document is about, when it is about one — what a
  /// PROJECT_MANAGER step resolves against. Set at submission; never a
  /// relation, because the engine knows no document.
  jobId String?

  workflowId String?
  workflow   ApprovalWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  currentSequence Int            @default(1)
  status          ApprovalStatus @default(PENDING)

  actions   ApprovalAction[]
  createdAt DateTime         @default(now())
  closedAt  DateTime?

  @@index([documentType, documentId])
  @@index([status])
  @@index([requesterId])
}

model ApprovalAction {
  id         String             @id @default(cuid())
  requestId  String
  request    ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepId     String?
  step       ApprovalStep?      @relation(fields: [stepId], references: [id], onDelete: SetNull)
  sequence   Int
  approverId String
  approver   User               @relation(fields: [approverId], references: [id], onDelete: Cascade)
  action     ApprovalActionType
  comment    String?
  actedAt    DateTime           @default(now())

  @@index([requestId])
}

// ════════════════════════════════════════════════════════════════════
//  CROSS-CUTTING SERVICES
// ════════════════════════════════════════════════════════════════════

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
}

model Attachment {
  id           String    @id @default(cuid())
  entityType   String
  entityId     String
  fileName     String
  storedName   String
  mimeType     String
  size         Int
  /// Original capture time for report photos — evidence keeps its timestamp
  /// (model §2.10).
  capturedAt   DateTime?
  caption      String?
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  uploadedAt   DateTime  @default(now())

  @@index([entityType, entityId])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  summary    String?
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String?
  before     Json?
  after      Json?
  ip         String?
  at         DateTime @default(now())

  @@index([entityType, entityId])
  @@index([at])
}

// ════════════════════════════════════════════════════════════════════
//  MASTERS  (Phase 2)
//
//  "Information entered once should be reusable by downstream modules
//  without duplicate data entry." These records are global — Sales,
//  Projects, Procurement, Finance and Service all read the same rows.
// ════════════════════════════════════════════════════════════════════

model Customer {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  legalName    String?
  tin          String?
  /// The sales team's list (Industry) — no longer set on a customer since
  /// 2026-10-08; kept on the rows that carried one.
  industryId   String?
  industry     Industry? @relation(fields: [industryId], references: [id], onDelete: Restrict)
  /// Where in the market the customer sits (2026-10-08, the owner's eleven:
  /// Enterprise, Hospital, Pharmaceutical …) — typed in by hand, optional.
  subIndustryId String?
  subIndustry   SubIndustry? @relation(fields: [subIndustryId], references: [id], onDelete: SetNull)
  /// Free text, e.g. "30 days", "50% down, balance on turnover".
  paymentTerms String?
  creditLimit  Decimal?  @db.Decimal(18, 2)
  phone        String?
  email        String?
  website      String?
  notes        String?
  isActive     Boolean   @default(true)

  /// Who entered it. Supports the Mine/All switch on the list; customers
  /// themselves are shared data that anyone with access may edit.
  createdById String?
  createdBy   User?   @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: SetNull)

  contacts CustomerContact[]
  sites    CustomerSite[]

  leads          Lead[]
  costings       Costing[]
  quotations     Quotation[]
  activities     SalesActivity[]
  jobs           Job[]
  invoices       Invoice[]
  payments       Payment[]
  assets         InstalledAsset[]
  visits         ServiceVisit[]
  serviceReports ServiceReport[]
  jobOrders      JobOrder[]
  legacyQuotes   LegacyQuote[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  salesOrders SalesOrder[]

  @@index([isActive])
  @@index([name])
  @@index([industryId])
  @@index([subIndustryId])
}

/// "Sometimes they have multiple contact in a single customer."
model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  position   String?
  email      String?
  phone      String?
  mobile     String?
  isPrimary  Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sites       CustomerSite[]
  quotations  Quotation[]
  jobs        Job[]
  jobOrders   JobOrder[]
  salesOrders SalesOrder[]

  @@index([customerId])
}

/// A delivery/works address. Projects and service contracts hang off a site,
/// not just a customer — one hospital group can have many plants.
model CustomerSite {
  id         String           @id @default(cuid())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  city       String?
  region     String?
  contactId  String?
  contact    CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  notes      String?
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  leads          Lead[]
  costings       Costing[]
  quotations     Quotation[]
  jobs           Job[]
  assets         InstalledAsset[]
  visits         ServiceVisit[]
  serviceReports ServiceReport[]
  jobOrders      JobOrder[]

  @@index([customerId])
}

/// The sales TEAMS (2026-10-08, the owner's five: KAT, HIT, UIT, GIB, SIT) —
/// a person's team is this row on their employee record (shared/team.ts).
/// Same shape as CostCategory: seeded, system rows undeletable, labels
/// editable. The first five rows (HI, BI, UI, GI, SI) classified customers
/// until the teams took them over; a customer is now classified by
/// SubIndustry, and `customers` only names the rows that still carry one.
model Industry {
  id        String     @id @default(cuid())
  code      String     @unique // KAT, HIT, UIT, GIB, SIT — 2–4 uppercase letters
  name      String
  sortOrder Int        @default(0)
  isSystem  Boolean    @default(false)
  isActive  Boolean    @default(true)
  customers Customer[]
  /// The people on this team (Employee.industryId).
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// A customer's sub-industry (2026-10-08, the owner's eleven): Enterprise,
/// Hospital, Pharmaceutical, Power and Water, Laguna & Batangas Hubs, Cavite
/// Hubs, Manufacturing, Building, EPC, Infrastructure, Government. Same
/// contract as the cost categories — seeded system rows undeletable, names
/// editable — and OPTIONAL on the customer: typed in by hand, later.
model SubIndustry {
  id        String     @id @default(cuid())
  name      String     @unique
  sortOrder Int        @default(0)
  isSystem  Boolean    @default(false)
  isActive  Boolean    @default(true)
  customers Customer[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Supplier {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  legalName    String?
  tin          String?
  /// What they supply — steel, valves, electrical, subcontract labour…
  category     String?
  paymentTerms String?
  address      String?
  city         String?
  phone        String?
  email        String?
  website      String?
  notes        String?
  isActive     Boolean @default(true)

  /// A principal whose equipment Gruntech sells and services — surfaced in
  /// G-OPS › Sales › Partners. Still one supplier record.
  isPartner    Boolean           @default(false)
  brand        String?
  partnerSince DateTime?         @db.Date
  resources    PartnerResource[]

  createdById String?
  createdBy   User?   @relation("SupplierCreator", fields: [createdById], references: [id], onDelete: SetNull)

  contacts       SupplierContact[]
  preferredItems Item[]            @relation("PreferredSupplier")
  canvassEntries CanvassSupplier[]
  purchaseOrders PurchaseOrder[]
  bills          SupplierBill[]
  payments       Payment[]
  quoteLines     QuotationItem[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  salesOrderLines SalesOrderLine[]

  @@index([isActive])
  @@index([name])
  @@index([isPartner])
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  position   String?
  email      String?
  phone      String?
  mobile     String?
  isPrimary  Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId])
}

enum PartnerResourceKind {
  CATALOGUE
  PRICE_LIST
  SIZING_APP
  /// One of the partner's other sites — a support portal, an e-shop, training,
  /// downloads. A url, never a file.
  LINK
  OTHER
}

/// A catalogue, price list, software or link a partner publishes. EITHER an uploaded
/// file (one Attachment with entityType 'partner_resource', entityId = this id)
/// OR an external URL, or both (a LINK is a url only). Files stay in the one
/// attachment service.
model PartnerResource {
  id          String              @id @default(cuid())
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  kind        PartnerResourceKind
  title       String
  description String?
  /// http(s) only — validated on write, opened in a new tab.
  url         String?
  validFrom   DateTime?           @db.Date
  validUntil  DateTime?           @db.Date
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  createdById String?
  createdBy   User?               @relation("PartnerResourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([supplierId, kind])
}

enum EmploymentType {
  REGULAR
  PROBATIONARY
  PROJECT_BASED
  CONTRACTUAL
  PART_TIME
  TRAINEE
}

/// The person. `User` is their login; not every employee needs one, and the
/// admin account is a User with no Employee record.
///
/// Reporting line deliberately lives on `User`, not here: the approval engine
/// routes by user, and two places to record "who approves for me" is one place
/// too many. An employee with no user account files nothing, so has no route.
model Employee {
  id         String  @id @default(cuid())
  employeeNo String  @unique
  firstName  String
  lastName   String
  middleName String?
  suffix     String?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position     String?
  /// The plantilla slot. `position` (the string) is a MIRROR of positionRef.title,
  /// written only by setEmployeePosition() in shared/plantilla.ts; it stays free
  /// text only for an employee with no plantilla position (unclassified).
  positionId   String?
  positionRef  Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  /// The industry team the person works in (Utilities, Healthcare…), from the
  /// same Industry rows customers are classified by. Set by HR; shown to the
  /// person on their invitation and My Account, never edited by them.
  industryId   String?
  industry     Industry?   @relation(fields: [industryId], references: [id], onDelete: Restrict)

  employmentType  EmploymentType @default(REGULAR)
  dateHired       DateTime?      @db.Date
  dateRegularized DateTime?      @db.Date
  dateSeparated   DateTime?      @db.Date
  /// End of the current probationary or training period. PROBATIONARY defaults
  /// to dateHired + hr.rules.probationMonths when null; an EXTEND recommendation
  /// writes here. A TRAINEE has no statutory period, so the route requires it.
  periodEndDate   DateTime?      @db.Date

  mobile        String?
  personalEmail String?
  address       String?
  birthDate     DateTime? @db.Date

  emergencyContactName  String?
  emergencyContactPhone String?

  // ── Sensitive ──────────────────────────────────────────────────────────
  // Gated by ghr.employee_rates.view_all and stripped from audit entries.
  // Projects see labour as a burdened cost, never as a wage.
  dailyRate        Decimal? @db.Decimal(14, 2)
  /// Multiplier covering statutory contributions, leave accrual and overhead.
  /// Burdened cost = dailyRate × burdenMultiplier.
  burdenMultiplier Decimal? @db.Decimal(6, 3)
  sssNo            String?
  philhealthNo     String?
  pagibigNo        String?
  tin              String?

  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faces         FaceEnrollment[]
  greetings     Greeting[]
  attendance    Attendance[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  overtime      OvertimeRequest[]

  clearances          EmployeeClearance[]
  evaluations         EmployeeEvaluation[]
  trainingAttendances TrainingAttendee[]
  trainingRecords     TrainingRecord[]

  @@index([isActive])
  @@index([lastName, firstName])
  @@index([positionId])
  @@index([industryId])
}

/// The five cost buckets every costing, budget and cost-ledger row uses
/// (model §5.1). Seeded, extensible, and the system ones cannot be deleted
/// because the ledger's shape depends on them.
model CostCategory {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  sortOrder Int     @default(0)
  isSystem  Boolean @default(false)
  isActive  Boolean @default(true)

  items          Item[]
  costingLines   CostingLine[]
  costEntries    JobCostEntry[]
  budgetRequests BudgetRequest[]
  prItems        PurchaseRequestItem[]
  poItems        PurchaseOrderItem[]
  issueItems     StockIssueItem[]
  overtime       OvertimeRequest[]
  supplierBills  SupplierBill[]        @relation("BillCategory")
  expenseClaims  ExpenseClaim[]        @relation("ExpenseCategory")
  cashAdvances   CashAdvance[]         @relation("AdvanceCategory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItemCategory {
  id       String         @id @default(cuid())
  code     String         @unique
  name     String
  parentId String?
  parent   ItemCategory?  @relation("ItemCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ItemCategory[] @relation("ItemCategoryTree")

  items Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ItemType {
  MATERIAL
  EQUIPMENT
  CONSUMABLE
  SERVICE
  TOOL
}

/// One item master, used by Costing (estimated), Procurement (ordered),
/// Inventory (stocked) and Job (consumed) — model §3.
model Item {
  id          String   @id @default(cuid())
  code        String   @unique
  partNumber  String?
  name        String
  description String?
  itemType    ItemType @default(MATERIAL)

  categoryId String?
  category   ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Which bucket this lands in when it reaches a job's cost ledger.
  costCategoryId String?
  costCategory   CostCategory? @relation(fields: [costCategoryId], references: [id], onDelete: SetNull)

  unit         String   @default("pcs")
  standardCost Decimal? @db.Decimal(18, 2)
  lastCost     Decimal? @db.Decimal(18, 2)

  /// The partner's published list price. A PRICE, not a cost: standardCost and
  /// lastCost stay behind gchain.items; this is what a salesperson may see.
  listPrice         Decimal?  @db.Decimal(18, 2)
  listPriceCurrency String?
  listPriceAsOf     DateTime? @db.Date

  /// Stocked items carry balances and reorder levels; a service or a one-off
  /// fabricated part does not.
  isStocked    Boolean  @default(true)
  minStock     Decimal? @db.Decimal(18, 3)
  reorderLevel Decimal? @db.Decimal(18, 3)

  preferredSupplierId String?
  preferredSupplier   Supplier? @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)

  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  costingLines    CostingLine[]
  prItems         PurchaseRequestItem[]
  poItems         PurchaseOrderItem[]
  issueItems      StockIssueItem[]
  borrowItems     BorrowSlipItem[]
  balances        InventoryBalance[]
  stockMoves      InventoryTransaction[]
  installedAssets InstalledAsset[]

  @@index([isActive])
  @@index([name])
  @@index([partNumber])
}

model Warehouse {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  address  String?
  city     String?
  isActive Boolean @default(true)

  locations Location[]

  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  receivings       Receiving[]
  stockIssues      StockIssue[]
  borrowSlips      BorrowSlip[]
  balances         InventoryBalance[]
  stockMoves       InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Bin / rack / shelf within a warehouse.
model Location {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String
  name        String?
  isActive    Boolean   @default(true)

  receivingItems ReceivingItem[]
  issueItems     StockIssueItem[]

  createdAt DateTime @default(now())

  @@unique([warehouseId, code])
}

// ════════════════════════════════════════════════════════════════════
//  SALES  (Phase 3)
//
//  Lead → Costing → Quotation(rev) → approved → customer P.O. → Job.
//
//  There is deliberately no separate Opportunity entity. The requirements
//  treat the opportunity AS the lead until a quotation exists ("Sales
//  Pipeline — better view of opportunity (quotation) transitioning to
//  completed or awarded"), so the pipeline is a view over leads and
//  quotations rather than a third record to keep in step.
// ════════════════════════════════════════════════════════════════════

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT
  COSTING
  QUOTATION_CREATED
  QUOTATION_SUBMITTED
  NEGOTIATION
  WON
  LOST
  ON_HOLD
}

model Lead {
  id     String     @id @default(cuid())
  number String     @unique
  status LeadStatus @default(NEW)

  /// A lead often arrives before the customer is worth recording, so the
  /// company is free text until it is linked to a real Customer.
  companyName String
  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  siteId      String?
  site        CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  contactPerson String?
  contactEmail  String?
  contactPhone  String?

  /// Where the work is. Copied off the customer's site when there is one, and
  /// editable either way — a lead often names a site the customer record does
  /// not have yet, and losing it means ringing back to ask where to go.
  address String?

  source      String?
  description String?

  /// "I can assign it to other user account or sales for them to work out."
  assignedToId String
  assignedTo   User   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdById  String
  createdBy    User   @relation("LeadCreator", fields: [createdById], references: [id], onDelete: Restrict)

  estimatedValue  Decimal?  @db.Decimal(18, 2)
  /// Salesperson's own read on the chance of award, used for weighted pipeline.
  probability     Int       @default(0)
  expectedClosing DateTime? @db.Date

  nextAction     String?
  nextActionDate DateTime? @db.Date
  lostReason     String?
  notes          String?

  quotations Quotation[]
  costings   Costing[]
  activities SalesActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([assignedToId])
}

// ── Costing ──────────────────────────────────────────────────────────────────

enum CostingStatus {
  DRAFT
  /// Submitted through the approval engine; locked until it is decided.
  PENDING_APPROVAL
  FINAL
}

/// Where the contract amount comes from, and the structural origin of both
/// the project budget and the billing breakdown (model §5.3).
model Costing {
  id     String        @id @default(cuid())
  number String        @unique
  title  String
  status CostingStatus @default(DRAFT)

  customerId String?
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  siteId     String?
  site       CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /// Record ownership — "View Category (My Costing, all Costing)".
  ownerId String
  owner   User   @relation("CostingOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  /// Applied to total cost to reach the contract amount.
  markupPct      Decimal @default(0) @db.Decimal(7, 4)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)

  /// Stored rather than derived: the contract value is a commercial fact that
  /// must not silently change when someone edits a cost line months later.
  contractValue Decimal @default(0) @db.Decimal(18, 2)
  totalCost     Decimal @default(0) @db.Decimal(18, 2)

  durationDays Int?
  /// Internal notes — shown on the screen, never printed.
  notes        String?
  /// Terms & Conditions — printed on the cost estimate.
  terms        String?

  /// Contingency on the project budgeted cost, priced in like the markup.
  contingencyPct Decimal   @default(0) @db.Decimal(7, 4)
  /// VAT shown on the estimate's grand total: the company rate, or 0 for a
  /// zero-rated job. The contract value stays net of VAT, as it always was.
  vatRate        Decimal   @default(0.12) @db.Decimal(6, 4)
  /// The date the prices on the estimate stop holding.
  validUntil     DateTime? @db.Date
  /// "System / Unit" — the plant or equipment the estimate is for.
  systemUnit     String?

  lines              CostingLine[]
  scopeSections      ScopeSection[]
  quotationRevisions QuotationRevision[]
  jobs               Job[]

  /// When it last became FINAL (approval, "Mark final", or a job built on
  /// it); cleared when reopened. The Costing page's "Final this month" tile.
  finalAt DateTime?

  /// "Assign costing" on a lead: who handed the work to the owner, when, and
  /// what they asked for. Null on a costing somebody started for themselves.
  assignedById   String?
  assignedBy     User?     @relation("CostingAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt     DateTime?
  assignmentNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([leadId])
}

/// One estimated cost, in one of the five buckets.
model CostingLine {
  id        String  @id @default(cuid())
  costingId String
  costing   Costing @relation(fields: [costingId], references: [id], onDelete: Cascade)

  costCategoryId String
  costCategory   CostCategory @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)

  /// Optional link to the item master — a fabricated one-off has no item.
  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  /// The short name, printed bold over the description. Null on a line that
  /// predates the sheet editor; its description then serves as the name.
  name        String?
  description String
  /// A subheading inside its category: printed as a heading row, costs nothing.
  isHeading   Boolean @default(false)
  quantity    Decimal @default(1) @db.Decimal(18, 3)
  unit        String  @default("pcs")
  unitCost    Decimal @default(0) @db.Decimal(18, 2)
  amount      Decimal @default(0) @db.Decimal(18, 2)
  sortOrder   Int     @default(0)

  @@index([costingId])
}

enum ScopeKind {
  MAIN_WORK
  TESTING_COMMISSIONING
  TURNOVER
  OTHER
}

/// A scope-of-work section AND a Schedule of Values line — the same row.
///
/// That identity is the point (model §5.3): what you scoped is what you bill
/// against and what the S-curve is measured on. Keeping them as one record is
/// what stops the three drifting apart.
model ScopeSection {
  id        String  @id @default(cuid())
  costingId String
  costing   Costing @relation(fields: [costingId], references: [id], onDelete: Cascade)

  kind         ScopeKind @default(MAIN_WORK)
  name         String
  description  String?
  durationDays Int       @default(0)

  /// This section's share of the contract value. The sum across sections is
  /// validated against the costing's contract value.
  value Decimal @default(0) @db.Decimal(18, 2)

  sortOrder Int         @default(0)
  tasks     ScopeTask[]

  @@index([costingId])
}

model ScopeTask {
  id             String       @id @default(cuid())
  scopeSectionId String
  scopeSection   ScopeSection @relation(fields: [scopeSectionId], references: [id], onDelete: Cascade)
  name           String
  /// The working day (Mon–Fri, day 1 = the first) the task starts on.
  startDay       Int?
  durationDays   Int          @default(0)
  sortOrder      Int          @default(0)

  @@index([scopeSectionId])
}

/// A costing to start from: its lines, scope phases and tasks, and the terms,
/// kept as one document. Not a commercial record — nothing points at it, and
/// a costing started from one keeps no link back, so editing or deleting a
/// template never moves a costing already made from it.
model CostingTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// { systemUnit, markupPct, contingencyPct, terms, lines[], sections[] } —
  /// lines name their category by CODE, which is permanent (isSystem rows).
  body        Json
  /// With prices, or quantities and names only.
  withPrices  Boolean  @default(true)
  createdById String
  createdBy   User     @relation("CostingTemplateAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

// ── Quotations ───────────────────────────────────────────────────────────────

enum RevisionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
}

enum QuotationOutcome {
  OPEN
  SUBMITTED
  NEGOTIATION
  WON
  LOST
}

/// The container. Commercial content lives on its revisions, which are never
/// overwritten — "preserve quotation revisions rather than overwriting
/// important commercial records" (model §2.5).
model Quotation {
  id     String @id @default(cuid())
  number String @unique

  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contactId  String?
  contact    CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  siteId     String?
  site       CustomerSite?    @relation(fields: [siteId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /// "Only the author can edit the quotations" — super admin excepted.
  ownerId String
  owner   User   @relation("QuotationOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  subject String
  outcome QuotationOutcome @default(OPEN)

  /// Salesperson's percentage to award, for the pipeline.
  probability Int @default(50)

  submittedAt     DateTime?
  decidedAt       DateTime?
  lostReason      String?
  /// When the salesperson expects the decision. Copied from the lead when the
  /// quotation is raised from one; editable on the quotation. The board's
  /// forecast column reads this, so a quotation with no lead can still be forecast.
  expectedClosing DateTime? @db.Date

  revisions  QuotationRevision[]
  activities SalesActivity[]
  jobOrders  JobOrder[]

  /// Set when this quotation was continued from a SCORO quote. The archive
  /// row points here, never the other way round.
  legacyQuote LegacyQuote?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  salesOrders SalesOrder[]

  @@index([customerId])
  @@index([ownerId])
  @@index([outcome])
}

model QuotationRevision {
  id          String         @id @default(cuid())
  quotationId String
  quotation   Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revision    Int            @default(0)
  status      RevisionStatus @default(DRAFT)

  costingId String?
  costing   Costing? @relation(fields: [costingId], references: [id], onDelete: SetNull)

  validityDays Int     @default(30)
  terms        String?
  notes        String?

  /// Sum of line amounts BEFORE discount. The arithmetic, in order:
  ///   net       = subtotal - discountAmount
  ///   vatAmount = net x vatRate        (on the discounted figure)
  ///   total     = net + vatAmount
  subtotal       Decimal @default(0) @db.Decimal(18, 2)
  /// Quote-level discount, as SCORO carried it. discountAmount is stored, not
  /// re-derived on read, so a printed revision cannot drift by a centavo.
  discountPct    Decimal @default(0) @db.Decimal(9, 6)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  vatAmount      Decimal @default(0) @db.Decimal(18, 2)
  total          Decimal @default(0) @db.Decimal(18, 2)

  /// The customer's purchase-request reference, printed as "PR Number :".
  prNumber     String?
  /// Delivery lead time / terms, printed as "Delivery:".
  delivery     String?
  /// Printed as "Payment Terms :".
  paymentTerms String?
  /// Snapshot of the rate used, so an old revision still prints the tax it was
  /// issued with after Settings change.
  vatRate      Decimal @default(0.12) @db.Decimal(6, 4)
  vatInclusive Boolean @default(false)
  /// SCORO's "Hide total": the PDF prints the lines and their prices but no
  /// totals — a rate sheet, where the customer picks lines rather than buying
  /// the lot. The stored totals are still computed; only the paper omits them.
  hideTotal    Boolean @default(false)

  approvedById String?
  approvedBy   User?     @relation("RevisionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  items QuotationItem[]
  jobs  Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quotationId, revision])
  @@index([status])
}

/// SCORO's "Create invoice" under its real name here: the SALES ORDER that
/// books a quotation's work in Gruntech operations (2026-10-07). Raised FROM
/// a quotation — all of it, chosen lines, or one summarised line — numbered
/// `4622`, then `4622.1`, `4622.2` for later orders on the same quotation
/// (progress booking). An internal document: its PDF prints cost and margin
/// to those who may see cost, and it never goes to the customer.
model SalesOrder {
  id     String           @id @default(cuid())
  number String           @unique
  status SalesOrderStatus @default(DRAFT)

  quotationId String
  quotation   Quotation        @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contactId   String?
  contact     CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// Record ownership — the author; "only the author can edit" as on quotations.
  ownerId String
  owner   User   @relation("SalesOrderOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  orderDate     DateTime @db.Date
  /// "Payment Terms : 30" on the paper.
  termsDays     Int      @default(30)
  paymentMethod String?
  referenceNo   String?
  /// The customer's PO this order books against.
  poNumber      String?
  /// Notes, printed on the order.
  comment       String?
  /// Released by: the sales invoice / billing statement and delivery receipt
  /// numbers, filled in when the release happens.
  siNumber      String?
  drNumber      String?
  /// Why a cancelled order was cancelled.
  cancelReason  String?

  /// Same arithmetic as a quotation revision (shared/quotation.ts): subtotal
  /// pre-discount, VAT on the net, totals stored by recalc only.
  discountPct    Decimal @default(0) @db.Decimal(9, 6)
  vatRate        Decimal @default(0.12) @db.Decimal(6, 4)
  vatInclusive   Boolean @default(false)
  subtotal       Decimal @default(0) @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  vatAmount      Decimal @default(0) @db.Decimal(18, 2)
  total          Decimal @default(0) @db.Decimal(18, 2)

  lines SalesOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationId])
  @@index([customerId])
  @@index([ownerId])
  @@index([status])
}

enum SalesOrderStatus {
  DRAFT
  PENDING_APPROVAL
  ISSUED
  CANCELLED
}

/// A sales-order line — the same shape a quotation line has, cost and all.
model SalesOrderLine {
  id      String     @id @default(cuid())
  orderId String
  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  group       String?
  /// The quotation line's three boxes, copied at booking; `title` is their sentence (see QuotationItem).
  title       String?
  brand       String?
  productType String?
  partNumber  String?
  description String  @default("")
  isHeading   Boolean @default(false)
  quantity    Decimal @default(1) @db.Decimal(18, 3)
  unit        String  @default("lot")
  unitPrice   Decimal @default(0) @db.Decimal(18, 2)
  amount      Decimal @default(0) @db.Decimal(18, 2)
  sortOrder   Int     @default(0)

  /// INTERNAL, stripped for callers who may not see cost — the quotation rule.
  unitCost           Decimal?  @db.Decimal(18, 2)
  costAmount         Decimal?  @db.Decimal(18, 2)
  providerSupplierId String?
  providerSupplier   Supplier? @relation(fields: [providerSupplierId], references: [id], onDelete: SetNull)
  providerUserId     String?
  providerUser       User?     @relation("SoLineProvider", fields: [providerUserId], references: [id], onDelete: SetNull)
  costNote           String?

  /// The quotation line this books (progress booking: what is left of a line
  /// is its quantity less every live order's lines pointing at it).
  quotationItemId String?
  quotationItem   QuotationItem? @relation(fields: [quotationItemId], references: [id], onDelete: SetNull)
  /// A summarised line books several quotation lines: [{ quotationItemId, quantity }].
  bookedItems Json?

  @@index([orderId])
  @@index([quotationItemId])
}

model QuotationItem {
  id         String            @id @default(cuid())
  revisionId String
  revision   QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  /// SCORO's line group, e.g. "Gruntech Installation", "Gruntech Services".
  group       String?
  /// Product name, printed in bold above the description. Since 2026-10-08 the
  /// sentence of the three boxes under it — "SCHNEIDER ELECTRIC, CIRCUIT
  /// BREAKER, EZC100H3030", empty parts left out (`productTitle()`) — or, on a
  /// line typed before them, the title as typed.
  title       String?
  brand       String?
  productType String?
  partNumber  String?
  description String
  /// A subheading over the lines below it: its title is the heading, it has no
  /// quantity or price, and it prints as a heading row.
  isHeading   Boolean @default(false)
  quantity    Decimal @default(1) @db.Decimal(18, 3)
  unit        String  @default("lot")
  unitPrice   Decimal @default(0) @db.Decimal(18, 2)
  amount      Decimal @default(0) @db.Decimal(18, 2)
  sortOrder   Int     @default(0)

  /// INTERNAL. Cost and margin never print on the customer PDF and are stripped
  /// server-side from responses for callers who may not see them.
  /// costAmount = quantity x unitCost, stored.
  unitCost           Decimal?  @db.Decimal(18, 2)
  costAmount         Decimal?  @db.Decimal(18, 2)
  /// Who carries the cost: a supplier (outsourced) OR an in-house person.
  /// Margin splits in-house vs outsourced by which of the two is set.
  providerSupplierId String?
  providerSupplier   Supplier? @relation(fields: [providerSupplierId], references: [id], onDelete: SetNull)
  providerUserId     String?
  providerUser       User?     @relation("QuoteLineProvider", fields: [providerUserId], references: [id], onDelete: SetNull)
  costNote           String?

  @@index([revisionId])
  @@index([providerSupplierId])
  @@index([providerUserId])
  salesOrderLines SalesOrderLine[]
}

// ── SCORO archive ────────────────────────────────────────────────────────────

/// The read-only SCORO quotation archive. This is NOT a quotation: it is
/// history carried over when Gruntech moved from SCORO to G-CORE, kept so an
/// old quote can still be looked up and its PDF reopened. Nothing in live work
/// links from it: no job, costing, billing or ledger row may reference a
/// LegacyQuote. The one link is outbound and one-way: an open SCORO quote may
/// be "continued in G-CORE", which raises a real Quotation under the SAME
/// number and records it in continuedQuotationId. Figures are stored exactly as
/// SCORO held them; nothing recomputes them.
/// The groups a quotation line is filed under ("Gruntech Installation",
/// "Trading") — SCORO's Group column. A line keeps its group as TEXT
/// (`QuotationItem.group`), so this is the list the editor suggests from and
/// Sales Analytics' "By group" names, not a reference a line points at. Every
/// group a saved line uses is added here (`rememberGroups`). Admin › Categories.
model QuotationGroup {
  id        String   @id @default(cuid())
  name      String
  /// What the group covers — "Compressed Air & Gas Treatment and Separation" —
  /// the dropdown's hint under the name (2026-10-08).
  description String?
  /// The brand a line filed under it carries: pre-filled into the line's Brand
  /// box when that is empty. None for a house group (GRUNTECHNOLOGY, OTHERS).
  brand       String?
  /// The name trimmed and lower-cased: one group per spelling, case-blind.
  key       String   @unique
  sortOrder Int      @default(0)
  /// Inactive: no longer suggested. Lines already filed under it keep it.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LegacyQuote {
  id       String @id @default(cuid())
  source   String @default("SCORO")
  /// SCORO's own quote id.
  sourceId String
  number   String @unique

  date             DateTime? @db.Date
  dueDate          DateTime? @db.Date
  estimatedClosing DateTime? @db.Date
  confirmedAt      DateTime?

  /// As SCORO spelled it; ownerUserId is the matched G-CORE login, if any.
  ownerName   String
  ownerUserId String?
  ownerUser   User?   @relation("LegacyQuoteOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  customerName String
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contactName  String?
  name         String?
  projectName  String?

  /// SCORO's status label verbatim (Opportunity, Negotiation, Confirmed...).
  status          String
  previousStatus  String?
  statusChangedAt DateTime?
  statusChangedBy String?

  currency    String  @default("PHP")
  discountPct Decimal @default(0) @db.Decimal(9, 6)
  /// After discount, as SCORO reported it.
  subtotal    Decimal @default(0) @db.Decimal(18, 2)
  vat         Decimal @default(0) @db.Decimal(18, 2)
  total       Decimal @default(0) @db.Decimal(18, 2)
  cost        Decimal @default(0) @db.Decimal(18, 2)

  prNumber     String?
  delivery     String?
  paymentTerms String?
  comment      String?
  invoiceNos   String?
  isSent       Boolean @default(false)

  /// [{ title, description, quantity, unit, unitPrice, amount }] as parsed
  /// from SCORO's PDF. linesReconcile is false when they do not sum to subtotal.
  lines          Json
  linesReconcile Boolean @default(true)

  continuedQuotationId String?    @unique
  continuedQuotation   Quotation? @relation(fields: [continuedQuotationId], references: [id], onDelete: SetNull)

  importedAt   DateTime @default(now())
  importedById String?
  importedBy   User?    @relation("LegacyQuoteImporter", fields: [importedById], references: [id], onDelete: SetNull)

  @@unique([source, sourceId])
  @@index([customerId])
  @@index([ownerName])
  @@index([status])
  @@index([date])
}

// ── Sales calendar ───────────────────────────────────────────────────────────

enum ActivityType {
  CALL
  SITE_VISIT
  MEETING
  FOLLOW_UP
  SUBMISSION
  OTHER
}

enum ActivityStatus {
  PLANNED
  DONE
  CANCELLED
}

/// "One look at what all the sales personnel are going to do by day."
/// A greeting sent (2026-10-08): the claim that makes a birthday or work
/// anniversary greeting go once per person per year — the API's minute timer
/// creates the row before anyone is told, and a second process loses the race
/// on the unique key. Never a list anybody reads; `shared/celebrations.ts`.
model Greeting {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// BIRTHDAY or ANNIVERSARY.
  kind       String
  year       Int
  sentAt     DateTime @default(now())

  @@unique([employeeId, kind, year])
}

/// An activity type as data (2026-10-08, SCORO's customisable activity types):
/// Admin › Categories › Activity types. The six built-ins are seeded with the
/// enum's own keys, so every activity written before this maps 1:1.
model SalesActivityType {
  id        String   @id @default(cuid())
  /// CALL, SITE_VISIT … or a key derived from a typed name (DEMO_WALK). Never changes.
  key       String   @unique
  name      String
  /// #RRGGBB, the chip's edge on the calendar; null takes the default.
  color     String?
  sortOrder Int      @default(0)
  /// The six built-ins: renamed and recoloured freely, never deleted; OTHER is the fallback and stays active.
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesActivity {
  id       String         @id @default(cuid())
  /// The built-in kind, kept for the rows written before types became data;
  /// OTHER for a custom type. `typeKey` is what is read.
  type     ActivityType   @default(FOLLOW_UP)
  /// SalesActivityType.key — set on every write since 2026-10-08 and backfilled
  /// from `type` by the seed; read as `typeKey ?? type`.
  typeKey  String?
  status   ActivityStatus @default(PLANNED)
  subject  String
  notes    String?
  location String?

  assignedToId String
  assignedTo   User   @relation("ActivityAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)

  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  startsAt        DateTime
  /// Stored; the form asks for Starts and Ends and the API derives this from
  /// them (`endsAt` = startsAt + durationMinutes in every response).
  durationMinutes Int       @default(60)
  completedAt     DateTime?

  /// Minutes before `startsAt` to remind the assignee and invitees: null (none),
  /// 15, 60, 120 or 1440. Sent by the API's once-a-minute timer
  /// (`sendDueReminders` in shared/activities.ts).
  reminderMinutes Int?
  /// Set when the reminder went out — claimed with a conditional update so it
  /// is sent once. Cleared when the time or the reminder changes.
  reminderSentAt  DateTime?

  invitees SalesActivityInvitee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId, startsAt])
  @@index([startsAt])
}

/// Someone else asked along to a sales activity: told on save, reminded with
/// the assignee, and shown the activity on their calendar and in My Work.
model SalesActivityInvitee {
  id         String        @id @default(cuid())
  activityId String
  activity   SalesActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// When they were told they are invited (null until the save that told them).
  notifiedAt DateTime?
  /// Going (ACCEPTED), Maybe (TENTATIVE), Not going (DECLINED) or No reply
  /// (PENDING) — the invitee's own answer (2026-10-08, SCORO's visual
  /// confirmation), kept with when it was given. Only they can set it.
  response    InviteeResponse @default(PENDING)
  respondedAt DateTime?
  createdAt  DateTime      @default(now())

  @@unique([activityId, userId])
  @@index([userId])
}

// ════════════════════════════════════════════════════════════════════
//  DELIVERY  (Phase 4)
//
//  Job → Budget → Execution → Progress → Billing.
//
//  One JOB carries both kinds of work (model §3). A service contract is a
//  job with a different type, not a parallel set of tables, because both
//  consume the same people and materials and must post to the same ledger.
// ════════════════════════════════════════════════════════════════════

enum JobType {
  PROJECT
  SERVICE_CONTRACT
}

enum JobStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  TURNED_OVER
  CANCELLED
}

model Job {
  id     String    @id @default(cuid())
  number String    @unique
  type   JobType   @default(PROJECT)
  status JobStatus @default(PLANNING)
  name   String

  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  siteId     String?
  site       CustomerSite?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  contactId  String?
  contact    CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// A job cannot exist without an approved costing (model §10 invariants) —
  /// that is where its budget and its schedule of values come from.
  costingId String
  costing   Costing @relation(fields: [costingId], references: [id], onDelete: Restrict)

  quotationRevisionId String?
  quotationRevision   QuotationRevision? @relation(fields: [quotationRevisionId], references: [id], onDelete: SetNull)

  projectManagerId String?
  projectManager   User?   @relation("JobManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  createdById      String
  createdBy        User    @relation("JobCreator", fields: [createdById], references: [id], onDelete: Restrict)

  contractValue    Decimal   @db.Decimal(18, 2)
  customerPoNumber String?
  customerPoDate   DateTime? @db.Date
  contractDate     DateTime? @db.Date

  startDate     DateTime? @db.Date
  targetEndDate DateTime? @db.Date
  actualEndDate DateTime? @db.Date

  /// Reserved for §5.4. Null means the behaviour is off, which is the decision
  /// taken for now — the columns exist so switching either on later is a
  /// settings change rather than a migration of historical billings.
  downpaymentPct Decimal? @db.Decimal(6, 4)
  retentionPct   Decimal? @db.Decimal(6, 4)

  notes String?

  scopeItems      JobScopeItem[]
  costEntries     JobCostEntry[]
  budgetRequests  BudgetRequest[]
  progressReports ProgressReport[]
  billings        ProgressBilling[]
  plans           ApprovedPlan[]
  tasks           JobTask[]
  meetings        Meeting[]

  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  stockIssues      StockIssue[]
  borrowSlips      BorrowSlip[]
  overtime         OvertimeRequest[]
  invoices         Invoice[]
  supplierBills    SupplierBill[]
  expenseClaims    ExpenseClaim[]
  cashAdvances     CashAdvance[]
  installedAssets  InstalledAsset[]  @relation("AssetInstaller")
  serviceContract  ServiceContract?
  serviceReports   ServiceReport[]   @relation("ServiceReportJob")
  jobOrders        JobOrder[]        @relation("JobOrderChargeTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([projectManagerId])
}

/// The job's Schedule of Values — a SNAPSHOT of the costing's scope sections.
///
/// Snapshotted, not referenced, on purpose. A costing can be reopened and
/// edited; if progress were measured against live costing rows, every reported
/// percentage would silently shift underneath the reports that recorded it.
model JobScopeItem {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// Where it came from, for traceability. Nulled if the costing section goes.
  sourceSectionId String?

  kind         ScopeKind @default(MAIN_WORK)
  name         String
  description  String?
  value        Decimal   @db.Decimal(18, 2)
  durationDays Int       @default(0)

  /// Scheduled sequentially from the job start date at creation, then editable.
  /// These drive the PLANNED curve.
  plannedStart DateTime? @db.Date
  plannedEnd   DateTime? @db.Date

  sortOrder Int @default(0)

  progressLines ProgressReportLine[]
  billingLines  ProgressBillingLine[]
  tasks         JobTask[]

  @@index([jobId])
}

/// The four states money moves through (model §5.1).
///
/// BUDGETED   what we are allowed to spend  (costing + approved budget requests)
/// COMMITTED  what we have promised         (approved PR → issued PO, Phase 5)
/// INCURRED   what we now owe               (receiving, overtime, Phases 5–6)
/// CONSUMED   what is actually in the work  (stock issuance, Phase 5)
enum CostState {
  BUDGETED
  COMMITTED
  INCURRED
  CONSUMED
}

/// The single job cost ledger. There is no other way cost reaches a job, and
/// Budget Monitoring is a view over this table rather than a second set of
/// numbers that can disagree with it.
model JobCostEntry {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  costCategoryId String
  costCategory   CostCategory @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)

  state  CostState
  amount Decimal   @db.Decimal(18, 2)

  /// Every row names the document it came from — model §10 invariants.
  sourceType   String
  sourceId     String?
  sourceNumber String?
  description  String?

  occurredAt  DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([jobId, state])
  @@index([jobId, costCategoryId])
  @@index([sourceType, sourceId])
}

enum RequestStatus {
  DRAFT
  PENDING_APPROVAL
  /// Approved; finance has not yet handed the cash over.
  APPROVED
  /// Cash handed over; waiting for the liquidation.
  RELEASED
  /// Liquidation approved and the team still holds unspent cash.
  REFUND_DUE
  /// Liquidation approved and nothing is owed either way.
  LIQUIDATED
  REJECTED
  CANCELLED
}

/// A Budget Request asks for PROJECT CASH (§5.2, 2026-10-07): a sum against a
/// project and budget line, allowed by the project manager, approved and
/// released by finance, spent by the team and accounted for with receipts in
/// an ExpenseClaim that names it. Nothing reaches the project's ledger on
/// approval or release — the liquidation posts INCURRED at what was spent.
/// It no longer changes the budget. Every figure below is re-derived by
/// refreshBudgetRequest() from the payment allocations and the approved
/// liquidation; nothing increments them.
model BudgetRequest {
  id     String        @id @default(cuid())
  number String        @unique
  status RequestStatus @default(DRAFT)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  costCategoryId String
  costCategory   CostCategory @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(18, 2)
  /// What the cash is for.
  reason String
  notes  String?

  requestedById String
  requestedBy   User   @relation("BudgetRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  neededBy DateTime? @db.Date

  /// Re-derived: Σ DISBURSEMENT allocations. 0 or amount — released in one voucher.
  amountReleased Decimal @default(0) @db.Decimal(18, 2)
  /// Re-derived: the approved liquidation's total, else 0.
  amountSpent    Decimal @default(0) @db.Decimal(18, 2)
  /// Re-derived: Σ RECEIPT allocations (unspent cash returned).
  amountRefunded Decimal @default(0) @db.Decimal(18, 2)

  /// releasedAt + finance.rules.budgetRequestLiquidationDays, snapshotted at release.
  liquidationDueDate DateTime? @db.Date
  releasedAt         DateTime? @db.Date
  liquidatedAt       DateTime?
  cancelReason       String?

  liquidations ExpenseClaim[]
  allocations  PaymentAllocation[]

  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([jobId, status])
  @@index([requestedById, status])
  @@index([status])
}

enum ProgressStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

/// "Progress Reports are arranged base on time of generation, all linked so
/// that we can monitor the status from 1st Progress report till last."
model ProgressReport {
  id       String         @id @default(cuid())
  number   String         @unique
  reportNo Int
  status   ProgressStatus @default(DRAFT)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// The chain back to the previous report.
  previousReportId String?         @unique
  previousReport   ProgressReport? @relation("ReportChain", fields: [previousReportId], references: [id], onDelete: SetNull)
  nextReport       ProgressReport? @relation("ReportChain")

  periodFrom DateTime @db.Date
  periodTo   DateTime @db.Date

  weather        String?
  manpower       String?
  equipment      String?
  accomplishment String?
  issues         String?
  nextPeriodPlan String?

  preparedById String
  preparedBy   User      @relation("ReportPreparer", fields: [preparedById], references: [id], onDelete: Restrict)
  approvedById String?
  approvedBy   User?     @relation("ReportApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  lines   ProgressReportLine[]
  billing ProgressBilling?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, reportNo])
  @@index([jobId])
}

model ProgressReportLine {
  id       String         @id @default(cuid())
  reportId String
  report   ProgressReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  scopeItemId String
  scopeItem   JobScopeItem @relation(fields: [scopeItemId], references: [id], onDelete: Cascade)

  /// Percentages, 0–100. `previousPct` is carried from the prior report so a
  /// report reads as a period statement rather than a running total.
  previousPct   Decimal @default(0) @db.Decimal(7, 4)
  thisPeriodPct Decimal @default(0) @db.Decimal(7, 4)
  toDatePct     Decimal @default(0) @db.Decimal(7, 4)

  remarks String?

  @@unique([reportId, scopeItemId])
}

enum BillingStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  INVOICED
}

/// Generated from a progress report against the Schedule of Values — never
/// keyed independently (model §4.2).
model ProgressBilling {
  id        String        @id @default(cuid())
  number    String        @unique
  billingNo Int
  status    BillingStatus @default(DRAFT)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  progressReportId String         @unique
  progressReport   ProgressReport @relation(fields: [progressReportId], references: [id], onDelete: Restrict)

  billingDate DateTime @default(now()) @db.Date

  /// Σ (scope value × percentage billed this period).
  grossAmount Decimal @db.Decimal(18, 2)

  /// Reserved for §5.4. Null while the behaviour is off.
  downpaymentRecouped Decimal? @db.Decimal(18, 2)
  retentionWithheld   Decimal? @db.Decimal(18, 2)

  /// Rates snapshotted so an old billing still prints the tax it was issued
  /// with after Settings change.
  vatRate   Decimal @default(0.12) @db.Decimal(6, 4)
  vatAmount Decimal @db.Decimal(18, 2)
  ewtRate   Decimal @default(0.02) @db.Decimal(6, 4)
  /// Withheld at source by the customer — reduces cash, not the amount owed.
  ewtAmount Decimal @db.Decimal(18, 2)

  invoiceTotal   Decimal @db.Decimal(18, 2)
  netCollectible Decimal @db.Decimal(18, 2)

  notes      String?
  approvedAt DateTime?

  lines   ProgressBillingLine[]
  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, billingNo])
  @@index([jobId, status])
}

model ProgressBillingLine {
  id        String          @id @default(cuid())
  billingId String
  billing   ProgressBilling @relation(fields: [billingId], references: [id], onDelete: Cascade)

  scopeItemId String
  scopeItem   JobScopeItem @relation(fields: [scopeItemId], references: [id], onDelete: Cascade)

  scopeValue       Decimal @db.Decimal(18, 2)
  previousPct      Decimal @db.Decimal(7, 4)
  toDatePct        Decimal @db.Decimal(7, 4)
  previousAmount   Decimal @db.Decimal(18, 2)
  thisPeriodAmount Decimal @db.Decimal(18, 2)

  @@unique([billingId, scopeItemId])
}

enum PlanStatus {
  FOR_APPROVAL
  APPROVED
  SUPERSEDED
  REJECTED
}

/// "Approved Plan — documents, approved plan required attachments or time
/// stamp." Work should not start on an unapproved plan (model §4.2).
model ApprovedPlan {
  id         String     @id @default(cuid())
  jobId      String
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title      String
  drawingNo  String?
  revision   String     @default("0")
  discipline String?
  status     PlanStatus @default(FOR_APPROVAL)

  submittedAt DateTime?
  approvedAt  DateTime?
  approvedBy  String?
  notes       String?

  uploadedById String
  uploadedBy   User   @relation("PlanUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

model JobTask {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  scopeItemId String?
  scopeItem   JobScopeItem? @relation(fields: [scopeItemId], references: [id], onDelete: SetNull)

  name        String
  description String?
  status      TaskStatus @default(NOT_STARTED)
  progressPct Int        @default(0)

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  startDate DateTime? @db.Date
  dueDate   DateTime? @db.Date
  doneAt    DateTime?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, status])
  @@index([assignedToId])
}

// ════════════════════════════════════════════════════════════════════
//  G-CHAIN  (Phase 5)
//
//  Purchase Request → Canvass → Purchase Order → Receiving → Inventory
//  → Stock Issuance → Job cost.
//
//  The distinction that prevents double-counting (model §4.3):
//
//    DIRECT_TO_JOB        commits at PR/PO, charges the job at RECEIVING
//    STOCK_REPLENISHMENT  buys warehouse stock, charges the job at ISSUANCE
//
//  Without it, material bought for a job and later issued from stock gets
//  counted against that job twice.
// ════════════════════════════════════════════════════════════════════

enum PurchaseKind {
  DIRECT_TO_JOB
  STOCK_REPLENISHMENT
}

enum PrStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  PARTIALLY_ORDERED
  ORDERED
}

model PurchaseRequest {
  id     String       @id @default(cuid())
  number String       @unique
  kind   PurchaseKind @default(DIRECT_TO_JOB)
  status PrStatus     @default(DRAFT)

  /// Required when kind is DIRECT_TO_JOB — enforced in the route, because a
  /// stock replenishment legitimately has no job.
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  requestedById String
  requestedBy   User   @relation("PrRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  purpose  String
  neededBy DateTime? @db.Date
  notes    String?

  approvedAt DateTime?

  items     PurchaseRequestItem[]
  canvasses Canvass[]
  orders    PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([jobId])
}

model PurchaseRequestItem {
  id        String          @id @default(cuid())
  requestId String
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  /// Which budget line this lands in. Required for a direct-to-job request.
  costCategoryId String?
  costCategory   CostCategory? @relation(fields: [costCategoryId], references: [id], onDelete: SetNull)

  description     String
  quantity        Decimal @db.Decimal(18, 3)
  unit            String  @default("pcs")
  estimatedCost   Decimal @default(0) @db.Decimal(18, 2)
  /// quantity × estimatedCost, stored so the commitment is a recorded fact.
  estimatedAmount Decimal @default(0) @db.Decimal(18, 2)
  orderedQty      Decimal @default(0) @db.Decimal(18, 3)
  sortOrder       Int     @default(0)

  quotes     CanvassQuote[]
  orderItems PurchaseOrderItem[]

  @@index([requestId])
}

enum CanvassStatus {
  OPEN
  AWARDED
  CANCELLED
}

/// "Canvass/RFQ — supplier selection." Three quotes is the convention; the
/// system does not force it, but it shows how many you have.
model Canvass {
  id     String        @id @default(cuid())
  number String        @unique
  status CanvassStatus @default(OPEN)

  requestId String
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CanvassCreator", fields: [createdById], references: [id], onDelete: Restrict)

  notes     String?
  awardedAt DateTime?

  suppliers CanvassSupplier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
}

model CanvassSupplier {
  id        String  @id @default(cuid())
  canvassId String
  canvass   Canvass @relation(fields: [canvassId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  /// Set when this supplier wins the canvass. Only one per canvass.
  isSelected   Boolean @default(false)
  leadTimeDays Int?
  terms        String?
  remarks      String?

  quotes CanvassQuote[]

  @@unique([canvassId, supplierId])
}

model CanvassQuote {
  id                String          @id @default(cuid())
  canvassSupplierId String
  canvassSupplier   CanvassSupplier @relation(fields: [canvassSupplierId], references: [id], onDelete: Cascade)

  requestItemId String
  requestItem   PurchaseRequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)

  unitPrice Decimal @db.Decimal(18, 2)
  remarks   String?

  @@unique([canvassSupplierId, requestItemId])
}

enum PoStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id     String       @id @default(cuid())
  number String       @unique
  status PoStatus     @default(DRAFT)
  kind   PurchaseKind @default(DIRECT_TO_JOB)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  requestId String?
  request   PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("PoCreator", fields: [createdById], references: [id], onDelete: Restrict)

  orderDate    DateTime  @default(now()) @db.Date
  deliveryDate DateTime? @db.Date
  deliverTo    String?
  terms        String?
  notes        String?

  /// Snapshotted so an old order still prints the tax it was issued with.
  vatRate      Decimal @default(0.12) @db.Decimal(6, 4)
  vatInclusive Boolean @default(false)
  subtotal     Decimal @default(0) @db.Decimal(18, 2)
  vatAmount    Decimal @default(0) @db.Decimal(18, 2)
  total        Decimal @default(0) @db.Decimal(18, 2)

  issuedAt   DateTime?
  approvedAt DateTime?

  items      PurchaseOrderItem[]
  receivings Receiving[]
  bills      SupplierBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([supplierId])
  @@index([jobId])
}

model PurchaseOrderItem {
  id      String        @id @default(cuid())
  orderId String
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  requestItemId String?
  requestItem   PurchaseRequestItem? @relation(fields: [requestItemId], references: [id], onDelete: SetNull)

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  costCategoryId String?
  costCategory   CostCategory? @relation(fields: [costCategoryId], references: [id], onDelete: SetNull)

  description String
  quantity    Decimal @db.Decimal(18, 3)
  unit        String  @default("pcs")
  unitPrice   Decimal @db.Decimal(18, 2)
  amount      Decimal @db.Decimal(18, 2)
  receivedQty Decimal @default(0) @db.Decimal(18, 3)
  sortOrder   Int     @default(0)

  receivingItems ReceivingItem[]

  @@index([orderId])
}

model Receiving {
  id     String @id @default(cuid())
  number String @unique

  orderId String
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  receivedById String
  receivedBy   User   @relation("Receiver", fields: [receivedById], references: [id], onDelete: Restrict)

  receivedDate  DateTime @default(now()) @db.Date
  deliveryRefNo String?
  invoiceRefNo  String?
  notes         String?

  items ReceivingItem[]
  bills SupplierBill[]

  createdAt DateTime @default(now())

  @@index([orderId])
}

model ReceivingItem {
  id          String    @id @default(cuid())
  receivingId String
  receiving   Receiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   PurchaseOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  quantity Decimal @db.Decimal(18, 3)
  unitCost Decimal @db.Decimal(18, 2)
  serialNo String?
  batchNo  String?
  remarks  String?

  @@index([receivingId])
}

enum IssueStatus {
  DRAFT
  ISSUED
  CANCELLED
}

/// Stock leaving the warehouse for a job. This is where a stock-sourced item
/// first charges the job (model §4.3).
model StockIssue {
  id     String      @id @default(cuid())
  number String      @unique
  status IssueStatus @default(DRAFT)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  issuedById   String
  issuedBy     User    @relation("Issuer", fields: [issuedById], references: [id], onDelete: Restrict)
  issuedToId   String?
  issuedTo     User?   @relation("IssuedTo", fields: [issuedToId], references: [id], onDelete: SetNull)
  issuedToName String?

  issueDate DateTime  @default(now()) @db.Date
  purpose   String
  notes     String?
  issuedAt  DateTime?

  items StockIssueItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([status])
}

model StockIssueItem {
  id      String     @id @default(cuid())
  issueId String
  issue   StockIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  costCategoryId String?
  costCategory   CostCategory? @relation(fields: [costCategoryId], references: [id], onDelete: SetNull)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  quantity Decimal @db.Decimal(18, 3)
  /// Moving-average cost at the moment of issue, snapshotted.
  unitCost Decimal @default(0) @db.Decimal(18, 2)
  amount   Decimal @default(0) @db.Decimal(18, 2)
  remarks  String?

  @@index([issueId])
}

enum BorrowStatus {
  OUT
  PARTIALLY_RETURNED
  RETURNED
  OVERDUE
}

/// Tools and equipment lent out and expected back.
///
/// A borrow slip does NOT charge job cost (model §4.3) — the asset is on loan,
/// not consumed. It moves stock out of available and back again.
model BorrowSlip {
  id     String       @id @default(cuid())
  number String       @unique
  status BorrowStatus @default(OUT)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  borrowerId   String?
  borrower     User?   @relation("Borrower", fields: [borrowerId], references: [id], onDelete: SetNull)
  borrowerName String

  issuedById String
  issuedBy   User   @relation("BorrowIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  borrowedAt DateTime  @default(now()) @db.Date
  dueAt      DateTime  @db.Date
  returnedAt DateTime? @db.Date
  purpose    String
  notes      String?

  items BorrowSlipItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([dueAt])
}

model BorrowSlipItem {
  id     String     @id @default(cuid())
  slipId String
  slip   BorrowSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantity    Decimal @db.Decimal(18, 3)
  returnedQty Decimal @default(0) @db.Decimal(18, 3)
  serialNo    String?
  remarks     String?

  @@index([slipId])
}

/// Stock on hand per item per warehouse, with its moving-average cost.
model InventoryBalance {
  id          String    @id @default(cuid())
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  quantity    Decimal @default(0) @db.Decimal(18, 3)
  /// On loan via a borrow slip — still owned, not available to issue.
  borrowedQty Decimal @default(0) @db.Decimal(18, 3)

  /// Moving weighted average. Recomputed on every receipt; issues take it as
  /// given, which is what stops an issue changing the cost of what remains.
  averageCost Decimal @default(0) @db.Decimal(18, 4)

  updatedAt DateTime @updatedAt

  @@unique([itemId, warehouseId])
  @@index([warehouseId])
}

enum StockMoveType {
  RECEIPT
  ISSUE
  BORROW
  RETURN
  ADJUSTMENT
}

/// The stock card: every movement, in order, with the balance after it.
model InventoryTransaction {
  id          String    @id @default(cuid())
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  type         StockMoveType
  /// Signed: positive in, negative out.
  quantity     Decimal       @db.Decimal(18, 3)
  unitCost     Decimal       @default(0) @db.Decimal(18, 4)
  /// Balance after this movement, so the card reads without re-summing.
  balanceAfter Decimal       @db.Decimal(18, 3)

  sourceType   String
  sourceId     String?
  sourceNumber String?
  notes        String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())

  @@index([itemId, warehouseId, occurredAt])
  @@index([sourceType, sourceId])
}

// ════════════════════════════════════════════════════════════════════
//  G-HR  (Phase 6)
//
//  Clock in/out → Attendance → Timesheet → Job labour cost.
//  Leave and Overtime route through the one approval engine.
//
//  The rule that matters (model §4.4): overtime posts to a project's
//  budget ONLY once the supervisor AND HR have both approved. That is
//  enforced by the workflow having two steps and the module subscribing
//  to the settled outcome — never to an intermediate approval.
// ════════════════════════════════════════════════════════════════════

/// A face descriptor captured at enrolment. Several per employee improves
/// matching across lighting, glasses and angle.
///
/// The 128-float descriptor is computed in the browser and matched on the
/// server by Euclidean distance. See docs: this trusts the client to compute
/// honestly, which is why the capture photo is always stored as evidence.
model FaceEnrollment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// 128 floats.
  descriptor Json
  photoPath  String?
  label      String?

  enrolledById String?
  enrolledBy   User?    @relation("FaceEnroller", fields: [enrolledById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([employeeId])
}

enum ClockMethod {
  FACE
  PIN
  BIOMETRIC
  MANUAL
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  HALF_DAY
  REST_DAY
}

/// One row per employee per day.
model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  timeIn       DateTime?
  timeInMethod ClockMethod?
  timeInPhoto  String?
  /// Match distance at clock-in, kept so a questionable match can be reviewed.
  timeInScore  Decimal?     @db.Decimal(6, 4)

  timeOut       DateTime?
  timeOutMethod ClockMethod?
  timeOutPhoto  String?
  timeOutScore  Decimal?     @db.Decimal(6, 4)

  status        AttendanceStatus @default(PRESENT)
  lateMinutes   Int              @default(0)
  /// Net of the unpaid break, so it is hours actually worked.
  workedMinutes Int              @default(0)

  notes        String?
  recordedById String?
  recordedBy   User?   @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
}

model LeaveType {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  /// The yearly allotment — "Allotted counts of leave per type" in Settings.
  daysPerYear   Decimal @default(0) @db.Decimal(6, 2)
  isPaid        Boolean @default(true)
  /// Sick leave usually needs a medical certificate.
  requiresProof Boolean @default(false)
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  balances LeaveBalance[]
  requests LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// What an employee is entitled to, and has used, in one year.
model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  year        Int
  entitled    Decimal @default(0) @db.Decimal(6, 2)
  carriedOver Decimal @default(0) @db.Decimal(6, 2)
  /// Only APPROVED leave counts here — pending requests are shown separately.
  used        Decimal @default(0) @db.Decimal(6, 2)

  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([year])
}

enum LeaveStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id     String      @id @default(cuid())
  number String      @unique
  status LeaveStatus @default(DRAFT)

  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  /// Dates carry times so a half day accounts correctly — "Start Date – End
  /// Date with time so that anyone who file for half day will account."
  startDate DateTime @db.Date
  startTime String?
  endDate   DateTime @db.Date
  endTime   String?
  /// Working days, to 0.5.
  days      Decimal  @db.Decimal(6, 2)

  reason      String
  proofNote   String?
  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?     @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([startDate])
}

enum OtStage {
  PRIOR
  PRIOR_APPROVED
  ACTUAL_FILED
  APPROVED
  REJECTED
  CANCELLED
}

/// Overtime, in two acts.
///
/// 1. PRIOR — filed BEFORE the work with estimated hours. Its whole purpose is
///    the employee's evidence that the overtime was authorised.
/// 2. ACTUAL — the real finish time, filed after. Any variance against the
///    estimate is shown to the approver rather than quietly absorbed.
///
/// Cost posts to the job only when the actual filing is fully approved.
model OvertimeRequest {
  id     String  @id @default(cuid())
  number String  @unique
  stage  OtStage @default(PRIOR)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  /// "HH:mm" local to the site — overtime is planned in wall-clock time.
  plannedStart   String
  plannedEnd     String
  estimatedHours Decimal @db.Decimal(6, 2)

  actualStart String?
  actualEnd   String?
  actualHours Decimal? @db.Decimal(6, 2)
  /// Dinner break 17:00–18:00, −60 min, pre-checked. Unchecking means
  /// continuous work.
  dinnerBreak Boolean  @default(true)

  reason       String
  varianceNote String?

  /// Where the cost is deducted from — "On approvals have an option to where
  /// project it will be deducted in G-Ops Project management Budget Monitoring."
  jobId          String?
  job            Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  costCategoryId String?
  costCategory   CostCategory? @relation(fields: [costCategoryId], references: [id], onDelete: SetNull)

  /// Snapshotted at posting so a later rate change does not rewrite history.
  hourlyRate Decimal? @db.Decimal(14, 4)
  multiplier Decimal? @db.Decimal(6, 3)
  amount     Decimal? @db.Decimal(18, 2)

  priorApprovedAt DateTime?
  postedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, stage])
  @@index([date])
  @@index([jobId])
}

// ════════════════════════════════════════════════════════════════════
//  PLANTILLA — the authorised staffing pattern (G-HR)
// ════════════════════════════════════════════════════════════════════

/// A job title, the department it sits in and how many the company has
/// approved. Filled and vacant are DERIVED by counting active employees on
/// the position — never stored.
model Position {
  id                  String              @id @default(cuid())
  code                String              @unique
  title               String
  departmentId        String?
  department          Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  authorisedHeadcount Int                 @default(1)
  description         String?
  sortOrder           Int                 @default(0)
  isActive            Boolean             @default(true)
  employees           Employee[]
  courseRequirements  CourseRequirement[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([departmentId])
}

// ════════════════════════════════════════════════════════════════════
//  CLEARANCE — turnover of accountabilities before someone leaves
// ════════════════════════════════════════════════════════════════════

enum SeparationReason {
  RESIGNATION
  END_OF_CONTRACT
  END_OF_PROJECT
  TERMINATION
  RETIREMENT
  AWOL
  OTHER
}

enum ClearanceStatus {
  OPEN
  PENDING_APPROVAL
  CLEARED
  REJECTED
  CANCELLED
}

/// Who clears an item — mapped to an existing right in areaRight().
enum ClearanceArea {
  SUPERVISOR
  WAREHOUSE
  FINANCE
  HR
  ADMIN
}

enum ClearanceItemStatus {
  PENDING
  CLEARED
  WAIVED
}

/// The checklist is built from records the system already holds (open borrow
/// slips, unpaid claims, pending filings, projects and people assigned to the
/// leaver) plus the company-property list in HR Settings. Items that point at
/// a record derive their status FROM that record on read. Approval of this
/// document is what records the separation.
model EmployeeClearance {
  id             String           @id @default(cuid())
  number         String           @unique
  status         ClearanceStatus  @default(OPEN)
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reason         SeparationReason
  lastWorkingDay DateTime         @db.Date
  raisedById     String
  raisedBy       User             @relation("ClearanceRaiser", fields: [raisedById], references: [id], onDelete: Restrict)
  /// Prints as "Received by" on the form.
  handedOverToId String?
  handedOverTo   User?            @relation("ClearanceReceiver", fields: [handedOverToId], references: [id], onDelete: SetNull)
  notes          String?
  submittedAt    DateTime?
  clearedAt      DateTime?
  items          ClearanceItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([employeeId, status])
  @@index([status])
}

model ClearanceItem {
  id          String              @id @default(cuid())
  clearanceId String
  clearance   EmployeeClearance   @relation(fields: [clearanceId], references: [id], onDelete: Cascade)
  area        ClearanceArea
  sortOrder   Int                 @default(0)
  description String
  /// Set when the item IS a record elsewhere: 'borrow_slip' | 'expense_claim' |
  /// 'leave_request' | 'overtime_request' | 'job' | 'tasks' | 'leads' |
  /// 'quotations' | 'visits' | 'activities' | 'approvals' | 'reports' |
  /// 'sessions'. Its status is derived by syncClearanceItems(); it cannot be
  /// cleared by hand, only waived with a written reason.
  sourceType  String?
  sourceId    String?
  link        String?
  status      ClearanceItemStatus @default(PENDING)
  clearedById String?
  clearedBy   User?               @relation("ClearanceClearer", fields: [clearedById], references: [id], onDelete: SetNull)
  clearedAt   DateTime?
  /// Mandatory on WAIVED.
  remarks     String?

  @@unique([clearanceId, sourceType, sourceId])
  @@index([clearanceId])
}

// ════════════════════════════════════════════════════════════════════
//  MEETINGS — an internal meeting with invitees; the Meet link is pasted
//  from the organiser's own Google account (G-Core holds no credentials)
// ════════════════════════════════════════════════════════════════════

enum InviteeResponse {
  PENDING
  ACCEPTED
  TENTATIVE
  DECLINED
}

model Meeting {
  id               String           @id @default(cuid())
  number           String           @unique
  title            String
  agenda           String?
  location         String?
  startsAt         DateTime
  endsAt           DateTime
  status           ActivityStatus   @default(PLANNED)
  organizerId      String
  organizer        User             @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  /// The project it is held for — a kick-off, a site meeting, a turnover —
  /// so the project's Meetings & Records tab lists it. Optional: most
  /// meetings are nobody's project.
  jobId            String?
  job              Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// https://meet.google.com/abc-defg-hij — pasted back, never derived.
  meetLink         String?
  calendarEventUrl String?
  /// Reserved for a Calendar API integration. Null until that ships.
  googleEventId    String?
  /// RFC 5545 SEQUENCE — bumped on every time change so a re-downloaded .ics
  /// replaces the event instead of duplicating it.
  icsSequence      Int              @default(0)
  cancelReason     String?
  invitees         MeetingInvitee[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([startsAt])
  @@index([organizerId, startsAt])
  @@index([status, startsAt])
  @@index([jobId, startsAt])
}

model MeetingInvitee {
  id          String          @id @default(cuid())
  meetingId   String
  meeting     Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation("MeetingInvitee", fields: [userId], references: [id], onDelete: Cascade)
  required    Boolean         @default(true)
  response    InviteeResponse @default(PENDING)
  respondedAt DateTime?
  /// null = the in-app invitation has not been sent yet.
  notifiedAt  DateTime?

  @@unique([meetingId, userId])
  @@index([userId])
}

// ════════════════════════════════════════════════════════════════════
//  EVALUATIONS — probationary and trainee feedback; approval regularises
// ════════════════════════════════════════════════════════════════════

enum EvaluationKind {
  PROBATIONARY
  TRAINEE
}

enum EvaluationStatus {
  SCHEDULED
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

/// REGULARIZE / EXTEND / END for PROBATIONARY; ABSORB / END for TRAINEE.
enum EvaluationRecommendation {
  REGULARIZE
  EXTEND
  END
  ABSORB
}

model EmployeeEvaluation {
  id                          String                    @id @default(cuid())
  number                      String                    @unique
  kind                        EvaluationKind
  status                      EvaluationStatus          @default(DRAFT)
  /// 'MONTH_3' | 'MONTH_5' | 'END' | 'ADHOC'
  milestone                   String
  employeeId                  String
  employee                    Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// The record OWNER for canEditRecord.
  evaluatorId                 String
  evaluator                   User                      @relation("Evaluator", fields: [evaluatorId], references: [id], onDelete: Restrict)
  scheduledById               String?
  scheduledBy                 User?                     @relation("EvaluationScheduler", fields: [scheduledById], references: [id], onDelete: SetNull)
  dueDate                     DateTime?                 @db.Date
  periodFrom                  DateTime?                 @db.Date
  periodTo                    DateTime?                 @db.Date
  strengths                   String?
  improvements                String?
  comments                    String?
  recommendation              EvaluationRecommendation?
  effectiveDate               DateTime?                 @db.Date
  extendedTo                  DateTime?                 @db.Date
  /// Weighted mean of rated lines, 2dp. Not money.
  score                       Decimal?                  @db.Decimal(5, 2)
  submittedAt                 DateTime?
  approvedAt                  DateTime?
  employeeAcknowledgedAt      DateTime?
  employeeAcknowledgementNote String?
  lines                       EmployeeEvaluationLine[]
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  @@index([employeeId, status])
  @@index([evaluatorId, status])
  @@index([status, dueDate])
}

/// A SNAPSHOT of the criterion (hr.evaluationCriteria) at creation, so a
/// renamed or retired criterion never rewrites a signed form.
model EmployeeEvaluationLine {
  id           String             @id @default(cuid())
  evaluationId String
  evaluation   EmployeeEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterionKey String
  sortOrder    Int
  name         String
  weight       Decimal            @db.Decimal(5, 2)
  rating       Int?
  remarks      String?

  @@index([evaluationId])
}

// ════════════════════════════════════════════════════════════════════
//  GRUNTECH ACADEMY — courses, sessions and the training passport
// ════════════════════════════════════════════════════════════════════

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendeeResult {
  PENDING
  PASSED
  FAILED
  NO_SHOW
}

enum TrainingSource {
  SESSION
  EXTERNAL
}

enum TrainingRecordStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

model Course {
  id                 String              @id @default(cuid())
  /// Human code typed by HR (SAF-01), not nextNumber.
  code               String              @unique
  title              String
  category           String?
  description        String?
  hours              Decimal             @default(0) @db.Decimal(6, 2)
  /// null = never expires. expiresAt = addMonths(completedAt, validityMonths).
  validityMonths     Int?
  requiresAssessment Boolean             @default(false)
  isActive           Boolean             @default(true)
  requirements       CourseRequirement[]
  sessions           TrainingSession[]
  records            TrainingRecord[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([isActive])
}

/// Both null = everyone; department only = everyone in it; position only =
/// every holder of that plantilla position; both = the intersection.
model CourseRequirement {
  id           String      @id @default(cuid())
  courseId     String
  course       Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  positionId   String?
  position     Position?   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@unique([courseId, departmentId, positionId])
  @@index([departmentId])
  @@index([positionId])
}

model TrainingSession {
  id           String             @id @default(cuid())
  number       String             @unique
  status       SessionStatus      @default(SCHEDULED)
  courseId     String
  course       Course             @relation(fields: [courseId], references: [id], onDelete: Restrict)
  /// The OWNER for canEditRecord.
  trainerId    String
  trainer      User               @relation("SessionTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  provider     String?
  startsAt     DateTime
  endsAt       DateTime
  venue        String?
  meetLink     String?
  capacity     Int?
  notes        String?
  icsSequence  Int                @default(0)
  completedAt  DateTime?
  cancelReason String?
  createdById  String?
  createdBy    User?              @relation("SessionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attendees    TrainingAttendee[]
  records      TrainingRecord[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([startsAt])
  @@index([trainerId, status])
  @@index([courseId])
}

model TrainingAttendee {
  id           String          @id @default(cuid())
  sessionId    String
  session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  result       AttendeeResult  @default(PENDING)
  score        Decimal?        @db.Decimal(6, 2)
  enrolledAt   DateTime        @default(now())
  /// null = self-enrolled.
  enrolledById String?
  enrolledBy   User?           @relation("AttendeeEnroller", fields: [enrolledById], references: [id], onDelete: SetNull)

  @@unique([sessionId, employeeId])
  @@index([employeeId])
}

/// Expiry is NOT stored — CURRENT/EXPIRING/EXPIRED is derived from expiresAt on
/// read (expiryState in shared/aftermarket.ts). `status` records verification.
model TrainingRecord {
  id             String               @id @default(cuid())
  /// GT-TC-… for an EXTERNAL certification (the approval's handle); null for a
  /// record written by a session completion.
  number         String?              @unique
  employeeId     String
  employee       Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  courseId       String
  course         Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)
  source         TrainingSource
  sessionId      String?
  session        TrainingSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  status         TrainingRecordStatus
  completedAt    DateTime             @db.Date
  expiresAt      DateTime?            @db.Date
  provider       String?
  certificateNo  String?
  notes          String?
  verifiedById   String?
  verifiedBy     User?                @relation("TrainingVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt     DateTime?
  /// When the expiring-soon notice went out — reset to null when expiresAt changes.
  expiryNoticeAt DateTime?
  createdById    String?
  createdBy      User?                @relation("TrainingRecordAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([sessionId, employeeId])
  @@index([employeeId, courseId])
  @@index([expiresAt])
  @@index([status])
}

/// Saved filters for the shared list pattern (model §8.4).
model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listKey   String
  name      String
  query     Json
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([listKey])
}

// ═══════════════════════════════════════════════════════════════════════════
//  G-FIN — Phase 7
//
//  Finance CONSUMES operational transactions; it does not re-key them
//  (model §4.6). An invoice is raised from an approved progress billing and
//  carries its figures forward. A supplier bill is raised against a purchase
//  order and its receivings. An expense claim is the only document here that
//  starts life in finance.
//
//  The rule that shapes all of it: invoiced ≠ collectible. EWT is withheld at
//  source by the customer and comes back as a tax certificate, not as cash, so
//  every outstanding balance is measured against NET COLLECTIBLE.
// ═══════════════════════════════════════════════════════════════════════════

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// What we billed the customer. Raised from a progress billing wherever one
/// exists, so the figures are carried rather than retyped.
model Invoice {
  id     String        @id @default(cuid())
  number String        @unique
  status InvoiceStatus @default(DRAFT)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  /// One invoice per progress billing. A billing that has been invoiced cannot
  /// be invoiced again — that is what makes double-billing impossible rather
  /// than merely discouraged.
  progressBillingId String?          @unique
  progressBilling   ProgressBilling? @relation(fields: [progressBillingId], references: [id], onDelete: Restrict)

  /// One invoice per chargeable job order — the same guarantee progressBillingId
  /// gives billings.
  jobOrderId String?   @unique
  jobOrder   JobOrder? @relation(fields: [jobOrderId], references: [id], onDelete: Restrict)

  invoiceDate DateTime @db.Date
  dueDate     DateTime @db.Date
  terms       String?
  poReference String?

  /// Snapshotted from the billing, or entered on a standalone invoice. Never
  /// recomputed from Settings afterwards.
  grossAmount    Decimal @db.Decimal(18, 2)
  vatRate        Decimal @default(0.12) @db.Decimal(6, 4)
  vatAmount      Decimal @db.Decimal(18, 2)
  ewtRate        Decimal @default(0.02) @db.Decimal(6, 4)
  ewtAmount      Decimal @db.Decimal(18, 2)
  invoiceTotal   Decimal @db.Decimal(18, 2)
  /// invoiceTotal − ewtAmount. THE figure A/R is measured against.
  netCollectible Decimal @db.Decimal(18, 2)

  /// Maintained from allocations. Denormalised because every A/R screen reads
  /// it and the aging query cannot afford a join per row.
  amountCollected Decimal @default(0) @db.Decimal(18, 2)

  /// BIR Form 2307. Until it arrives the withheld tax is neither cash nor a
  /// credit — worth chasing, and invisible unless it is recorded.
  ewtCertificateNo String?
  ewtCertificateAt DateTime? @db.Date

  notes      String?
  issuedAt   DateTime?
  voidedAt   DateTime?
  voidReason String?

  createdById String
  createdBy   User   @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  lines       InvoiceLine[]
  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId, status])
  @@index([dueDate])
  @@index([jobId])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  sortOrder   Int     @default(0)
  description String
  /// Percentage billed this period, where the line came from a scope item.
  detail      String?
  amount      Decimal @db.Decimal(18, 2)

  @@index([invoiceId])
}

enum BillStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// What a supplier billed us. Raised against a purchase order where one
/// exists.
///
/// A bill matched to a receiving posts NOTHING to the job cost ledger: the
/// receiving already incurred it, and posting again would charge the same peso
/// twice. A bill with no receiving behind it — a subcontractor certificate, a
/// service call, a utility — is the first time that cost appears, so that one
/// does post.
model SupplierBill {
  id     String     @id @default(cuid())
  number String     @unique
  status BillStatus @default(DRAFT)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  orderId String?
  order   PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Set when the bill covers goods already received. Its presence is what
  /// suppresses the cost posting.
  receivingId String?
  receiving   Receiving? @relation(fields: [receivingId], references: [id], onDelete: SetNull)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  costCategoryId String?
  costCategory   CostCategory? @relation("BillCategory", fields: [costCategoryId], references: [id], onDelete: SetNull)

  /// Theirs, not ours — printed on their invoice.
  supplierInvoiceNo String?
  billDate          DateTime @db.Date
  dueDate           DateTime @db.Date
  terms             String?

  subtotal  Decimal @db.Decimal(18, 2)
  vatRate   Decimal @default(0.12) @db.Decimal(6, 4)
  vatAmount Decimal @db.Decimal(18, 2)
  total     Decimal @db.Decimal(18, 2)

  /// Gruntech withholds from the supplier in turn — 1% on goods, 2% on
  /// services by default. Withheld on the subtotal, never on the VAT.
  ewtRate    Decimal @default(0) @db.Decimal(6, 4)
  ewtAmount  Decimal @default(0) @db.Decimal(18, 2)
  /// total − ewtAmount. What actually leaves the bank.
  netPayable Decimal @db.Decimal(18, 2)

  amountPaid Decimal @default(0) @db.Decimal(18, 2)

  /// True when a job cost entry was written for this bill, so a later status
  /// change cannot post it a second time.
  postedToJob Boolean   @default(false)
  postedAt    DateTime?

  notes      String?
  approvedAt DateTime?

  createdById String
  createdBy   User   @relation("BillCreator", fields: [createdById], references: [id], onDelete: Restrict)

  lines       SupplierBillLine[]
  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([supplierId, status])
  @@index([dueDate])
  @@index([jobId])
}

model SupplierBillLine {
  id     String       @id @default(cuid())
  billId String
  bill   SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  sortOrder   Int     @default(0)
  description String
  quantity    Decimal @default(1) @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  amount      Decimal @db.Decimal(18, 2)

  @@index([billId])
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REIMBURSED
  CANCELLED
  /// A liquidation the advance fully covered. Nothing is owed to the person.
  SETTLED
}

/// Money someone spent out of their own pocket on the company's behalf.
///
/// The only G-FIN document that does not come from an operational one, and
/// therefore the only one where a person keys the amounts. Approving it posts
/// INCURRED cost when it is tagged to a job.
model ExpenseClaim {
  id     String        @id @default(cuid())
  number String        @unique
  status ExpenseStatus @default(DRAFT)

  claimedById String
  claimedBy   User   @relation("Claimant", fields: [claimedById], references: [id], onDelete: Restrict)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  costCategoryId String?
  costCategory   CostCategory? @relation("ExpenseCategory", fields: [costCategoryId], references: [id], onDelete: SetNull)

  /// Set when this claim LIQUIDATES a cash advance. The lines are the receipts
  /// against it; total − advance.amountReleased is the excess owed to the
  /// person (settled here like any claim) or, when negative, the unspent cash
  /// owed back (carried on the advance as REFUND_DUE). Not unique: a rejected
  /// liquidation is re-filed; the route allows one LIVE claim per advance.
  advanceId String?
  advance   CashAdvance? @relation(fields: [advanceId], references: [id], onDelete: Restrict)

  /// Set when this claim LIQUIDATES a budget request — project cash, the
  /// same arithmetic as an advance's liquidation. One or the other, never both.
  budgetRequestId String?
  budgetRequest   BudgetRequest? @relation(fields: [budgetRequestId], references: [id], onDelete: Restrict)

  claimDate DateTime @db.Date
  purpose   String

  total Decimal @default(0) @db.Decimal(18, 2)

  amountPaid Decimal @default(0) @db.Decimal(18, 2)

  postedToJob Boolean   @default(false)
  postedAt    DateTime?

  notes      String?
  approvedAt DateTime?

  lines       ExpenseClaimLine[]
  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([claimedById, status])
  @@index([jobId])
  @@index([advanceId])
}

model ExpenseClaimLine {
  id      String       @id @default(cuid())
  claimId String
  claim   ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  sortOrder   Int      @default(0)
  spentOn     DateTime @db.Date
  description String
  /// Free text: fare, meals, accommodation, materials bought on site…
  category    String?
  /// The OR or receipt number, because a claim without one is not claimable.
  receiptNo   String?
  amount      Decimal  @db.Decimal(18, 2)

  @@index([claimId])
}

/// Money issued to a person BEFORE it is spent. It is a receivable from that
/// person until an approved liquidation (an ExpenseClaim with advanceId) says
/// what was spent. Nothing reaches a job's ledger until then; the liquidation
/// posts INCURRED at the amount actually spent.
enum CashAdvanceStatus {
  DRAFT
  PENDING_APPROVAL
  /// Approved; finance has not yet handed the cash over.
  APPROVED
  /// Cash handed over; waiting for the liquidation.
  RELEASED
  /// Liquidation approved and the person still holds unspent cash.
  REFUND_DUE
  /// Liquidation approved and nothing is owed either way.
  LIQUIDATED
  REJECTED
  CANCELLED
}

model CashAdvance {
  id     String            @id @default(cuid())
  number String            @unique
  status CashAdvanceStatus @default(DRAFT)

  requestedById String
  requestedBy   User   @relation("AdvanceRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  /// Where the spend will be charged. Fixed for the liquidation that follows.
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  costCategoryId String?
  costCategory   CostCategory? @relation("AdvanceCategory", fields: [costCategoryId], references: [id], onDelete: SetNull)

  requestDate DateTime  @db.Date
  neededBy    DateTime? @db.Date
  purpose     String

  amount Decimal @db.Decimal(18, 2)

  /// Re-derived by refreshAdvance(): Σ DISBURSEMENT allocations. 0 or amount —
  /// an advance is released in one voucher.
  amountReleased Decimal @default(0) @db.Decimal(18, 2)
  /// Re-derived by refreshAdvance(): the approved liquidation's total, else 0.
  amountSpent    Decimal @default(0) @db.Decimal(18, 2)
  /// Re-derived by refreshAdvance(): Σ RECEIPT allocations (unspent cash returned).
  amountRefunded Decimal @default(0) @db.Decimal(18, 2)

  /// releasedAt + finance.rules.advanceLiquidationDays, snapshotted at release.
  liquidationDueDate DateTime? @db.Date

  approvedAt   DateTime?
  releasedAt   DateTime? @db.Date
  liquidatedAt DateTime?
  notes        String?

  liquidations ExpenseClaim[]
  allocations  PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([requestedById, status])
  @@index([jobId])
}

enum PaymentKind {
  /// Money in — a customer settling an invoice, or a person returning unspent
  /// cash from an advance. "Collections" means customer receipts only.
  RECEIPT
  /// Money out — a supplier bill or an expense reimbursement.
  DISBURSEMENT
}

enum PaymentMethod {
  CASH
  CHECK
  BANK_TRANSFER
  ONLINE
  OFFSET
}

/// One movement of money, allocated across one or more documents.
///
/// Allocation matters: a customer rarely pays exactly one invoice. A single
/// cheque against three billings has to land on the right three, or A/R aging
/// is fiction.
model Payment {
  id     String        @id @default(cuid())
  number String        @unique
  kind   PaymentKind
  method PaymentMethod @default(BANK_TRANSFER)

  paymentDate DateTime @db.Date

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  /// For an expense reimbursement, the person being paid back.
  payeeUserId String?
  payeeUser   User?   @relation("Payee", fields: [payeeUserId], references: [id], onDelete: SetNull)

  amount Decimal @db.Decimal(18, 2)

  /// Cheque number, transfer reference, OR number.
  reference String?
  bank      String?
  /// A cheque is not cash until it clears; until then it is a promise.
  clearedAt DateTime? @db.Date

  notes String?

  recordedById String
  recordedBy   User   @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, paymentDate])
  @@index([customerId])
  @@index([supplierId])
  @@index([payeeUserId])
}

/// A slice of a payment applied to one document. Exactly one of the four
/// document references is set.
model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  billId String?
  bill   SupplierBill? @relation(fields: [billId], references: [id], onDelete: Cascade)

  claimId String?
  claim   ExpenseClaim? @relation(fields: [claimId], references: [id], onDelete: Cascade)

  /// A DISBURSEMENT allocation to an advance is the cash release; a RECEIPT
  /// allocation to an advance is the refund of unspent cash. Direction comes
  /// from Payment.kind, never from a second column.
  advanceId String?
  advance   CashAdvance? @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  /// A DISBURSEMENT allocation to a budget request is the release of project
  /// cash; a RECEIPT allocation is unspent cash coming back. Same rule as the
  /// advance: direction comes from Payment.kind.
  budgetRequestId String?
  budgetRequest   BudgetRequest? @relation(fields: [budgetRequestId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([invoiceId])
  @@index([billId])
  @@index([claimId])
  @@index([advanceId])
  @@index([budgetRequestId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  AFTERMARKET — Phase 8
//
//  What turns a finished project into a renewal pipeline (model §4.5):
//
//    Job turnover → installed asset register → warranty
//      → service contract → PM schedule → visit
//      → commissioning / PM / inspection report → billing → renewal
//
//  A service contract is NOT a new kind of commercial record: it is a Job of
//  type SERVICE_CONTRACT, with its own costing, budget across the same five
//  categories, schedule of values and progress billing. ServiceContract below
//  carries only what a job does not already have — what is covered, how often,
//  and when it runs out.
// ═══════════════════════════════════════════════════════════════════════════

enum AssetStatus {
  /// Installed and in service.
  ACTIVE
  /// Still installed, not running — mothballed, awaiting parts.
  INACTIVE
  /// Removed from site, or replaced.
  DECOMMISSIONED
}

/// One piece of equipment Gruntech installed, where it stands today.
///
/// The register is what makes aftermarket possible at all: without it nobody
/// can answer "what did we put in that hospital, and when does its warranty
/// run out".
/// The equipment types the register suggests — COMPRESSOR, DRYER, FILTER…
/// (seeded, CAPSLOCK) plus any typed on a registration since. A list, not a
/// reference: the asset keeps its type as text in `name`.
model EquipmentType {
  id        String   @id @default(cuid())
  name      String
  /// The name trimmed, single-spaced, upper-cased: one type per spelling.
  key       String   @unique
  sortOrder Int      @default(99)
  createdAt DateTime @default(now())
}

model InstalledAsset {
  id     String      @id @default(cuid())
  code   String      @unique
  status AssetStatus @default(ACTIVE)

  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  siteId     String?
  site       CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  /// The project that installed it. Kept even after the job closes — this link
  /// is how a turned-over project becomes a renewal lead.
  jobId String?
  job   Job?    @relation("AssetInstaller", fields: [jobId], references: [id], onDelete: SetNull)

  /// The catalogue item, where it was one Gruntech supplies.
  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  /// The equipment type — COMPRESSOR, DRYER, FIRE PUMP… — suggested from
  /// EquipmentType and remembered there when a new one is typed.
  name         String
  manufacturer String?
  model        String?
  serialNo     String?
  /// Specification: supply voltage, power, flow, pressure, application…
  capacity     String?
  /// Where on the premises the machine stands ("Plant room, 2nd floor").
  location     String?
  /// Where the machine is, as an address — the register asks for this rather
  /// than a CustomerSite; `siteId` stays for assets registered by turnover.
  address      String?

  installedAt    DateTime? @db.Date
  commissionedAt DateTime? @db.Date
  /// When free repair stops and billable service starts. The single most
  /// commercially useful date in this table.
  warrantyEndsAt DateTime? @db.Date

  notes String?

  createdById String?
  createdBy   User?   @relation("AssetCreator", fields: [createdById], references: [id], onDelete: SetNull)

  contracts ServiceContractAsset[]
  visits    ServiceVisit[]
  reports   ServiceReport[]
  jobOrders JobOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, status])
  @@index([siteId])
  @@index([warrantyEndsAt])
  @@index([serialNo])
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  RENEWED
  CANCELLED
}

/// The coverage terms of a service contract.
///
/// One-to-one with a Job of type SERVICE_CONTRACT, which holds the money: the
/// costing, the budget, the schedule of values and the progress billings. This
/// record answers only the questions a job cannot — which equipment is covered,
/// how often it is visited, what response time was promised, and when it runs
/// out.
model ServiceContract {
  id     String         @id @default(cuid())
  number String         @unique
  status ContractStatus @default(DRAFT)

  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  startsAt DateTime @db.Date
  endsAt   DateTime @db.Date

  /// Months between preventive-maintenance visits. 3 = quarterly.
  frequencyMonths Int @default(3)
  /// Planned visits over the whole term. Derived on generation, stored so a
  /// later change of frequency does not rewrite a schedule already agreed.
  plannedVisits   Int @default(0)

  /// Hours promised for a breakdown call. Free text because contracts say
  /// things like "next working day" as often as they say a number.
  responseTime  String?
  /// What the contract does NOT cover — consumables, parts, travel.
  exclusions    String?
  coverageNotes String?

  /// Set when this contract replaced an expiring one, so a renewal chain is
  /// readable backwards.
  renewedFromId String?          @unique
  renewedFrom   ServiceContract? @relation("Renewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedTo     ServiceContract? @relation("Renewal")

  assets    ServiceContractAsset[]
  visits    ServiceVisit[]
  reports   ServiceReport[]
  jobOrders JobOrder[]

  createdById String
  createdBy   User   @relation("ContractCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, endsAt])
}

model ServiceContractAsset {
  id         String          @id @default(cuid())
  contractId String
  contract   ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  assetId    String
  asset      InstalledAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([contractId, assetId])
  @@index([assetId])
}

enum ServiceKind {
  COMMISSIONING
  PREVENTIVE_MAINTENANCE
  INSPECTION
  CORRECTIVE
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

/// A planned or completed attendance on site.
///
/// Separate from the report on purpose: a visit that has not happened yet has
/// nothing to report, and "what is due this month" must be answerable without
/// reading half-empty documents. A report may also exist with no visit behind
/// it, because a breakdown call does not appear on a schedule.
model ServiceVisit {
  id     String      @id @default(cuid())
  number String      @unique
  kind   ServiceKind @default(PREVENTIVE_MAINTENANCE)
  status VisitStatus @default(SCHEDULED)

  contractId String?
  contract   ServiceContract? @relation(fields: [contractId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  siteId     String?
  site       CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  assetId String?
  asset   InstalledAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  /// Which visit of the contract's schedule this is — 1 of 4, 2 of 4.
  sequence    Int?
  dueDate     DateTime  @db.Date
  performedAt DateTime? @db.Date

  assignedToId String?
  assignedTo   User?   @relation("VisitEngineer", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// The job order this visit was scheduled from, when it was not generated
  /// by a contract's PM schedule. A visit with a sequence is generated; a
  /// visit without one is a call-out and survives regeneration.
  jobOrderId String?   @unique
  jobOrder   JobOrder? @relation(fields: [jobOrderId], references: [id], onDelete: SetNull)

  notes String?

  report ServiceReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueDate])
  @@index([contractId])
  @@index([assignedToId, status])
}

enum JobOrderStatus {
  DRAFT
  PENDING_APPROVAL
  /// Accepted; one ServiceVisit was scheduled from it.
  APPROVED
  /// The report on its visit was approved.
  COMPLETED
  REJECTED
  CANCELLED
}

enum ChargeBasis {
  WARRANTY
  CONTRACT
  CHARGEABLE
  GOODWILL
}

/// A request, usually from sales, for service work to be done. The
/// AUTHORISATION document: approval schedules exactly one ServiceVisit (the
/// attendance record) and the engineer's approved ServiceReport (the evidence)
/// completes it. It carries no cost of its own; cost reaches its jobId through
/// PRs, stock issues, overtime and expense claims that quote that job.
model JobOrder {
  id     String         @id @default(cuid())
  number String         @unique
  status JobOrderStatus @default(DRAFT)
  kind   ServiceKind    @default(CORRECTIVE)
  urgent Boolean        @default(false)

  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  siteId     String?
  site       CustomerSite?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  contactId  String?
  contact    CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assetId    String?
  asset      InstalledAsset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  title       String
  description String
  scope       String?

  /// When the customer wants it. Becomes the visit's dueDate.
  requestedFor DateTime @db.Date

  /// The DECISION. Defaulted from the facts, overridable, checked at approval.
  chargeBasis   ChargeBasis @default(CHARGEABLE)
  /// The FACT: asset.warrantyEndsAt >= requestedFor, computed server-side.
  underWarranty Boolean     @default(false)

  contractId  String?
  contract    ServiceContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  /// Charge-to job: the contract's job for CONTRACT, the installing project for
  /// WARRANTY, the requester's choice (or null) otherwise.
  jobId       String?
  job         Job?             @relation("JobOrderChargeTo", fields: [jobId], references: [id], onDelete: SetNull)
  quotationId String?
  quotation   Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  customerPoNumber String?
  /// Agreed price for chargeable work; null = billed on completion (T&M).
  amount           Decimal? @db.Decimal(18, 2)

  requestedById String
  requestedBy   User    @relation("JobOrderRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  assignedToId  String?
  assignedTo    User?   @relation("JobOrderEngineer", fields: [assignedToId], references: [id], onDelete: SetNull)

  customerAcknowledgedBy String?
  customerAcknowledgedAt DateTime?

  approvedAt   DateTime?
  completedAt  DateTime? @db.Date
  cancelledAt  DateTime?
  cancelReason String?
  notes        String?

  visit   ServiceVisit?
  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, requestedFor])
  @@index([customerId])
  @@index([assetId])
  @@index([requestedById])
  @@index([assignedToId, status])
}

/// A versioned form definition (model §4.5: "report templates are data").
///
/// A template is IMMUTABLE once a report has been written against it. Editing
/// publishes a new version under the same key; reports keep pointing at the
/// exact version they were filled in on, so an old report renders forever the
/// way it was signed.
model ReportTemplate {
  id          String      @id @default(cuid())
  /// Stable across versions. Duplicating a template gives a new key.
  key         String
  version     Int         @default(1)
  kind        ServiceKind
  name        String
  description String?

  /// [{ key, title, help?, fields: [{ key, label, type, options?, required?,
  ///    unit? }], allowPhotos?: boolean }]
  sections Json

  /// Only one version per key is the one new reports get.
  isCurrent Boolean @default(true)
  isActive  Boolean @default(true)

  createdById String?
  createdBy   User?   @relation("TemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  reports ServiceReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, version])
  @@index([kind, isCurrent])
}

enum ReportStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

/// A commissioning, PM, inspection or corrective report.
///
/// One document type with a kind, rather than three near-identical tables: the
/// fields that differ between them live in the template, which is data.
model ServiceReport {
  id     String       @id @default(cuid())
  number String       @unique
  kind   ServiceKind
  status ReportStatus @default(DRAFT)

  visitId String?       @unique
  visit   ServiceVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  contractId String?
  contract   ServiceContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  /// The project, for a commissioning report written at turnover.
  jobId String?
  job   Job?    @relation("ServiceReportJob", fields: [jobId], references: [id], onDelete: SetNull)

  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  siteId     String?
  site       CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  assetId String?
  asset   InstalledAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  /// The exact template VERSION this was filled in on.
  templateId String
  template   ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  performedAt   DateTime @db.Date
  performedById String
  performedBy   User     @relation("ReportAuthor", fields: [performedById], references: [id], onDelete: Restrict)

  /// The filled form: { [sectionKey]: { [fieldKey]: value, __photos?: [id] } }.
  data Json

  findings        String?
  recommendations String?
  /// Whether the work was covered — warranty, contract, or billable. Decided
  /// when the report is written, because that is when someone knows.
  billable        Boolean @default(false)
  underWarranty   Boolean @default(false)

  /// Acknowledged on site. A service report nobody signed is an assertion.
  customerSignedBy String?
  customerSignedAt DateTime?

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, status])
  @@index([customerId])
  @@index([assetId])
  @@index([performedAt])
}
