// G-CORE — Phase 1 (Foundation) schema.
//
// One database, one schema. Divisions are modules in this schema, never
// separate databases — see docs/BUSINESS-OPERATIONS-MODEL.md §10.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════════════
//  IDENTITY & ACCESS
// ════════════════════════════════════════════════════════════════════

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  name          String
  employeeNo    String? @unique
  passwordHash  String
  position      String?
  /// The author's mobile, printed under "Sincerely Yours," on a quotation
  /// (carried over from SCORO's quote layout). The login's own number, because
  /// an account need not have an Employee record behind it.
  phone         String?
  isActive      Boolean @default(true)
  isSuperAdmin  Boolean @default(false)
  /// Invited, and not yet in: the account exists (so it can be assigned work
  /// and approvals) but nobody has chosen its password. Cleared when the
  /// invitation — or a password reset — is used. See AccountToken.
  invitePending Boolean @default(false)

  /// Attachment id, not a disk path (same convention as FaceEnrollment.photoPath) —
  /// the most recent verified capture from face enrolment, or a plain upload for
  /// an account with no linked employee. Cosmetic only: nothing reads this for
  /// matching, so replacing it can never affect who clocks in as whom.
  photoPath String?

  // Approval routing: "approvers are to whom they are directly reporting".
  supervisorId String?
  supervisor   User?   @relation("Supervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  reports      User[]  @relation("Supervision")

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  roles     UserRole[]
  overrides UserPermissionOverride[]

  notifications          Notification[]
  savedFilters           SavedFilter[]
  attachments            Attachment[]
  auditLogs              AuditLog[]
  approvalsRaised        ApprovalRequest[]  @relation("Requester")
  approvalActions        ApprovalAction[]   @relation("ApprovalActor")
  followUpsRaised        ApprovalFollowUp[] @relation("FollowUpBy")
  stoodInFor             ApprovalAction[]   @relation("StoodInFor")
  workflowStepsTargeting ApprovalStep[]     @relation("StepUser")

  employee         Employee?
  customersCreated Customer[]        @relation("CustomerCreator")
  suppliersCreated Supplier[]        @relation("SupplierCreator")
  partnerResources PartnerResource[] @relation("PartnerResourceCreator")

  leadsAssigned     Lead[]                 @relation("LeadAssignee")
  leadsCreated      Lead[]                 @relation("LeadCreator")
  costingsOwned     Costing[]              @relation("CostingOwner")
  salesOrdersOwned  SalesOrder[]           @relation("SalesOrderOwner")
  costingsAssigned  Costing[]              @relation("CostingAssigner")
  costingTemplates  CostingTemplate[]      @relation("CostingTemplateAuthor")
  quotationsOwned   Quotation[]            @relation("QuotationOwner")
  revisionsApproved QuotationRevision[]    @relation("RevisionApprover")
  activities        SalesActivity[]        @relation("ActivityAssignee")
  activitiesBooked  SalesActivity[]        @relation("ActivityCreator")
  activityInvites   SalesActivityInvitee[]

  clearancesRaised       EmployeeClearance[]  @relation("ClearanceRaiser")
  clearancesReceived     EmployeeClearance[]  @relation("ClearanceReceiver")
  clearanceItemsCleared  ClearanceItem[]      @relation("ClearanceClearer")
  meetingsOrganized      Meeting[]            @relation("MeetingOrganizer")
  meetingMinutesWritten  Meeting[]            @relation("MeetingMinutesBy")
  flowItemsUpdated       EmployeeFlowItem[]   @relation("FlowItemUpdater")
  meetingInvites         MeetingInvitee[]     @relation("MeetingInvitee")
  evaluationsGiven       EmployeeEvaluation[] @relation("Evaluator")
  evaluationsScheduled   EmployeeEvaluation[] @relation("EvaluationScheduler")
  sessionsTrained        TrainingSession[]    @relation("SessionTrainer")
  sessionsCreated        TrainingSession[]    @relation("SessionCreator")
  attendeesEnrolled      TrainingAttendee[]   @relation("AttendeeEnroller")
  trainingVerified       TrainingRecord[]     @relation("TrainingVerifier")
  trainingRecordsCreated TrainingRecord[]     @relation("TrainingRecordAuthor")

  jobsManaged     Job[]            @relation("JobManager")
  jobsCreated     Job[]            @relation("JobCreator")
  costEntries     JobCostEntry[]
  budgetRequests  BudgetRequest[]  @relation("BudgetRequester")
  reportsPrepared ProgressReport[] @relation("ReportPreparer")
  reportsApproved ProgressReport[] @relation("ReportApprover")
  plansUploaded   ApprovedPlan[]   @relation("PlanUploader")
  tasksAssigned   JobTask[]        @relation("TaskAssignee")

  prsRequested      PurchaseRequest[]      @relation("PrRequester")
  canvassesCreated  Canvass[]              @relation("CanvassCreator")
  canvassesAwarded  Canvass[]              @relation("CanvassAwarder")
  rfqsPrepared      Rfq[]                  @relation("RfqPreparer")
  posCreated        PurchaseOrder[]        @relation("PoCreator")
  receivings        Receiving[]            @relation("Receiver")
  stockIssued       StockIssue[]           @relation("Issuer")
  stockReceivedBy   StockIssue[]           @relation("IssuedTo")
  borrowsTaken      BorrowSlip[]           @relation("Borrower")
  borrowsIssued     BorrowSlip[]           @relation("BorrowIssuer")
  borrowsRequested  BorrowSlip[]           @relation("BorrowRequester")
  pulloutsPrepared  PulloutSlip[]          @relation("PulloutPreparer")
  pulloutsReleased  PulloutSlip[]          @relation("PulloutReleaser")
  pulloutsRequested PulloutSlip[]          @relation("PulloutRequester")
  borrowsInspected  BorrowSlip[]           @relation("BorrowInspector")
  stockMoves        InventoryTransaction[]

  facesEnrolled      FaceEnrollment[] @relation("FaceEnroller")
  attendanceRecorded Attendance[]     @relation("AttendanceRecorder")
  leaveDecided       LeaveRequest[]   @relation("LeaveDecider")

  invoicesCreated  Invoice[]      @relation("InvoiceCreator")
  invoicesSold     Invoice[]      @relation("InvoiceSalesperson")
  billsCreated     SupplierBill[] @relation("BillCreator")
  billsPurchased   SupplierBill[] @relation("BillPurchaser")
  expenseClaims    ExpenseClaim[] @relation("Claimant")
  paymentsRecorded Payment[]      @relation("PaymentRecorder")
  reimbursements   Payment[]      @relation("Payee")
  cashAdvances     CashAdvance[]  @relation("AdvanceRequester")

  assetsCreated       InstalledAsset[]  @relation("AssetCreator")
  contractsCreated    ServiceContract[] @relation("ContractCreator")
  visitsAssigned      ServiceVisit[]    @relation("VisitEngineer")
  visitsConfirmed     ServiceVisit[]    @relation("VisitConfirmer")
  serviceDocumentsFiled ServiceDocument[] @relation("ServiceDocumentFiler")
  templatesAuthored   ReportTemplate[]  @relation("TemplateAuthor")
  reportsPerformed    ServiceReport[]   @relation("ReportAuthor")
  jobOrdersRequested  JobOrder[]        @relation("JobOrderRequester")
  jobOrdersAssigned   JobOrder[]        @relation("JobOrderEngineer")
  jobOrdersManaged    JobOrder[]        @relation("JobOrderProjectManager")
  jobOrdersEngineered JobOrder[]        @relation("JobOrderProjectEngineer")
  jobOrdersLed        JobOrder[]        @relation("JobOrderProjectLead")
  jobOrderSupport     JobOrderSupport[]
  cadRequested        CadJobOrder[]     @relation("CadRequestedBy")
  cadAssigned         CadJobOrder[]     @relation("CadAssignedTo")
  cadCompleted        CadJobOrder[]     @relation("CadCompletedBy")
  cadRevisions        CadRevision[]     @relation("CadRevisionSubmitter")
  cadComments         CadComment[]      @relation("CadCommentAuthor")
  helpTickets         HelpTicket[]      @relation("HelpTicketRaiser")
  helpTicketReplies   HelpTicketReply[] @relation("HelpTicketReplyAuthor")
  /// The teams this person supports on a team-scoped approval step (Back Support).
  supportTeams        UserSupportTeam[]

  quoteLinesProvided QuotationItem[]  @relation("QuoteLineProvider")
  soLinesProvided    SalesOrderLine[] @relation("SoLineProvider")

  accountTokens AccountToken[]

  lastLoginAt             DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  minutesAgreements       MinutesAgreement[]  @relation("MinutesAgreement")
  issuesReceived          StockIssue[]        @relation("IssueReceivedBy")
  billingsPrepared        ProgressBilling[]   @relation("BillingPreparer")
  invoiceRequestsRaised   InvoiceRequest[]    @relation("InvoiceRequestRequester")
  invoiceRequestsCredited InvoiceRequest[]    @relation("InvoiceRequestSalesperson")
  commissionsRaised       CommissionRequest[] @relation("CommissionRequester")
  commissionsCredited     CommissionRequest[] @relation("CommissionSalesperson")
  commissionShares        CommissionShare[]   @relation("CommissionBeneficiary")

  @@index([isActive])
  @@index([supervisorId])
}

enum AccountTokenPurpose {
  INVITE
  RESET
}

/// A one-time link that lets a person choose their password: the invitation
/// to a new account, or a password reset. Only the SHA-256 of the token is
/// stored, so a copy of this table cannot be used to get into an account —
/// the link itself is the only copy of the secret. A link is used once, runs
/// out at `expiresAt`, and is superseded by the next one of its kind.
model AccountToken {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     AccountTokenPurpose
  tokenHash   String              @unique
  expiresAt   DateTime
  usedAt      DateTime?
  /// Who issued it: the administrator behind an invitation or an admin reset;
  /// null for a reset the person asked for from the sign-in page.
  createdById String?
  createdAt   DateTime            @default(now())

  @@index([userId, purpose])
}

model Department {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  users              User[]
  employees          Employee[]
  positions          Position[]
  courseRequirements CourseRequirement[]
  createdAt          DateTime            @default(now())
}

model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  // System roles cannot be deleted, but their permissions remain editable —
  // "Roles should be customizable" (requirements §14).
  isSystem    Boolean @default(false)
  /// Its level on the organisation chart (2026-10-19, ROLE_REV1): 1 is the
  /// CEO / President, 6 the skilled trades. A person's title on documents is
  /// their highest role — the lowest rank, then `sortOrder` (the chart's order).
  rank        Int?
  sortOrder   Int     @default(0)
  /// The role this role reports to (2026-10-19, Admin › Roles › Hierarchy):
  /// set by role, never by person; "Apply to people" writes each holder's
  /// "Reports to" from it (the parent role's holder, same team first).
  reportsToRoleId String?
  reportsToRole   Role?   @relation("RoleHierarchy", fields: [reportsToRoleId], references: [id], onDelete: SetNull)
  reportingRoles  Role[]  @relation("RoleHierarchy")
  /// Further roles it also reports to (2026-10-20, the owner's call: the
  /// Warehouse Supervisor reports to both Purchasing Managers). Drawn on the
  /// role chart; "Apply to people" writes the first parent only.
  alsoReportsToRoleIds String[] @default([])

  permissions            RolePermission[]
  plantilla              Position[]         @relation("PositionRole")
  users                  UserRole[]
  workflowStepsTargeting ApprovalStep[]     @relation("StepRole")
  workflowsForRequester  ApprovalWorkflow[] @relation("WorkflowRequesterRole")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Who added it (2026-10-18): "Edit Own" on Admin › Roles reads it.
  createdById String?
}

/// One row per `module.submodule.action` triple. Seeded from
/// src/permissions/registry.ts — the registry is the source of truth.
model Permission {
  id        String @id @default(cuid())
  key       String @unique
  module    String
  submodule String
  action    String
  label     String

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@index([module, submodule])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

enum OverrideEffect {
  ALLOW
  DENY
}

/// Per-user grant or revoke on top of their roles. This is what makes
/// "I can customize what they can access ... until the menu of this access"
/// work without inventing a role per person. DENY always wins.
model UserPermissionOverride {
  userId       String
  permissionId String
  effect       OverrideEffect
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

// ════════════════════════════════════════════════════════════════════
//  COMPANY & CONFIGURATION
// ════════════════════════════════════════════════════════════════════

/// Single row. Drives every PDF header — "Settings for PDF Details
/// (Company Details, Logo to be used)".
model Company {
  id        String  @id @default("company")
  name      String
  legalName String?
  address   String?
  city      String?
  country   String  @default("Philippines")
  tin       String?
  /// SEC registration number, printed on the letterhead as "REG. NO.".
  regNo     String?
  phone     String?
  fax       String?
  email     String?
  website   String?
  logoPath  String?
  currency  String  @default("PHP")

  /// Where customers pay. Printed on documents that ask for payment.
  bankName        String?
  bankBranch      String?
  bankAccount     String?
  /// Footer strapline, e.g. "INDUSTRIAL UTILITY SOLUTIONS  WWW.GRUNTECHNOLOGY.COM".
  documentTagline String?

  /// Tax rates are configuration, not constants — rates change, and some
  /// customers withhold differently (model §5.4).
  vatRate Decimal @default(0.12) @db.Decimal(6, 4)
  ewtRate Decimal @default(0.02) @db.Decimal(6, 4)

  /// Prefixes every document number, e.g. GT-QT-2026-0001.
  numberPrefix String @default("GT")

  updatedAt DateTime @updatedAt
}

/// Free-form keyed configuration. Anything that must be changeable without a
/// deploy and does not deserve its own column.
model Setting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

enum SequencePeriod {
  YEAR
  MONTH
  NONE
}

/// GLOBAL: one counter per period. OWNER: one counter per period per author.
enum SequenceScope {
  GLOBAL
  OWNER
}

/// Configurable document numbering (model §7).
/// periodKey is composed: YEAR → "2026", MONTH → "2026-09", NONE → "";
/// scope OWNER appends "@" + the author's 3-digit employee token, e.g.
/// "2026-09@001". The template row is always periodKey "".
model NumberSequence {
  id           String         @id @default(cuid())
  documentType String
  label        String
  pattern      String         @default("{PREFIX}-{TYPE}-{YYYY}-{SEQ}")
  typeCode     String
  period       SequencePeriod @default(YEAR)
  scope        SequenceScope  @default(GLOBAL)
  periodKey    String         @default("")
  padding      Int            @default(4)
  lastNumber   Int            @default(0)
  updatedAt    DateTime       @updatedAt

  @@unique([documentType, periodKey])
}

// ════════════════════════════════════════════════════════════════════
//  APPROVAL ENGINE  (one engine for every document type — model §6.1)
// ════════════════════════════════════════════════════════════════════

enum ApproverType {
  ROLE
  USER
  SUPERVISOR
  HR
  /// The manager of the project the document names (ApprovalRequest.jobId);
  /// the step's role — Executive by default — when the project has none or
  /// the requester is that manager.
  PROJECT_MANAGER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalActionType {
  APPROVED
  REJECTED
  RETURNED
}

model ApprovalWorkflow {
  id           String  @id @default(cuid())
  documentType String
  name         String
  isActive     Boolean @default(true)

  /// Amount band this workflow applies to. Null = unbounded. This is how
  /// "approval thresholds should be configurable in Settings" is expressed.
  minAmount Decimal? @db.Decimal(18, 2)
  maxAmount Decimal? @db.Decimal(18, 2)

  /// Set: an OPTIONAL route, offered to the submitter under this label when
  /// the amount is in its band ("Add the CEO as approver") and used only when
  /// they tick it. Null: a standard route, picked by amount alone.
  optionLabel String?

  /// Set: the route for documents PREPARED by a holder of this role (the
  /// owner's routing sheet, 2026-10-11 — a CEO's quotation needs nobody, a
  /// team leader's goes to the CEO). A role-specific route beats the general
  /// one (null); a preparer holding several gets the shortest — the senior
  /// role's. A route with NO steps approves on submit.
  requesterRoleId String?
  requesterRole   Role?   @relation("WorkflowRequesterRole", fields: [requesterRoleId], references: [id], onDelete: Restrict)

  /// The preparer SIGNS, at submit, every step whose role they hold (the
  /// owner's call, 2026-10-12: a Team Leader's own quotation, the CEO's own
  /// sales order, a Technical Manager's own costing) — dated the submit
  /// instant, the same as "Prepared by". Off by default: a leave request or an
  /// expense claim must never be signed by the HR or finance person who filed
  /// it. Seeded on the quotation, sales order and costing routes.
  preparerSigns Boolean @default(false)
  /// The manager ("Reports to") of a step's approver may decide it in their
  /// place — never listed, told or queued (the owner's call, 2026-10-12).
  standIns      Boolean @default(false)

  steps    ApprovalStep[]
  requests ApprovalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Who added it (2026-10-18): "Edit Own" on Admin › Roles reads it.
  createdById String?

  @@index([documentType, isActive])
}

model ApprovalStep {
  id           String           @id @default(cuid())
  workflowId   String
  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sequence     Int
  name         String
  approverType ApproverType

  roleId      String?
  role        Role?    @relation("StepRole", fields: [roleId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?    @relation("StepUser", fields: [userId], references: [id], onDelete: SetNull)
  /// On a SUPERVISOR step: holders of these roles on the requester's own team
  /// decide it too, beside the "Reports to" (2026-10-14, the borrow slip's
  /// "Team Leader / Technical Manager they report to or within the team").
  alsoRoleIds String[] @default([])

  actions ApprovalAction[]

  @@unique([workflowId, sequence])
}

model ApprovalRequest {
  id             String   @id @default(cuid())
  documentType   String
  documentId     String
  documentNumber String?
  subject        String
  amount         Decimal? @db.Decimal(18, 2)

  /// Deep link to the actual record — notifications must not land on a list
  /// screen (model §8).
  link String?

  requesterId String
  requester   User   @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)

  /// The project the document is about, when it is about one — what a
  /// PROJECT_MANAGER step resolves against. Set at submission; never a
  /// relation, because the engine knows no document.
  jobId            String?
  /// The project manager the DOCUMENT names itself (a job order's, before its
  /// project exists) — a PROJECT_MANAGER step reads this first, then the job's.
  projectManagerId String?

  workflowId String?
  workflow   ApprovalWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  currentSequence Int            @default(1)
  status          ApprovalStatus @default(PENDING)
  /// Pulled back to draft after it was APPROVED (2026-10-16, the owner's
  /// call: "every approval request can be pulled back, even fully approved"):
  /// the request closes CANCELLED with these set; its signatures are kept.
  reopenedAt      DateTime?
  reopenedById    String?
  reopenReason    String?
  /// An importation (2026-10-17, the owner's chart: Purchasing Manager Local
  /// and Importation are two people): a Purchasing Manager step on such a
  /// document goes to the Importation manager. Set at submit from the
  /// document (a purchase order or incoming report with no VAT).
  importation     Boolean        @default(false)

  actions   ApprovalAction[]
  followUps ApprovalFollowUp[]
  createdAt DateTime           @default(now())
  closedAt  DateTime?

  @@index([documentType, documentId])
  @@index([status])
  @@index([requesterId])
}

model ApprovalAction {
  id           String             @id @default(cuid())
  requestId    String
  request      ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepId       String?
  step         ApprovalStep?      @relation(fields: [stepId], references: [id], onDelete: SetNull)
  sequence     Int
  approverId   String
  approver     User               @relation("ApprovalActor", fields: [approverId], references: [id], onDelete: Cascade)
  action       ApprovalActionType
  comment      String?
  actedAt      DateTime           @default(now())
  /// Signed by the engine at submit: the requester holds this step's role and
  /// the route lets the preparer sign (`ApprovalWorkflow.preparerSigns`).
  /// Never pressed by anybody; dated the request's own instant.
  selfSigned   Boolean            @default(false)
  /// Signed by the engine with an approver's own Approve (2026-10-13, "one
  /// signature per person"): the approver may decide this later step in
  /// their own right too, so it is signed at the same instant. The sequence
  /// of the step whose Approve carried it; null for a step pressed.
  coSignedWith Int?
  /// A stand-in's decision: the approver of the step they decided in place of
  /// (their direct report). `approverId` is who really acted.
  onBehalfOfId String?
  onBehalfOf   User?              @relation("StoodInFor", fields: [onBehalfOfId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

/// The requester's follow-up to the managers of an absent approver
/// (2026-10-17, the owner's call): a stand-in is never listed or queued
/// until the requester asks — then the managers named here are told and see
/// the request in their queue. One row per follow-up; the step it was at.
model ApprovalFollowUp {
  id        String          @id @default(cuid())
  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sequence  Int
  byId      String
  by        User            @relation("FollowUpBy", fields: [byId], references: [id], onDelete: Cascade)
  /// The managers told — the "Reports to" of each approver of the step.
  toIds     String[]
  note      String?
  createdAt DateTime        @default(now())

  @@index([requestId])
}

// ════════════════════════════════════════════════════════════════════
//  CROSS-CUTTING SERVICES
// ════════════════════════════════════════════════════════════════════

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, isRead])
}

model Attachment {
  id           String    @id @default(cuid())
  entityType   String
  entityId     String
  fileName     String
  storedName   String
  mimeType     String
  size         Int
  /// Original capture time for report photos — evidence keeps its timestamp
  /// (model §2.10).
  capturedAt   DateTime?
  caption      String?
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  uploadedAt   DateTime  @default(now())

  @@index([entityType, entityId])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  summary    String?
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String?
  before     Json?
  after      Json?
  ip         String?
  at         DateTime @default(now())

  @@index([entityType, entityId])
  @@index([at])
}

// ════════════════════════════════════════════════════════════════════
//  MASTERS  (Phase 2)
//
//  "Information entered once should be reusable by downstream modules
//  without duplicate data entry." These records are global — Sales,
//  Projects, Procurement, Finance and Service all read the same rows.
// ════════════════════════════════════════════════════════════════════

model Customer {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String
  legalName     String?
  tin           String?
  /// The team (Industry: KAT, HIT, UIT, GIB, SIT) that handles the customer —
  /// open until somebody sets it (2026-10-09). Not a classification: the
  /// sub-industry is `subIndustryId`.
  industryId    String?
  industry      Industry?    @relation(fields: [industryId], references: [id], onDelete: Restrict)
  /// Where in the market the customer sits (2026-10-08, the owner's eleven:
  /// Enterprise, Hospital, Pharmaceutical …) — typed in by hand, optional.
  subIndustryId String?
  subIndustry   SubIndustry? @relation(fields: [subIndustryId], references: [id], onDelete: SetNull)
  /// Free text, e.g. "30 days", "50% down, balance on turnover".
  paymentTerms  String?
  creditLimit   Decimal?     @db.Decimal(18, 2)
  /// The customer's own address (2026-10-11, the owner's call): what a
  /// quotation prints by default. A site, where one is chosen on the
  /// quotation, prints instead.
  address       String?
  phone         String?
  email         String?
  website       String?
  notes         String?
  isActive      Boolean      @default(true)

  /// Who entered it. Supports the Mine/All switch on the list; customers
  /// themselves are shared data that anyone with access may edit.
  createdById String?
  createdBy   User?   @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: SetNull)

  contacts CustomerContact[]
  sites    CustomerSite[]

  leads          Lead[]
  costings       Costing[]
  quotations     Quotation[]
  activities     SalesActivity[]
  jobs           Job[]
  invoices       Invoice[]
  payments       Payment[]
  assets         InstalledAsset[]
  visits         ServiceVisit[]
  serviceReports ServiceReport[]
  jobOrders      JobOrder[]
  cadJobOrders   CadJobOrder[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  salesOrders        SalesOrder[]
  commissionRequests CommissionRequest[]

  @@index([isActive])
  @@index([name])
  @@index([industryId])
  @@index([subIndustryId])
}

/// "Sometimes they have multiple contact in a single customer."
model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  position   String?
  email      String?
  phone      String?
  mobile     String?
  isPrimary  Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sites       CustomerSite[]
  quotations  Quotation[]
  jobs        Job[]
  jobOrders   JobOrder[]
  salesOrders SalesOrder[]
  activities  SalesActivity[]

  @@index([customerId])
}

/// A delivery/works address. Projects and service contracts hang off a site,
/// not just a customer — one hospital group can have many plants.
model CustomerSite {
  id         String           @id @default(cuid())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  city       String?
  region     String?
  contactId  String?
  contact    CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  notes      String?
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  leads          Lead[]
  costings       Costing[]
  quotations     Quotation[]
  jobs           Job[]
  assets         InstalledAsset[]
  visits         ServiceVisit[]
  serviceReports ServiceReport[]
  jobOrders      JobOrder[]

  @@index([customerId])
}

/// The sales TEAMS (2026-10-08, the owner's five: KAT, HIT, UIT, GIB, SIT) —
/// a person's team is this row on their employee record (shared/team.ts).
/// Same shape as CostCategory: seeded, system rows undeletable, labels
/// editable. The first five rows (HI, BI, UI, GI, SI) classified customers
/// until the teams took them over; a customer is now classified by
/// SubIndustry, and `customers` only names the rows that still carry one.
model Industry {
  id                 String              @id @default(cuid())
  code               String              @unique // KAT, HIT, UIT, GIB, SIT — 2–4 uppercase letters
  name               String
  sortOrder          Int                 @default(0)
  isSystem           Boolean             @default(false)
  isActive           Boolean             @default(true)
  customers          Customer[]
  /// The people on this team (Employee.industryId).
  employees          Employee[]
  /// Quotations tagged with this team (the SCORO import, 2026-10-12).
  quotationsTagged   Quotation[]         @relation("QuotationTeam")
  invoicesCredited   Invoice[]           @relation("InvoiceTeam")
  supporters         UserSupportTeam[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  commissionRequests CommissionRequest[]
  invoiceRequests    InvoiceRequest[]
  jobOrders          JobOrder[]          @relation("JobOrderTeam")
  cadJobOrders       CadJobOrder[]       @relation("CadJobOrderTeam")
  posts              TeamPost[]
  // Who added it (2026-10-18): "Edit Own" on Admin › Roles reads it.
  createdById        String?
}

/// A customer's sub-industry (2026-10-08, the owner's eleven): Enterprise,
/// Hospital, Pharmaceutical, Power and Water, Laguna & Batangas Hubs, Cavite
/// Hubs, Manufacturing, Building, EPC, Infrastructure, Government. Same
/// contract as the cost categories — seeded system rows undeletable, names
/// editable — and OPTIONAL on the customer: typed in by hand, later.
model SubIndustry {
  id          String     @id @default(cuid())
  name        String     @unique
  sortOrder   Int        @default(0)
  isSystem    Boolean    @default(false)
  isActive    Boolean    @default(true)
  customers   Customer[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  // Who added it (2026-10-18): "Edit Own" on Admin › Roles reads it.
  createdById String?
}

model Supplier {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  legalName    String?
  tin          String?
  /// What they supply — steel, valves, electrical, subcontract labour…
  category     String?
  paymentTerms String?
  address      String?
  city         String?
  phone        String?
  email        String?
  website      String?
  notes        String?
  isActive     Boolean @default(true)

  /// A principal whose equipment Gruntech sells and services — surfaced in
  /// G-OPS › Sales › Partners. Still one supplier record.
  isPartner    Boolean           @default(false)
  brand        String?
  partnerSince DateTime?         @db.Date
  resources    PartnerResource[]

  createdById String?
  createdBy   User?   @relation("SupplierCreator", fields: [createdById], references: [id], onDelete: SetNull)

  contacts       SupplierContact[]
  preferredItems Item[]            @relation("PreferredSupplier")
  canvassEntries CanvassSupplier[]
  rfqEntries     RfqSupplier[]
  purchaseOrders PurchaseOrder[]
  bills          SupplierBill[]
  payments       Payment[]
  quoteLines     QuotationItem[]

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  salesOrderLines      SalesOrderLine[]
  costingLines         CostingLine[]
  receivedWithoutOrder Receiving[]      @relation("ReceivingFrom")

  @@index([isActive])
  @@index([name])
  @@index([isPartner])
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  position   String?
  email      String?
  phone      String?
  mobile     String?
  isPrimary  Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId])
}

enum PartnerResourceKind {
  CATALOGUE
  PRICE_LIST
  SIZING_APP
  /// One of the partner's other sites — a support portal, an e-shop, training,
  /// downloads. A url, never a file.
  LINK
  OTHER
}

/// A catalogue, price list, software or link a partner publishes. EITHER an uploaded
/// file (one Attachment with entityType 'partner_resource', entityId = this id)
/// OR an external URL, or both (a LINK is a url only). Files stay in the one
/// attachment service.
model PartnerResource {
  id          String              @id @default(cuid())
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  kind        PartnerResourceKind
  title       String
  description String?
  /// http(s) only — validated on write, opened in a new tab.
  url         String?
  validFrom   DateTime?           @db.Date
  validUntil  DateTime?           @db.Date
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  createdById String?
  createdBy   User?               @relation("PartnerResourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([supplierId, kind])
}

enum EmploymentType {
  REGULAR
  PROBATIONARY
  PROJECT_BASED
  CONTRACTUAL
  PART_TIME
  TRAINEE
}

/// The person. `User` is their login; not every employee needs one, and the
/// admin account is a User with no Employee record.
///
/// Reporting line deliberately lives on `User`, not here: the approval engine
/// routes by user, and two places to record "who approves for me" is one place
/// too many. An employee with no user account files nothing, so has no route.
model Employee {
  id         String  @id @default(cuid())
  /// Nullable since 2026-10-18: every number was cleared once for the owner's
  /// `GTC-0001-14` scheme, and a person without one is issued no `{EMP}` number.
  employeeNo String? @unique
  firstName  String
  lastName   String
  middleName String?
  suffix     String?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position     String?
  /// The plantilla slot. `position` (the string) is a MIRROR of positionRef.title,
  /// written only by setEmployeePosition() in shared/plantilla.ts; it stays free
  /// text only for an employee with no plantilla position (unclassified).
  positionId   String?
  positionRef  Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  /// Positions held beside the main one (2026-10-19: one person, two
  /// managers' posts). Each counts as filled; `position` joins the titles.
  extraPositions EmployeeExtraPosition[]
  /// The industry team the person works in (Utilities, Healthcare…), from the
  /// same Industry rows customers are classified by. Set by HR; shown to the
  /// person on their invitation and My Account, never edited by them.
  industryId   String?
  industry     Industry?   @relation(fields: [industryId], references: [id], onDelete: Restrict)

  employmentType  EmploymentType @default(REGULAR)
  dateHired       DateTime?      @db.Date
  dateRegularized DateTime?      @db.Date
  dateSeparated   DateTime?      @db.Date
  /// End of the current probationary or training period. PROBATIONARY defaults
  /// to dateHired + hr.rules.probationMonths when null; an EXTEND recommendation
  /// writes here. A TRAINEE has no statutory period, so the route requires it.
  periodEndDate   DateTime?      @db.Date

  mobile        String?
  personalEmail String?
  address       String?
  birthDate     DateTime? @db.Date

  emergencyContactName  String?
  emergencyContactPhone String?

  // ── Sensitive ──────────────────────────────────────────────────────────
  // Gated by ghr.employee_rates.view_all and stripped from audit entries.
  // Projects see labour as a burdened cost, never as a wage.
  dailyRate        Decimal? @db.Decimal(14, 2)
  /// Multiplier covering statutory contributions, leave accrual and overhead.
  /// Burdened cost = dailyRate × burdenMultiplier.
  burdenMultiplier Decimal? @db.Decimal(6, 3)
  sssNo            String?
  philhealthNo     String?
  pagibigNo        String?
  tin              String?

  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faces         FaceEnrollment[]
  greetings     Greeting[]
  attendance    Attendance[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  overtime      OvertimeRequest[]

  clearances          EmployeeClearance[]
  evaluations         EmployeeEvaluation[]
  trainingAttendances TrainingAttendee[]
  trainingRecords     TrainingRecord[]
  flowItems           EmployeeFlowItem[]

  @@index([isActive])
  @@index([lastName, firstName])
  @@index([positionId])
  @@index([industryId])
}

/// The five cost buckets every costing, budget and cost-ledger row uses
/// (model §5.1). Seeded, extensible, and the system ones cannot be deleted
/// because the ledger's shape depends on them.
model CostCategory {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  sortOrder Int     @default(0)
  isSystem  Boolean @default(false)
  isActive  Boolean @default(true)

  items          Item[]
  costingLines   CostingLine[]
  costEntries    JobCostEntry[]
  budgetRequests BudgetRequest[]
  prItems        PurchaseRequestItem[]
  poItems        PurchaseOrderItem[]
  issueItems     StockIssueItem[]
  overtime       OvertimeRequest[]
  supplierBills  SupplierBill[]        @relation("BillCategory")
  expenseClaims  ExpenseClaim[]        @relation("ExpenseCategory")
  cashAdvances   CashAdvance[]         @relation("AdvanceCategory")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Who added it (2026-10-18): "Edit Own" on Admin › Roles reads it.
  createdById String?
}

model ItemCategory {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  /// What it covers — the inventory's category tile says it under the name
  /// (2026-10-15: "UL/FM Fire, Booster, Submersible").
  description String?
  sortOrder   Int            @default(0)
  parentId    String?
  parent      ItemCategory?  @relation("ItemCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ItemCategory[] @relation("ItemCategoryTree")

  items Item[]
  /// The product group an incoming line files a NEW item under (2026-10-20).
  receivingLines ReceivingItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Who added it (2026-10-18): "Edit Own" on Admin › Roles reads it.
  createdById String?
}

enum ItemType {
  MATERIAL
  EQUIPMENT
  CONSUMABLE
  SERVICE
  TOOL
}

/// One item master, used by Costing (estimated), Procurement (ordered),
/// Inventory (stocked) and Job (consumed) — model §3.
model Item {
  id          String   @id @default(cuid())
  code        String   @unique
  partNumber  String?
  /// The manufacturer / OEM (2026-10-15, the owner's call: Pentair, Nidec,
  /// SUTO) — not who we buy from, which is `preferredSupplier`.
  brand       String?
  name        String
  description String?
  itemType    ItemType @default(MATERIAL)

  categoryId String?
  category   ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Which bucket this lands in when it reaches a job's cost ledger.
  costCategoryId String?
  costCategory   CostCategory? @relation(fields: [costCategoryId], references: [id], onDelete: SetNull)

  unit         String   @default("pcs")
  standardCost Decimal? @db.Decimal(18, 2)
  lastCost     Decimal? @db.Decimal(18, 2)

  /// The partner's published list price. A PRICE, not a cost: standardCost and
  /// lastCost stay behind gchain.items; this is what a salesperson may see.
  listPrice         Decimal?  @db.Decimal(18, 2)
  listPriceCurrency String?
  listPriceAsOf     DateTime? @db.Date

  /// Stocked items carry balances and reorder levels; a service or a one-off
  /// fabricated part does not.
  isStocked    Boolean  @default(true)
  minStock     Decimal? @db.Decimal(18, 3)
  reorderLevel Decimal? @db.Decimal(18, 3)

  preferredSupplierId String?
  preferredSupplier   Supplier? @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)

  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  costingLines         CostingLine[]
  prItems              PurchaseRequestItem[]
  poItems              PurchaseOrderItem[]
  issueItems           StockIssueItem[]
  borrowItems          BorrowSlipItem[]
  balances             InventoryBalance[]
  projectStock         ProjectStock[]
  pulloutItems         PulloutItem[]
  stockMoves           InventoryTransaction[]
  installedAssets      InstalledAsset[]
  /// Technical documents filed against the model (2026-10-20) — every machine of it reads them.
  serviceDocuments     ServiceDocument[]
  receivedWithoutOrder ReceivingItem[]        @relation("ReceivedWithoutOrder")

  // Who added it (2026-10-18): "Edit Own" on Admin › Roles reads it.
  createdById String?

  @@index([isActive])
  @@index([name])
  @@index([partNumber])
}

model Warehouse {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  address  String?
  city     String?
  isActive Boolean @default(true)

  locations Location[]

  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  receivings       Receiving[]
  stockIssues      StockIssue[]
  borrowSlips      BorrowSlip[]
  pulloutSlips     PulloutSlip[]
  balances         InventoryBalance[]
  projectStock     ProjectStock[]
  stockMoves       InventoryTransaction[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Who added it (2026-10-18): "Edit Own" on Admin › Roles reads it.
  createdById String?
}

/// Bin / rack / shelf within a warehouse.
model Location {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String
  name        String?
  isActive    Boolean   @default(true)

  receivingItems ReceivingItem[]
  issueItems     StockIssueItem[]
  balances       InventoryBalance[]
  projectStock   ProjectStock[]

  createdAt DateTime @default(now())

  // Who added it (2026-10-18): "Edit Own" on Admin › Roles reads it.
  createdById String?

  @@unique([warehouseId, code])
}

// ════════════════════════════════════════════════════════════════════
//  SALES  (Phase 3)
//
//  Lead → Costing → Quotation(rev) → approved → customer P.O. → Job.
//
//  There is deliberately no separate Opportunity entity. The requirements
//  treat the opportunity AS the lead until a quotation exists ("Sales
//  Pipeline — better view of opportunity (quotation) transitioning to
//  completed or awarded"), so the pipeline is a view over leads and
//  quotations rather than a third record to keep in step.
// ════════════════════════════════════════════════════════════════════

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT
  COSTING
  QUOTATION_CREATED
  QUOTATION_SUBMITTED
  NEGOTIATION
  WON
  LOST
  ON_HOLD
}

model Lead {
  id     String     @id @default(cuid())
  number String     @unique
  status LeadStatus @default(NEW)

  /// A lead often arrives before the customer is worth recording, so the
  /// company is free text until it is linked to a real Customer.
  companyName String
  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  siteId      String?
  site        CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  contactPerson String?
  contactEmail  String?
  contactPhone  String?

  /// Where the work is. Copied off the customer's site when there is one, and
  /// editable either way — a lead often names a site the customer record does
  /// not have yet, and losing it means ringing back to ask where to go.
  address String?

  source      String?
  description String?

  /// "I can assign it to other user account or sales for them to work out."
  assignedToId String
  assignedTo   User   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdById  String
  createdBy    User   @relation("LeadCreator", fields: [createdById], references: [id], onDelete: Restrict)

  estimatedValue  Decimal?  @db.Decimal(18, 2)
  /// Salesperson's own read on the chance of award, used for weighted pipeline.
  probability     Int       @default(0)
  expectedClosing DateTime? @db.Date

  nextAction     String?
  nextActionDate DateTime? @db.Date
  lostReason     String?
  /// LOST or CANCELLED while lost (2026-10-13); null otherwise.
  lostKind       LostKind?
  notes          String?

  quotations Quotation[]
  costings   Costing[]
  activities SalesActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([assignedToId])
}

// ── Costing ──────────────────────────────────────────────────────────────────

enum CostingStatus {
  DRAFT
  /// Submitted through the approval engine; locked until it is decided.
  PENDING_APPROVAL
  FINAL
}

/// Where the contract amount comes from, and the structural origin of both
/// the project budget and the billing breakdown (model §5.3).
model Costing {
  id     String        @id @default(cuid())
  number String        @unique
  title  String
  status CostingStatus @default(DRAFT)

  customerId String?
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  siteId     String?
  site       CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /// Record ownership — "View Category (My Costing, all Costing)".
  ownerId String
  owner   User   @relation("CostingOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  /// The gross margin on the contract value, as a fraction to six decimals
  /// (0.25 = 25%): contract value = project budgeted cost ÷ (1 − margin).
  /// Replaced the markup on 2026-10-09 (the owner's call).
  marginPct      Decimal @default(0) @db.Decimal(9, 6)
  /// LEGACY (before 2026-10-09): the markup on cost and the quote-level
  /// discount of the old rule, contract = cost + markup + contingency −
  /// discount. `migrateCostingMargins()` (the seed) folds them into the
  /// margin and zeroes them; nothing reads or writes them any more. Kept
  /// because `prisma db push` on the server would refuse to drop a column
  /// holding data.
  markupPct      Decimal @default(0) @db.Decimal(7, 4)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)

  /// Stored rather than derived: the contract value is a commercial fact that
  /// must not silently change when someone edits a cost line months later.
  contractValue       Decimal  @default(0) @db.Decimal(18, 2)
  totalCost           Decimal  @default(0) @db.Decimal(18, 2)
  /// A FIXED PRICE (2026-10-13, the owner's call): the contract value, net of
  /// VAT, as typed on the sheet's "Set the grand total". While set, `recalc()`
  /// writes `contractValue` = this exactly and `marginPct` = what it amounts to
  /// over the cost, so a line changed afterwards keeps the price and moves the
  /// margin. Null: priced from `marginPct`.
  targetContractValue Decimal? @db.Decimal(18, 2)

  durationDays Int?
  /// Internal notes — shown on the screen, never printed.
  notes        String?
  /// Terms & Conditions — printed on the cost estimate.
  terms        String?

  /// LEGACY (before 2026-10-09): contingency as a % of the cost. It is a
  /// cost LINE now, in the Contingency category (the sixth bucket); the seed's
  /// migration wrote one for each costing that carried a percentage.
  contingencyPct Decimal   @default(0) @db.Decimal(7, 4)
  /// VAT shown on the estimate's grand total: the company rate, or 0 for a
  /// zero-rated job. The contract value stays net of VAT, as it always was.
  vatRate        Decimal   @default(0.12) @db.Decimal(6, 4)
  /// The date the prices on the estimate stop holding.
  validUntil     DateTime? @db.Date
  /// The day the scope of work starts (2026-10-13). With it, the plan's
  /// finish is derived — `workingDayDate(plannedStart, planDays)`, Mon–Sat —
  /// and never stored, so a changed plan moves the finish with it.
  plannedStart   DateTime? @db.Date
  /// "System / Unit" — the plant or equipment the estimate is for.
  systemUnit     String?

  lines              CostingLine[]
  scopeSections      ScopeSection[]
  quotationRevisions QuotationRevision[]
  jobs               Job[]
  /// Where this costing is quoted or built as a second (third…) costing of a
  /// revision or a project (2026-10-19) — `costingId` names the first.
  revisionLinks      QuotationRevisionCosting[]
  jobLinks           JobCostingLink[]

  /// When it last became FINAL (approval, "Mark final", or a job built on
  /// it); cleared when reopened. The Costing page's "Final this month" tile.
  finalAt DateTime?

  /// "Assign costing" on a lead: who handed the work to the owner, when, and
  /// what they asked for. Null on a costing somebody started for themselves.
  assignedById   String?
  assignedBy     User?     @relation("CostingAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt     DateTime?
  assignmentNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([leadId])
}

/// One estimated cost, in one of the five buckets.
model CostingLine {
  id        String  @id @default(cuid())
  costingId String
  costing   Costing @relation(fields: [costingId], references: [id], onDelete: Cascade)

  costCategoryId String
  costCategory   CostCategory @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)

  /// Optional link to the item master — a fabricated one-off has no item.
  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  /// The short name, printed bold over the description. Null on a line that
  /// predates the sheet editor; its description then serves as the name.
  name         String?
  description  String
  /// A subheading inside its category: printed as a heading row, costs nothing.
  isHeading    Boolean   @default(false)
  quantity     Decimal   @default(1) @db.Decimal(18, 3)
  unit         String    @default("pcs")
  unitCost     Decimal   @default(0) @db.Decimal(18, 2)
  amount       Decimal   @default(0) @db.Decimal(18, 2)
  sortOrder    Int       @default(0)
  /// Who supplies it (2026-10-14): a supplier on file, else a name typed.
  /// Printed under the unit cost; carried to a PR as its preferred supplier.
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName String?
  /// A short note on the line, printed under the supplier.
  lineNote     String?

  @@index([costingId])
}

enum ScopeKind {
  MAIN_WORK
  TESTING_COMMISSIONING
  TURNOVER
  OTHER
}

/// Where a scope phase's value comes from (2026-10-13): spread from what the
/// others leave of the contract value, typed (declared) by hand, or the
/// named cost buckets' cost priced as the sheet prices it — `scheduleOfValues()`.
enum ScopeValueSource {
  SPREAD
  DECLARED
  CATEGORY
}

/// A scope-of-work section AND a Schedule of Values line — the same row.
///
/// That identity is the point (model §5.3): what you scoped is what you bill
/// against and what the S-curve is measured on. Keeping them as one record is
/// what stops the three drifting apart.
model ScopeSection {
  id        String  @id @default(cuid())
  costingId String
  costing   Costing @relation(fields: [costingId], references: [id], onDelete: Cascade)

  kind         ScopeKind @default(MAIN_WORK)
  name         String
  description  String?
  durationDays Int       @default(0)

  /// This section's share of the contract value. The sum across sections is
  /// validated against the costing's contract value.
  value           Decimal          @default(0) @db.Decimal(18, 2)
  /// Where `value` comes from (2026-10-13): SPREAD (the default, as before),
  /// DECLARED (typed, kept) or CATEGORY (`costCategoryIds`' cost, priced).
  valueSource     ScopeValueSource @default(SPREAD)
  /// CATEGORY: the cost buckets (CostCategory ids) this phase carries — the
  /// owner's "materials cost to purchasing of materials". A bucket on one
  /// phase at most.
  costCategoryIds String[]         @default([])

  sortOrder Int         @default(0)
  tasks     ScopeTask[]

  @@index([costingId])
}

model ScopeTask {
  id             String       @id @default(cuid())
  scopeSectionId String
  scopeSection   ScopeSection @relation(fields: [scopeSectionId], references: [id], onDelete: Cascade)
  name           String
  /// The working day (Mon–Fri, day 1 = the first) the task starts on.
  startDay       Int?
  durationDays   Int          @default(0)
  sortOrder      Int          @default(0)

  @@index([scopeSectionId])
}

/// A costing to start from: its lines, scope phases and tasks, and the terms,
/// kept as one document. Not a commercial record — nothing points at it, and
/// a costing started from one keeps no link back, so editing or deleting a
/// template never moves a costing already made from it.
model CostingTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// { systemUnit, marginPct, terms, lines[], sections[] } — lines name their
  /// category by CODE, which is permanent (isSystem rows). A template saved
  /// before 2026-10-09 carries `markupPct` (and a contingency %), read as the
  /// margin it amounts to; the contingency is a Contingency line since.
  body        Json
  /// With prices, or quantities and names only.
  withPrices  Boolean  @default(true)
  createdById String
  createdBy   User     @relation("CostingTemplateAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

// ── Quotations ───────────────────────────────────────────────────────────────

enum RevisionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
}

enum QuotationOutcome {
  OPEN
  SUBMITTED
  NEGOTIATION
  WON
  LOST
  /// Put on hold (2026-10-13, the owner's call): not open — no forecast, no
  /// open counts — and resumed by moving it back to an open stage.
  ON_HOLD
}

/// What a LOST lead or quotation was (2026-10-13): lost to a competitor or a
/// no, or CANCELLED — the customer dropped the requirement. Cancelled counts
/// as neither won nor lost in a win rate. Null unless the record is LOST.
enum LostKind {
  LOST
  CANCELLED
}

/// The container. Commercial content lives on its revisions, which are never
/// overwritten — "preserve quotation revisions rather than overwriting
/// important commercial records" (model §2.5).
model Quotation {
  id     String @id @default(cuid())
  number String @unique

  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contactId  String?
  contact    CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  siteId     String?
  site       CustomerSite?    @relation(fields: [siteId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  /// "Only the author can edit the quotations" — super admin excepted.
  ownerId String
  owner   User   @relation("QuotationOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  subject String
  outcome QuotationOutcome @default(OPEN)

  /// Salesperson's percentage to award, for the pipeline.
  probability Int @default(50)

  submittedAt     DateTime?
  decidedAt       DateTime?
  lostReason      String?
  /// LOST or CANCELLED while lost (2026-10-13); null otherwise.
  lostKind        LostKind?
  /// When the salesperson expects the decision. Copied from the lead when the
  /// quotation is raised from one; editable on the quotation. The board's
  /// forecast column reads this, so a quotation with no lead can still be forecast.
  expectedClosing DateTime? @db.Date
  /// The currency every figure of every revision is in (2026-10-11, the
  /// owner's call: "interchangeable, by default PHP"). One of
  /// QUOTATION_CURRENCIES; its sales orders print in it too.
  currency        String    @default("PHP")
  /// Pesos per one unit of `currency` (2026-10-17, the owner's call): null
  /// for a PHP quotation. Filled from Settings' rate when the quotation is
  /// saved and changeable on it; every summary that ADDS quotations converts
  /// through it (`inBase()` in shared/exchangeRates.ts) — nothing on the
  /// quotation's own page or paper is converted.
  exchangeRate    Decimal?  @db.Decimal(14, 6)
  /// The team a quotation is counted under when somebody tagged it (the
  /// SCORO import's "Tag with team", 2026-10-12); null follows the owner's
  /// team — `quotationTeamWhere()` / `quotationTeamOf()` in shared/team.ts.
  teamId          String?
  team            Industry? @relation("QuotationTeam", fields: [teamId], references: [id], onDelete: SetNull)

  revisions    QuotationRevision[]
  activities   SalesActivity[]
  jobOrders    JobOrder[]
  cadJobOrders CadJobOrder[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  salesOrders SalesOrder[]

  @@index([customerId])
  @@index([ownerId])
  @@index([outcome])
  @@index([teamId])
}

model QuotationRevision {
  id          String         @id @default(cuid())
  quotationId String
  quotation   Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revision    Int            @default(0)
  status      RevisionStatus @default(DRAFT)

  costingId String?
  costing   Costing? @relation(fields: [costingId], references: [id], onDelete: SetNull)

  validityDays Int     @default(30)
  terms        String?
  notes        String?

  /// Sum of line amounts BEFORE discount. The arithmetic, in order:
  ///   net       = subtotal - discountAmount
  ///   vatAmount = net x vatRate        (on the discounted figure)
  ///   total     = net + vatAmount
  subtotal       Decimal @default(0) @db.Decimal(18, 2)
  /// Quote-level discount, as SCORO carried it. discountAmount is stored, not
  /// re-derived on read, so a printed revision cannot drift by a centavo.
  discountPct    Decimal @default(0) @db.Decimal(9, 6)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  vatAmount      Decimal @default(0) @db.Decimal(18, 2)
  total          Decimal @default(0) @db.Decimal(18, 2)

  /// The customer's purchase-request reference, printed as "PR Number :".
  prNumber          String?
  /// Delivery lead time / terms, printed as "Delivery:".
  delivery          String?
  /// Printed as "Payment Terms :".
  paymentTerms      String?
  /// Snapshot of the rate used, so an old revision still prints the tax it was
  /// issued with after Settings change.
  vatRate           Decimal @default(0.12) @db.Decimal(6, 4)
  vatInclusive      Boolean @default(false)
  /// SCORO's "Hide total": the PDF prints the lines and their prices but no
  /// totals — a rate sheet, where the customer picks lines rather than buying
  /// the lot. The stored totals are still computed; only the paper omits them.
  hideTotal         Boolean @default(false)
  /// A revision brought in by the SCORO import and not changed since
  /// (2026-10-11, the owner's call): it needs no approval — the paper prints
  /// Prepared by alone, the page offers no route and Won is open to it — until
  /// somebody saves a change to it from Modify, which clears this for good.
  importedUnchanged Boolean @default(false)

  approvedById String?
  approvedBy   User?     @relation("RevisionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  items         QuotationItem[]
  jobs          Job[]
  /// The other costings this revision is quoted from — see QuotationRevisionCosting.
  otherCostings QuotationRevisionCosting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quotationId, revision])
  @@index([status])
}

/// SCORO's "Create invoice" under its real name here: the SALES ORDER that
/// books a quotation's work in Gruntech operations (2026-10-07). Raised FROM
/// a quotation — all of it, chosen lines, or one summarised line — numbered
/// `4622`, then `4622.1`, `4622.2` for later orders on the same quotation
/// (progress booking). An internal document: its PDF prints cost and margin
/// to those who may see cost, and it never goes to the customer.
model SalesOrder {
  id     String           @id @default(cuid())
  number String           @unique
  status SalesOrderStatus @default(DRAFT)

  quotationId String
  quotation   Quotation        @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  contactId   String?
  contact     CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// Record ownership — the author; "only the author can edit" as on quotations.
  ownerId String
  owner   User   @relation("SalesOrderOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  orderDate     DateTime @db.Date
  /// "Payment Terms : 30" on the paper.
  termsDays     Int      @default(30)
  paymentMethod String?
  referenceNo   String?
  /// The customer's PO this order books against.
  poNumber      String?
  /// Notes, printed on the order.
  comment       String?
  /// Released by: the sales invoice / billing statement and delivery receipt
  /// numbers, filled in when the release happens.
  siNumber      String?
  drNumber      String?
  /// Why a cancelled order was cancelled.
  cancelReason  String?

  /// Same arithmetic as a quotation revision (shared/quotation.ts): subtotal
  /// pre-discount, VAT on the net, totals stored by recalc only.
  discountPct    Decimal @default(0) @db.Decimal(9, 6)
  vatRate        Decimal @default(0.12) @db.Decimal(6, 4)
  vatInclusive   Boolean @default(false)
  subtotal       Decimal @default(0) @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  vatAmount      Decimal @default(0) @db.Decimal(18, 2)
  total          Decimal @default(0) @db.Decimal(18, 2)

  lines        SalesOrderLine[]
  jobOrders    JobOrder[]
  pulloutSlips PulloutSlip[]
  invoices     Invoice[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  commissionRequests CommissionRequest[]
  invoiceRequests    InvoiceRequest[]

  @@index([quotationId])
  @@index([customerId])
  @@index([ownerId])
  @@index([status])
}

enum SalesOrderStatus {
  DRAFT
  PENDING_APPROVAL
  ISSUED
  CANCELLED
}

/// A sales-order line — the same shape a quotation line has, cost and all.
model SalesOrderLine {
  id      String     @id @default(cuid())
  orderId String
  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  group       String?
  /// The quotation line's three boxes, copied at booking; `title` is their sentence (see QuotationItem).
  title       String?
  brand       String?
  productType String?
  partNumber  String?
  description String  @default("")
  isHeading   Boolean @default(false)
  quantity    Decimal @default(1) @db.Decimal(18, 3)
  unit        String  @default("lot")
  unitPrice   Decimal @default(0) @db.Decimal(18, 2)
  amount      Decimal @default(0) @db.Decimal(18, 2)
  sortOrder   Int     @default(0)

  /// INTERNAL, stripped for callers who may not see cost — the quotation rule.
  unitCost           Decimal?  @db.Decimal(18, 2)
  costAmount         Decimal?  @db.Decimal(18, 2)
  providerSupplierId String?
  providerSupplier   Supplier? @relation(fields: [providerSupplierId], references: [id], onDelete: SetNull)
  providerUserId     String?
  providerUser       User?     @relation("SoLineProvider", fields: [providerUserId], references: [id], onDelete: SetNull)
  costNote           String?

  /// The quotation line this books (progress booking: what is left of a line
  /// is its quantity less every live order's lines pointing at it).
  quotationItemId String?
  quotationItem   QuotationItem? @relation(fields: [quotationItemId], references: [id], onDelete: SetNull)
  /// A summarised line books several quotation lines: [{ quotationItemId, quantity }].
  bookedItems     Json?

  @@index([orderId])
  @@index([quotationItemId])
}

model QuotationItem {
  id         String            @id @default(cuid())
  revisionId String
  revision   QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  /// SCORO's line group, e.g. "Gruntech Installation", "Gruntech Services".
  group       String?
  /// Product name, printed in bold above the description. Since 2026-10-08 the
  /// sentence of the three boxes under it — "SCHNEIDER ELECTRIC, CIRCUIT
  /// BREAKER, EZC100H3030", empty parts left out (`productTitle()`) — or, on a
  /// line typed before them, the title as typed.
  title       String?
  brand       String?
  productType String?
  partNumber  String?
  description String
  /// A subheading over the lines below it: its title is the heading, it has no
  /// quantity or price, and it prints as a heading row.
  isHeading   Boolean @default(false)
  quantity    Decimal @default(1) @db.Decimal(18, 3)
  unit        String  @default("lot")
  unitPrice   Decimal @default(0) @db.Decimal(18, 2)
  amount      Decimal @default(0) @db.Decimal(18, 2)
  sortOrder   Int     @default(0)

  /// INTERNAL. Cost and margin never print on the customer PDF and are stripped
  /// server-side from responses for callers who may not see them.
  /// costAmount = quantity x unitCost, stored.
  unitCost           Decimal?         @db.Decimal(18, 2)
  costAmount         Decimal?         @db.Decimal(18, 2)
  /// Who carries the cost: a supplier (outsourced) OR an in-house person.
  /// Margin splits in-house vs outsourced by which of the two is set.
  providerSupplierId String?
  providerSupplier   Supplier?        @relation(fields: [providerSupplierId], references: [id], onDelete: SetNull)
  providerUserId     String?
  providerUser       User?            @relation("QuoteLineProvider", fields: [providerUserId], references: [id], onDelete: SetNull)
  costNote           String?
  salesOrderLines    SalesOrderLine[]

  @@index([revisionId])
  @@index([providerSupplierId])
  @@index([providerUserId])
}

// ── Quotation groups ─────────────────────────────────────────────────────────

/// The groups a quotation line is filed under ("Gruntech Installation",
/// "Trading") — SCORO's Group column. A line keeps its group as TEXT
/// (`QuotationItem.group`), so this is the list the editor suggests from and
/// Sales Analytics' "By group" names, not a reference a line points at. Every
/// group a saved line uses is added here (`rememberGroups`). Admin › Categories.
model QuotationGroup {
  id          String   @id @default(cuid())
  name        String
  /// What the group covers — "Compressed Air & Gas Treatment and Separation" —
  /// the dropdown's hint under the name (2026-10-08).
  description String?
  /// The brand a line filed under it carries: pre-filled into the line's Brand
  /// box when that is empty. None for a house group (GRUNTECHNOLOGY, OTHERS).
  brand       String?
  /// The name trimmed and lower-cased: one group per spelling, case-blind.
  key         String   @unique
  sortOrder   Int      @default(0)
  /// Inactive: no longer suggested. Lines already filed under it keep it.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Who added it (2026-10-18): "Edit Own" on Admin › Roles reads it.
  createdById String?
}

// ── Sales calendar ───────────────────────────────────────────────────────────

enum ActivityType {
  CALL
  SITE_VISIT
  MEETING
  FOLLOW_UP
  SUBMISSION
  OTHER
}

enum ActivityStatus {
  PLANNED
  DONE
  CANCELLED
}

/// "One look at what all the sales personnel are going to do by day."
/// A greeting sent (2026-10-08): the claim that makes a birthday or work
/// anniversary greeting go once per person per year — the API's minute timer
/// creates the row before anyone is told, and a second process loses the race
/// on the unique key. Never a list anybody reads; `shared/celebrations.ts`.
model Greeting {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// BIRTHDAY or ANNIVERSARY.
  kind       String
  year       Int
  sentAt     DateTime @default(now())

  @@unique([employeeId, kind, year])
}

/// An activity type as data (2026-10-08, SCORO's customisable activity types):
/// Admin › Categories › Activity types. The six built-ins are seeded with the
/// enum's own keys, so every activity written before this maps 1:1.
model SalesActivityType {
  id          String   @id @default(cuid())
  /// CALL, SITE_VISIT … or a key derived from a typed name (DEMO_WALK). Never changes.
  key         String   @unique
  name        String
  /// #RRGGBB, the chip's edge on the calendar; null takes the default.
  color       String?
  sortOrder   Int      @default(0)
  /// The six built-ins: renamed and recoloured freely, never deleted; OTHER is the fallback and stays active.
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Who added it (2026-10-18): "Edit Own" on Admin › Roles reads it.
  createdById String?
}

model SalesActivity {
  id       String         @id @default(cuid())
  /// The built-in kind, kept for the rows written before types became data;
  /// OTHER for a custom type. `typeKey` is what is read.
  type     ActivityType   @default(FOLLOW_UP)
  /// SalesActivityType.key — set on every write since 2026-10-08 and backfilled
  /// from `type` by the seed; read as `typeKey ?? type`.
  typeKey  String?
  status   ActivityStatus @default(PLANNED)
  subject  String
  notes    String?
  location String?

  assignedToId String
  assignedTo   User   @relation("ActivityAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)

  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  startsAt        DateTime
  /// Stored; the form asks for Starts and Ends and the API derives this from
  /// them (`endsAt` = startsAt + durationMinutes in every response).
  durationMinutes Int       @default(60)
  completedAt     DateTime?

  /// SCORO's "All day" (2026-10-08): `startsAt` is the day's Manila midnight
  /// and the duration whole days; the calendar draws it in the all-day row.
  allDay    Boolean @default(false)
  /// SCORO's "Personal": only the people on it — booked for it, invited, or
  /// the one who booked it — see what it is; everyone else's calendar shows
  /// "Busy" for the time (`maskPrivate` in shared/activities.ts).
  isPrivate Boolean @default(false)
  /// Conference call link, http(s) only (`safeHttpUrl`).
  callLink  String?
  /// A Google Maps link for the address (2026-10-13), http(s) only — the
  /// meeting's rule; with none the page searches Google Maps for the address.
  mapUrl    String?

  /// The customer's contact person it is with — one of the customer's contacts.
  contactId String?
  contact   CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// The project it is for.
  jobId     String?
  job       Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)

  /// Who booked it (null on rows written before 2026-10-08).
  createdById String?
  createdBy   User?   @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// A repeating booking (SCORO's "Recurring"): every occurrence is an
  /// ordinary activity carrying the FIRST one's id, so one can be moved on
  /// its own and the rest removed together (`DELETE /activities/:id?series=upcoming`).
  seriesId String?

  /// Minutes before `startsAt` to remind the assignee and invitees: null (none),
  /// 15, 60, 120 or 1440. Sent by the API's once-a-minute timer
  /// (`sendDueReminders` in shared/activities.ts).
  reminderMinutes Int?
  /// Set when the reminder went out — claimed with a conditional update so it
  /// is sent once. Cleared when the time or the reminder changes.
  reminderSentAt  DateTime?

  invitees SalesActivityInvitee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToId, startsAt])
  @@index([startsAt])
  @@index([seriesId])
}

/// Someone else asked along to a sales activity: told on save, reminded with
/// the assignee, and shown the activity on their calendar and in My Work.
model SalesActivityInvitee {
  id          String          @id @default(cuid())
  activityId  String
  activity    SalesActivity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// When they were told they are invited (null until the save that told them).
  notifiedAt  DateTime?
  /// Going (ACCEPTED), Maybe (TENTATIVE), Not going (DECLINED) or No reply
  /// (PENDING) — the invitee's own answer (2026-10-08, SCORO's visual
  /// confirmation), kept with when it was given. Only they can set it.
  response    InviteeResponse @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime        @default(now())

  @@unique([activityId, userId])
  @@index([userId])
}

// ════════════════════════════════════════════════════════════════════
//  DELIVERY  (Phase 4)
//
//  Job → Budget → Execution → Progress → Billing.
//
//  One JOB carries both kinds of work (model §3). A service contract is a
//  job with a different type, not a parallel set of tables, because both
//  consume the same people and materials and must post to the same ledger.
// ════════════════════════════════════════════════════════════════════

enum JobType {
  PROJECT
  SERVICE_CONTRACT
}

enum JobStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  TURNED_OVER
  CANCELLED
}

model Job {
  id     String    @id @default(cuid())
  number String    @unique
  type   JobType   @default(PROJECT)
  status JobStatus @default(PLANNING)
  name   String

  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  siteId     String?
  site       CustomerSite?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  contactId  String?
  contact    CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// A job cannot exist without an approved costing (model §10 invariants) —
  /// that is where its budget and its schedule of values come from.
  costingId String
  costing   Costing @relation(fields: [costingId], references: [id], onDelete: Restrict)

  quotationRevisionId String?
  quotationRevision   QuotationRevision? @relation(fields: [quotationRevisionId], references: [id], onDelete: SetNull)

  projectManagerId String?
  projectManager   User?   @relation("JobManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  createdById      String
  createdBy        User    @relation("JobCreator", fields: [createdById], references: [id], onDelete: Restrict)

  contractValue    Decimal   @db.Decimal(18, 2)
  customerPoNumber String?
  customerPoDate   DateTime? @db.Date
  contractDate     DateTime? @db.Date

  startDate     DateTime? @db.Date
  targetEndDate DateTime? @db.Date
  actualEndDate DateTime? @db.Date

  /// Reserved for §5.4. Null means the behaviour is off, which is the decision
  /// taken for now — the columns exist so switching either on later is a
  /// settings change rather than a migration of historical billings.
  downpaymentPct Decimal? @db.Decimal(6, 4)
  retentionPct   Decimal? @db.Decimal(6, 4)

  notes String?

  scopeItems      JobScopeItem[]
  /// The other costings the project was built from — see JobCostingLink.
  otherCostings   JobCostingLink[]
  costEntries     JobCostEntry[]
  budgetRequests  BudgetRequest[]
  progressReports ProgressReport[]
  billings        ProgressBilling[]
  plans           ApprovedPlan[]
  tasks           JobTask[]
  meetings        Meeting[]

  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  stockIssues      StockIssue[]
  pulloutSlips     PulloutSlip[]
  borrowSlips      BorrowSlip[]
  overtime         OvertimeRequest[]
  invoices         Invoice[]
  supplierBills    SupplierBill[]
  expenseClaims    ExpenseClaim[]
  cashAdvances     CashAdvance[]
  installedAssets  InstalledAsset[]  @relation("AssetInstaller")
  serviceContract  ServiceContract?
  serviceReports   ServiceReport[]   @relation("ServiceReportJob")
  jobOrders        JobOrder[]        @relation("JobOrderChargeTo")
  salesActivities  SalesActivity[]
  cadJobOrders     CadJobOrder[]

  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  commissionRequests CommissionRequest[]
  invoiceRequests    InvoiceRequest[]
  /// Goods bought for the project and received into a warehouse (2026-10-18).
  projectStock       ProjectStock[]
  projectStockMoves  InventoryTransaction[] @relation("ProjectStockMoves")

  @@index([status])
  @@index([customerId])
  @@index([projectManagerId])
}

/// The job's Schedule of Values — a SNAPSHOT of the costing's scope sections.
///
/// Snapshotted, not referenced, on purpose. A costing can be reopened and
/// edited; if progress were measured against live costing rows, every reported
/// percentage would silently shift underneath the reports that recorded it.
model JobScopeItem {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// Where it came from, for traceability. Nulled if the costing section goes.
  sourceSectionId String?

  kind         ScopeKind @default(MAIN_WORK)
  name         String
  description  String?
  value        Decimal   @db.Decimal(18, 2)
  durationDays Int       @default(0)

  /// Scheduled sequentially from the job start date at creation, then editable.
  /// These drive the PLANNED curve.
  plannedStart DateTime? @db.Date
  plannedEnd   DateTime? @db.Date

  sortOrder Int @default(0)

  progressLines ProgressReportLine[]
  billingLines  ProgressBillingLine[]
  tasks         JobTask[]

  @@index([jobId])
}

/// The four states money moves through (model §5.1).
///
/// BUDGETED   what we are allowed to spend  (costing + approved budget requests)
/// COMMITTED  what we have promised         (approved PR → issued PO, Phase 5)
/// INCURRED   what we now owe               (receiving, overtime, Phases 5–6)
/// CONSUMED   what is actually in the work  (stock issuance, Phase 5)
enum CostState {
  BUDGETED
  COMMITTED
  INCURRED
  CONSUMED
}

/// The single job cost ledger. There is no other way cost reaches a job, and
/// Budget Monitoring is a view over this table rather than a second set of
/// numbers that can disagree with it.
model JobCostEntry {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  costCategoryId String
  costCategory   CostCategory @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)

  state  CostState
  amount Decimal   @db.Decimal(18, 2)

  /// Every row names the document it came from — model §10 invariants.
  sourceType   String
  sourceId     String?
  sourceNumber String?
  description  String?

  occurredAt  DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([jobId, state])
  @@index([jobId, costCategoryId])
  @@index([sourceType, sourceId])
}

enum RequestStatus {
  DRAFT
  PENDING_APPROVAL
  /// Approved; finance has not yet handed the cash over.
  APPROVED
  /// Cash handed over; waiting for the liquidation.
  RELEASED
  /// Liquidation approved and the team still holds unspent cash.
  REFUND_DUE
  /// Liquidation approved and nothing is owed either way.
  LIQUIDATED
  REJECTED
  CANCELLED
}

/// A Budget Request asks for PROJECT CASH (§5.2, 2026-10-07): a sum against a
/// project and budget line, allowed by the project manager, approved and
/// released by finance, spent by the team and accounted for with receipts in
/// an ExpenseClaim that names it. Nothing reaches the project's ledger on
/// approval or release — the liquidation posts INCURRED at what was spent.
/// It no longer changes the budget. Every figure below is re-derived by
/// refreshBudgetRequest() from the payment allocations and the approved
/// liquidation; nothing increments them.
model BudgetRequest {
  id     String        @id @default(cuid())
  number String        @unique
  status RequestStatus @default(DRAFT)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  costCategoryId String
  costCategory   CostCategory @relation(fields: [costCategoryId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(18, 2)
  /// What the cash is for.
  reason String
  notes  String?

  requestedById String
  requestedBy   User   @relation("BudgetRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  neededBy DateTime? @db.Date

  /// Re-derived: Σ DISBURSEMENT allocations. 0 or amount — released in one voucher.
  amountReleased Decimal @default(0) @db.Decimal(18, 2)
  /// Re-derived: the approved liquidation's total, else 0.
  amountSpent    Decimal @default(0) @db.Decimal(18, 2)
  /// Re-derived: Σ RECEIPT allocations (unspent cash returned).
  amountRefunded Decimal @default(0) @db.Decimal(18, 2)

  /// releasedAt + finance.rules.budgetRequestLiquidationDays, snapshotted at release.
  liquidationDueDate DateTime? @db.Date
  releasedAt         DateTime? @db.Date
  liquidatedAt       DateTime?
  cancelReason       String?

  liquidations ExpenseClaim[]
  allocations  PaymentAllocation[]
  /// The breakdown of what the cash buys (2026-10-19, the owner's call: a full
  /// form). When there are lines, `amount` is their sum; one budget line still
  /// covers the whole request, so the liquidation rule is unchanged.
  items        BudgetRequestItem[]

  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([jobId, status])
  @@index([requestedById, status])
  @@index([status])
}

/// One line of a budget request's breakdown — what the cash buys.
model BudgetRequestItem {
  id          String        @id @default(cuid())
  requestId   String
  request     BudgetRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sortOrder   Int           @default(0)
  name        String
  description String?
  quantity    Decimal       @db.Decimal(18, 3)
  unit        String        @default("pcs")
  unitCost    Decimal       @db.Decimal(18, 2)
  amount      Decimal       @db.Decimal(18, 2)

  @@index([requestId])
}

enum ProgressStatus {
  DRAFT
  /// Never written since 2026-10-15; the seed moves any left to DRAFT.
  SUBMITTED
  /// With its approvers on the engine's route (2026-10-15).
  PENDING_APPROVAL
  APPROVED
}

/// "Progress Reports are arranged base on time of generation, all linked so
/// that we can monitor the status from 1st Progress report till last."
model ProgressReport {
  id       String         @id @default(cuid())
  number   String         @unique
  reportNo Int
  status   ProgressStatus @default(DRAFT)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// The chain back to the previous report.
  previousReportId String?         @unique
  previousReport   ProgressReport? @relation("ReportChain", fields: [previousReportId], references: [id], onDelete: SetNull)
  nextReport       ProgressReport? @relation("ReportChain")

  periodFrom DateTime @db.Date
  periodTo   DateTime @db.Date

  weather        String?
  manpower       String?
  equipment      String?
  /// The Accomplishment Report's SUMMARY (2026-10-15, the owner's sample).
  accomplishment String?
  issues         String?
  /// The Accomplishment Report's REMAINING WORKS, one per line.
  nextPeriodPlan String?

  /// KEY MILESTONES ACHIEVED, one per line — "Title: what was done".
  milestones        String?
  /// One of PROGRESS_OVERALL (shared/progressReport.ts), else free text.
  overallStatus     String?
  /// The words after it — "For Corrective Works".
  overallStatusNote String?
  /// PERSONNEL PRESENT: the project in charge and the project support, by
  /// name (an employee may have no login).
  personnelInCharge String?
  personnelSupport  String[]            @default([])
  /// The number the report carried before project-scoped numbering
  /// (2026-10-15), kept for anyone holding the old paper.
  legacyNumber      String?
  days              ProgressReportDay[]

  preparedById String
  preparedBy   User      @relation("ReportPreparer", fields: [preparedById], references: [id], onDelete: Restrict)
  approvedById String?
  approvedBy   User?     @relation("ReportApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  lines   ProgressReportLine[]
  billing ProgressBilling?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, reportNo])
  @@index([jobId])
}

/// One day of an Accomplishment Report (2026-10-15, the owner's sample):
/// the actions done that day, in order, its findings, recommendation and
/// remarks, and its pictures (attachments on `progress_report_day`).
model ProgressReportDay {
  id       String         @id @default(cuid())
  reportId String
  report   ProgressReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  workDate       DateTime @db.Date
  /// The actions, one per line, printed numbered.
  actions        String
  findings       String?
  recommendation String?
  remarks        String?
  /// How many people were on site that day.
  headcount      Int?
  sortOrder      Int      @default(0)

  @@index([reportId])
}

model ProgressReportLine {
  id       String         @id @default(cuid())
  reportId String
  report   ProgressReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  scopeItemId String
  scopeItem   JobScopeItem @relation(fields: [scopeItemId], references: [id], onDelete: Cascade)

  /// Percentages, 0–100. `previousPct` is carried from the prior report so a
  /// report reads as a period statement rather than a running total.
  previousPct   Decimal @default(0) @db.Decimal(7, 4)
  thisPeriodPct Decimal @default(0) @db.Decimal(7, 4)
  toDatePct     Decimal @default(0) @db.Decimal(7, 4)

  remarks String?

  @@unique([reportId, scopeItemId])
}

enum BillingStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  INVOICED
}

/// Generated from a progress report against the Schedule of Values — never
/// keyed independently (model §4.2).
model ProgressBilling {
  id           String        @id @default(cuid())
  number       String        @unique
  billingNo    Int
  /// The number before project-scoped numbering (2026-10-15).
  legacyNumber String?
  /// Who raised it — the requester on its approval route (2026-10-15).
  preparedById String?
  preparedBy   User?         @relation("BillingPreparer", fields: [preparedById], references: [id], onDelete: SetNull)
  status       BillingStatus @default(DRAFT)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  progressReportId String         @unique
  progressReport   ProgressReport @relation(fields: [progressReportId], references: [id], onDelete: Restrict)

  billingDate DateTime @default(now()) @db.Date

  /// Σ (scope value × percentage billed this period).
  grossAmount Decimal @db.Decimal(18, 2)

  /// Reserved for §5.4. Null while the behaviour is off.
  downpaymentRecouped Decimal? @db.Decimal(18, 2)
  retentionWithheld   Decimal? @db.Decimal(18, 2)

  /// Rates snapshotted so an old billing still prints the tax it was issued
  /// with after Settings change.
  vatRate   Decimal @default(0.12) @db.Decimal(6, 4)
  vatAmount Decimal @db.Decimal(18, 2)
  ewtRate   Decimal @default(0.02) @db.Decimal(6, 4)
  /// Withheld at source by the customer — reduces cash, not the amount owed.
  ewtAmount Decimal @db.Decimal(18, 2)

  invoiceTotal   Decimal @db.Decimal(18, 2)
  netCollectible Decimal @db.Decimal(18, 2)

  notes      String?
  approvedAt DateTime?

  lines   ProgressBillingLine[]
  invoice Invoice?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  /// The invoice requests raised on it (2026-10-15) — at most one live.
  invoiceRequests InvoiceRequest[]

  @@unique([jobId, billingNo])
  @@index([jobId, status])
}

model ProgressBillingLine {
  id        String          @id @default(cuid())
  billingId String
  billing   ProgressBilling @relation(fields: [billingId], references: [id], onDelete: Cascade)

  scopeItemId String
  scopeItem   JobScopeItem @relation(fields: [scopeItemId], references: [id], onDelete: Cascade)

  scopeValue       Decimal @db.Decimal(18, 2)
  previousPct      Decimal @db.Decimal(7, 4)
  toDatePct        Decimal @db.Decimal(7, 4)
  previousAmount   Decimal @db.Decimal(18, 2)
  thisPeriodAmount Decimal @db.Decimal(18, 2)

  @@unique([billingId, scopeItemId])
}

enum PlanStatus {
  /// Being prepared; Submit for approval routes it (2026-10-13).
  DRAFT
  PENDING_APPROVAL
  APPROVED
  /// A later request on the same drawing reference was approved.
  SUPERSEDED
  /// Before 2026-10-13 only (a plan registered and approved by hand); the
  /// seed moves any left to DRAFT.
  FOR_APPROVAL
  REJECTED
  CANCELLED
}

/// The REQUEST FOR APPROVAL (2026-10-13, the owner's call: "replace the
/// Approved Plans with Request for Approval … Internal Approval (Technical
/// Manager, Team Leader and CEO more than 1 million) … Drawing Reference
/// Number (it could come from a CAD J.O.)"). The table keeps its old name and
/// keys (`gops.plans.*`); it is a routed document now — submitted through
/// `shared/approvals.ts` as `plan_approval`, never approved by hand.
/// "Work should not start on an unapproved plan" (model §4.2).
model ApprovedPlan {
  id           String     @id @default(cuid())
  /// RFA number (`nextNumber('plan_approval')`); null on a plan registered
  /// before 2026-10-13 until it is submitted. Indexed, not @unique: adding a
  /// unique constraint to an existing table makes `prisma db push` stop for
  /// confirmation, and the server's deploy runs it unattended — nextNumber
  /// never issues a number twice.
  number       String?
  jobId        String
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title        String
  /// What is asked to be approved.
  description  String?
  /// The drawing reference number — typed, or a CAD J.O.'s number and revision.
  drawingNo    String?
  revision     String     @default("0")
  discipline   String?
  status       PlanStatus @default(DRAFT)
  /// The project's contract value, snapshotted at submit — the amount band
  /// that adds the CEO / President above ₱1,000,000.
  amount       Decimal?   @db.Decimal(18, 2)
  cancelReason String?

  submittedAt DateTime?
  approvedAt  DateTime?
  approvedBy  String?
  notes       String?

  uploadedById String
  uploadedBy   User   @relation("PlanUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  /// The CAD job order this plan was filed from, when it was (2026-10-09).
  cadJobOrder CadJobOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([number])
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

model JobTask {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  scopeItemId String?
  scopeItem   JobScopeItem? @relation(fields: [scopeItemId], references: [id], onDelete: SetNull)

  name        String
  description String?
  status      TaskStatus @default(NOT_STARTED)
  progressPct Int        @default(0)
  /// The task's share of its phase when a report works the phase's % out
  /// from its tasks (2026-10-15). Null counts as 1 — equal shares.
  weight      Decimal?   @db.Decimal(9, 3)

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  startDate DateTime? @db.Date
  dueDate   DateTime? @db.Date
  doneAt    DateTime?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, status])
  @@index([assignedToId])
}

// ════════════════════════════════════════════════════════════════════
//  G-CHAIN  (Phase 5)
//
//  Purchase Request → Canvass → Purchase Order → Receiving → Inventory
//  → Stock Issuance → Job cost.
//
//  The distinction that prevents double-counting (model §4.3):
//
//    DIRECT_TO_JOB        commits at PR/PO, charges the job at RECEIVING
//    STOCK_REPLENISHMENT  buys warehouse stock, charges the job at ISSUANCE
//
//  Without it, material bought for a job and later issued from stock gets
//  counted against that job twice.
// ════════════════════════════════════════════════════════════════════

enum PurchaseKind {
  DIRECT_TO_JOB
  STOCK_REPLENISHMENT
}

enum PrStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  PARTIALLY_ORDERED
  ORDERED
}

model PurchaseRequest {
  id     String       @id @default(cuid())
  number String       @unique
  kind   PurchaseKind @default(DIRECT_TO_JOB)
  status PrStatus     @default(DRAFT)

  /// Required when kind is DIRECT_TO_JOB — enforced in the route, because a
  /// stock replenishment legitimately has no job.
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  requestedById String
  requestedBy   User   @relation("PrRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  purpose           String
  neededBy          DateTime? @db.Date
  notes             String?
  /// The supplier the requester would like asked first — a hint for
  /// procurement, kept as typed; the canvass and the order name the real one.
  preferredSupplier String?

  /// Raised by the system when stock fell below its reorder level
  /// (2026-10-15, the owner's call: "automatic"): a DRAFT stock replenishment
  /// per warehouse that collects the items as they fall, for a person to
  /// check and submit. Never submitted by the system.
  autoReorder Boolean @default(false)

  approvedAt DateTime?

  items        PurchaseRequestItem[]
  pulloutSlips PulloutSlip[]
  canvasses    Canvass[]
  rfqs         Rfq[]
  orders       PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([jobId])
}

model PurchaseRequestItem {
  id        String          @id @default(cuid())
  requestId String
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  /// Which budget line this lands in. Required for a direct-to-job request.
  costCategoryId String?
  costCategory   CostCategory? @relation(fields: [costCategoryId], references: [id], onDelete: SetNull)

  /// The short name, printed bold over the description (the costing line's
  /// rule). Null on a line typed before the page editor: its description
  /// then serves as the name.
  name            String?
  partNumber      String?
  description     String
  quantity        Decimal @db.Decimal(18, 3)
  unit            String  @default("pcs")
  estimatedCost   Decimal @default(0) @db.Decimal(18, 2)
  /// quantity × estimatedCost, stored so the commitment is a recorded fact.
  estimatedAmount Decimal @default(0) @db.Decimal(18, 2)
  orderedQty      Decimal @default(0) @db.Decimal(18, 3)
  /// Taken from the shelf by a pull-out slip instead of bought (2026-10-14):
  /// what is left to order is quantity − orderedQty − pulledQty.
  pulledQty       Decimal @default(0) @db.Decimal(18, 3)
  sortOrder       Int     @default(0)

  quotes     CanvassQuote[]
  rfqItems   RfqItem[]
  rfqQuotes  RfqQuote[]
  orderItems PurchaseOrderItem[]

  @@index([requestId])
}

enum CanvassStatus {
  OPEN
  AWARDED
  CANCELLED
}

/// A Request for Quotation (2026-10-14, the owner's call: "Purchase Request,
/// RFQ, Canvass, Purchase Order"): the enquiry sent to suppliers for an
/// approved purchase request's lines. Printed one paper per supplier and
/// sent by hand; the quotes that come back are recorded on it, and the
/// canvass sheet compares them. No approval route — an enquiry decides
/// nothing (the request was approved; the order will be).
enum RfqStatus {
  DRAFT
  SENT
  QUOTED
  CLOSED
  CANCELLED
}

model Rfq {
  id     String    @id @default(cuid())
  number String    @unique
  status RfqStatus @default(DRAFT)

  requestId String
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  preparedById String
  preparedBy   User   @relation("RfqPreparer", fields: [preparedById], references: [id], onDelete: Restrict)

  /// Quote by — the date the suppliers are asked to answer by.
  dueDate      DateTime? @db.Date
  deliverTo    String?
  /// What is asked of the supplier: VAT status, validity, payment terms, lead time.
  terms        String?
  notes        String?
  sentAt       DateTime?
  cancelReason String?

  items     RfqItem[]
  suppliers RfqSupplier[]
  canvasses Canvass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([status])
}

/// The request lines an RFQ asks about — a subset, so one request may be
/// split across RFQs (by category, or a second round).
model RfqItem {
  id    String @id @default(cuid())
  rfqId String
  rfq   Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  requestItemId String
  requestItem   PurchaseRequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  @@unique([rfqId, requestItemId])
}

model RfqSupplier {
  id    String @id @default(cuid())
  rfqId String
  rfq   Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  /// Whom the paper is addressed to — the supplier's own, kept on the row.
  contactName  String?
  contactPhone String?
  email        String?

  sentAt          DateTime?
  quoteRef        String?
  quoteReceivedAt DateTime? @db.Date
  leadTimeDays    Int?
  terms           String?
  validUntil      DateTime? @db.Date
  remarks         String?

  quotes RfqQuote[]

  @@unique([rfqId, supplierId])
}

model RfqQuote {
  id            String      @id @default(cuid())
  rfqSupplierId String
  rfqSupplier   RfqSupplier @relation(fields: [rfqSupplierId], references: [id], onDelete: Cascade)

  requestItemId String
  requestItem   PurchaseRequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)

  unitPrice Decimal @db.Decimal(18, 2)
  remarks   String?

  @@unique([rfqSupplierId, requestItemId])
}

/// "Canvass/RFQ — supplier selection." Three quotes is the convention; the
/// system does not force it, but it shows how many you have.
model Canvass {
  id     String        @id @default(cuid())
  number String        @unique
  status CanvassStatus @default(OPEN)

  requestId String
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CanvassCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// The RFQ whose quotes it compares (2026-10-14); null on a canvass opened
  /// before RFQs were their own document.
  rfqId String?
  rfq   Rfq?    @relation(fields: [rfqId], references: [id], onDelete: SetNull)

  /// The request lines the sheet compares (2026-10-14): the RFQ's lines,
  /// snapshotted when the sheet is raised. Empty on a canvass opened before
  /// — it compares every line of its request, as it always did.
  lineIds String[] @default([])

  /// Printed on the sheet as its Remarks; a cancel appends its reason.
  notes            String?
  awardedAt        DateTime?
  /// Who awarded it — AWARDED BY on the sheet, with `awardedAt`.
  awardedById      String?
  awardedBy        User?     @relation("CanvassAwarder", fields: [awardedById], references: [id], onDelete: SetNull)
  /// The buyer's recommendation before the award (a CanvassSupplier id).
  recommendedRowId String?

  suppliers CanvassSupplier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([rfqId])
}

model CanvassSupplier {
  id        String  @id @default(cuid())
  canvassId String
  canvass   Canvass @relation(fields: [canvassId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  /// Set when this supplier wins the canvass. Only one per canvass.
  isSelected   Boolean @default(false)
  leadTimeDays Int?
  terms        String?
  remarks      String?

  /// Snapshotted from the RFQ (2026-10-14): whom the sheet names under the
  /// supplier, their quotation no., and the RFQ row it was copied from.
  contactName   String?
  contactPhone  String?
  quoteRef      String?
  rfqSupplierId String?

  quotes CanvassQuote[]

  @@unique([canvassId, supplierId])
}

model CanvassQuote {
  id                String          @id @default(cuid())
  canvassSupplierId String
  canvassSupplier   CanvassSupplier @relation(fields: [canvassSupplierId], references: [id], onDelete: Cascade)

  requestItemId String
  requestItem   PurchaseRequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)

  unitPrice Decimal @db.Decimal(18, 2)
  remarks   String?

  @@unique([canvassSupplierId, requestItemId])
}

enum PoStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id     String       @id @default(cuid())
  number String       @unique
  status PoStatus     @default(DRAFT)
  kind   PurchaseKind @default(DIRECT_TO_JOB)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  requestId String?
  request   PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("PoCreator", fields: [createdById], references: [id], onDelete: Restrict)

  orderDate      DateTime  @default(now()) @db.Date
  deliveryDate   DateTime? @db.Date
  deliverTo      String?
  /// The supplier's quotation the order answers (2026-10-14) — printed in DETAILS.
  quoteRef       String?
  /// The currency the supplier is paid in (2026-10-14, the owner's layout): printed under ORDER DETAILS; nothing is converted.
  /// The delivery address under Deliver to (2026-10-14): blank prints the company's.
  deliverAddress String?
  currency       String    @default("PHP")
  terms          String?
  notes          String?

  /// Snapshotted so an old order still prints the tax it was issued with.
  vatRate      Decimal @default(0.12) @db.Decimal(6, 4)
  vatInclusive Boolean @default(false)
  subtotal     Decimal @default(0) @db.Decimal(18, 2)
  vatAmount    Decimal @default(0) @db.Decimal(18, 2)
  total        Decimal @default(0) @db.Decimal(18, 2)

  issuedAt     DateTime?
  approvedAt   DateTime?
  /// Why it was cancelled (2026-10-19): a draft or pending order only — an
  /// issued one is pulled back to draft first, which undoes what issue did.
  cancelReason String?

  items      PurchaseOrderItem[]
  receivings Receiving[]
  bills      SupplierBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([supplierId])
  @@index([jobId])
}

model PurchaseOrderItem {
  id      String        @id @default(cuid())
  orderId String
  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  requestItemId String?
  requestItem   PurchaseRequestItem? @relation(fields: [requestItemId], references: [id], onDelete: SetNull)

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  costCategoryId String?
  costCategory   CostCategory? @relation(fields: [costCategoryId], references: [id], onDelete: SetNull)

  /// The bold name over the description and the part number — the
  /// requisition line's, carried over (2026-10-13). Null on a line typed
  /// before the order page: its description then serves as the name.
  name        String?
  partNumber  String?
  description String
  quantity    Decimal @db.Decimal(18, 3)
  unit        String  @default("pcs")
  unitPrice   Decimal @db.Decimal(18, 2)
  amount      Decimal @db.Decimal(18, 2)
  receivedQty Decimal @default(0) @db.Decimal(18, 3)
  sortOrder   Int     @default(0)

  receivingItems ReceivingItem[]

  @@index([orderId])
}

model Receiving {
  id     String @id @default(cuid())
  number String @unique

  /// The purchase order it receives against — or none (2026-10-14, the
  /// owner's call: "possible receive without a purchase order, approve it
  /// too"): a return, a free replacement, a customer-supplied item. Such a
  /// report names where the goods came from and why there is no order, and
  /// builds stock at the cost typed on each line.
  orderId String?
  order   PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  /// Without an order: the supplier it came from, when one is on file, else
  /// the name typed (a customer, a site), and why there is no order.
  supplierId String?
  supplier   Supplier? @relation("ReceivingFrom", fields: [supplierId], references: [id], onDelete: SetNull)
  sourceName String?
  reason     String?

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  receivedById String
  receivedBy   User   @relation("Receiver", fields: [receivedById], references: [id], onDelete: Restrict)

  receivedDate  DateTime @default(now()) @db.Date
  deliveryRefNo String?
  invoiceRefNo  String?
  notes         String?

  /// Incoming goes for approval (2026-10-14, the owner's call: "the warehouse
  /// receives this, approval of his/her report to"): a DRAFT moves nothing;
  /// the stock, the job cost and the order's received quantities post when
  /// the route approves it (RECEIVED). A report saved before the route
  /// existed posted when it was saved, so the default is RECEIVED.
  status       ReceivingStatus @default(RECEIVED)
  cancelReason String?

  items ReceivingItem[]
  bills SupplierBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([orderId])
  @@index([status])
}

enum ReceivingStatus {
  DRAFT
  PENDING_APPROVAL
  RECEIVED
  CANCELLED
}

model ReceivingItem {
  id          String    @id @default(cuid())
  receivingId String
  receiving   Receiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)

  /// The order line it receives — null on a report with no order, whose
  /// line names its item from the item master instead.
  orderItemId String?
  orderItem   PurchaseOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  itemId      String?
  item        Item?   @relation("ReceivedWithoutOrder", fields: [itemId], references: [id], onDelete: Restrict)
  /// The part number on the delivery (a report with no order); filled from the item master.
  partNumber  String?
  description String?
  unit        String?

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  /// The product group (item category) the goods go into inventory under
  /// (2026-10-20, the owner's call): required where the line files a new
  /// item, and filling a blank one on the item it names.
  categoryId String?
  category   ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  quantity Decimal @db.Decimal(18, 3)
  unitCost Decimal @db.Decimal(18, 2)
  serialNo String?
  batchNo  String?
  remarks  String?

  @@index([receivingId])
}

enum IssueStatus {
  DRAFT
  /// Outgoing goes for approval (2026-10-14): nothing leaves until it is approved.
  PENDING_APPROVAL
  ISSUED
  CANCELLED
}

/// Stock leaving the warehouse for a job. This is where a stock-sourced item
/// first charges the job (model §4.3).
model StockIssue {
  id     String      @id @default(cuid())
  number String      @unique
  status IssueStatus @default(DRAFT)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  issuedById   String
  issuedBy     User    @relation("Issuer", fields: [issuedById], references: [id], onDelete: Restrict)
  issuedToId   String?
  issuedTo     User?   @relation("IssuedTo", fields: [issuedToId], references: [id], onDelete: SetNull)
  issuedToName String?

  issueDate    DateTime  @default(now()) @db.Date
  purpose      String
  notes        String?
  /// Why a draft or pending slip was cancelled (2026-10-19).
  cancelReason String?
  issuedAt     DateTime?

  /// The internal receive proof (2026-10-15, the owner's call: "Outgoing =
  /// internal receive proof to the requestor"): where it goes, how, and the
  /// requestor's confirmation that it arrived in good order.
  deliverTo    String?
  referenceNo  String?
  carrier      String?
  driverName   String?
  /// The terms of receipt printed over the sign-offs — filled with the
  /// standard text on a new slip, editable per slip.
  instructions String?
  receivedAt   DateTime?
  receivedById String?
  receivedBy   User?     @relation("IssueReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedNote String?

  items StockIssueItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([status])
}

model StockIssueItem {
  id      String     @id @default(cuid())
  issueId String
  issue   StockIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  costCategoryId String?
  costCategory   CostCategory? @relation(fields: [costCategoryId], references: [id], onDelete: SetNull)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  quantity     Decimal @db.Decimal(18, 3)
  /// Moving-average cost at the moment of issue, snapshotted.
  unitCost     Decimal @default(0) @db.Decimal(18, 2)
  amount       Decimal @default(0) @db.Decimal(18, 2)
  /// Drawn from the slip's project's own stock (2026-10-18): already charged
  /// to the project at receiving, so issuing it posts no cost again.
  projectStock Boolean @default(false)
  remarks      String?
  /// Serial or batch, and its condition as it left (2026-10-15).
  serialNo     String?
  condition    String?
  sortOrder    Int     @default(0)

  @@index([issueId])
}

enum PulloutKind {
  /// Stock leaving for a customer's delivery against an issued sales order.
  SALES_ORDER
  /// Stock a project takes from the shelf instead of buying it, against an approved request.
  PURCHASE_REQUEST
  /// No source document (2026-10-15, the owner's call): a supplier return,
  /// testing, a repair — the reason is kept on the slip.
  OTHER
  /// A project's own stock (2026-10-18): goods bought for it and received
  /// into a warehouse, released to its site. Charged at receiving, so the
  /// release posts no cost again.
  PROJECT_STOCK
}

/// What a pull-out is for (2026-10-15, the owner's pull-out slip: the
/// "purpose / transaction type" boxes — internal, no customer delivery).
enum PulloutPurpose {
  SALES_ORDER
  PROJECT_USE
  SITE_INSTALLATION
  TESTING_AUDIT
  REPAIR_SERVICE
  SUPPLIER_RETURN
  OTHER
}

enum PulloutStatus {
  DRAFT
  PENDING_APPROVAL
  PULLED_OUT
  CANCELLED
}

/// A pull-out slip (2026-10-14, the owner's call: "Pull-out Slip — approved
/// Sales Order, or from Purchase Request"; "if no project was created, the
/// sales order is enough"). Stock out of a warehouse at its average cost,
/// against the document that asked for it; a project behind it is charged as
/// a stock issue charges it.
model PulloutSlip {
  id     String        @id @default(cuid())
  number String        @unique
  kind   PulloutKind
  status PulloutStatus @default(DRAFT)

  salesOrderId String?
  salesOrder   SalesOrder?      @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  requestId    String?
  request      PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  /// The project charged: the request's, or the project built from the sales
  /// order's quotation. Null when there is none.
  jobId        String?
  job          Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  preparedById String
  preparedBy   User      @relation("PulloutPreparer", fields: [preparedById], references: [id], onDelete: Restrict)
  releasedById String?
  releasedBy   User?     @relation("PulloutReleaser", fields: [releasedById], references: [id], onDelete: Restrict)
  releasedAt   DateTime?

  pulloutDate    DateTime @db.Date
  /// Who takes it out: the authorized person or courier.
  receivedByName String?
  /// Special instructions, remarks, accessories included.
  notes          String?
  cancelReason   String?

  /// The internal release slip (2026-10-15, the owner's pull-out slip): what
  /// it is for (null on a slip from before: read from its kind), who asked
  /// for it (their manager approves; null = the preparer), the references
  /// written on it, the courier, where it goes, when it is expected back, and
  /// — with no source document — why.
  purpose        PulloutPurpose?
  requestedById  String?
  requestedBy    User?           @relation("PulloutRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  poReference    String?
  drReference    String?
  courierCompany String?
  courierContact String?
  vehicle        String?
  destination    String?
  returnBy       DateTime?       @db.Date
  reason         String?

  items PulloutItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([salesOrderId])
  @@index([requestId])
  @@index([jobId])
}

model PulloutItem {
  id     String      @id @default(cuid())
  slipId String
  slip   PulloutSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// The sales order line or the request line it answers (one of two tables, so no foreign key).
  sourceLineId String?
  quantity     Decimal @db.Decimal(18, 3)
  /// At the warehouse's average when it went out; an estimate until then.
  unitCost     Decimal @default(0) @db.Decimal(18, 2)
  amount       Decimal @default(0) @db.Decimal(18, 2)
  sortOrder    Int     @default(0)
  /// Serial or batch, and its condition as it left (2026-10-15).
  serialNo     String?
  condition    String?

  @@index([slipId])
  @@index([sourceLineId])
}

/// Why a borrow is made (2026-10-15, the owner's borrower's slip: its "Borrowing type" boxes).
enum BorrowType {
  INTERNAL_OFFICE
  ON_SITE_PROJECT
  PERSONAL
  RND_TESTING
}

/// What came back, as the custodian found it (the form's return clearance).
enum ReturnCondition {
  COMPLETE_GOOD
  DAMAGED
  MISSING_PARTS
}

enum BorrowStatus {
  /// A request (2026-10-14): saved, not sent for approval.
  DRAFT
  PENDING_APPROVAL
  /// Approved, waiting for the warehouse to release it.
  APPROVED
  OUT
  PARTIALLY_RETURNED
  RETURNED
  OVERDUE
  /// Withdrawn or refused before anything left the shelf; the reason kept.
  CANCELLED
}

/// Tools and equipment lent out and expected back.
///
/// A borrow slip does NOT charge job cost (model §4.3) — the asset is on loan,
/// not consumed. It moves stock out of available and back again.
model BorrowSlip {
  id     String       @id @default(cuid())
  number String       @unique
  status BorrowStatus @default(OUT)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  borrowerId   String?
  borrower     User?   @relation("Borrower", fields: [borrowerId], references: [id], onDelete: SetNull)
  borrowerName String

  /// Who released it from the shelf — null until the warehouse does.
  issuedById String?
  issuedBy   User?   @relation("BorrowIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  /// Who asked for it (2026-10-14: anyone may). Null on a slip the warehouse
  /// wrote before requests existed.
  requestedById String?
  requestedBy   User?     @relation("BorrowRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  /// The day the requester needs it from.
  neededOn      DateTime? @db.Date
  /// When the warehouse released it (the instant; `borrowedAt` is the day).
  releasedAt    DateTime?
  cancelReason  String?

  /// The day it went out — for a request, the day it was asked for until released.
  borrowedAt DateTime  @default(now()) @db.Date
  dueAt      DateTime  @db.Date
  returnedAt DateTime? @db.Date
  purpose    String
  notes      String?

  /// The borrower's slip (2026-10-15, the owner's form): why, where, how to
  /// reach a borrower with no login — and the return clearance the custodian
  /// records when it comes back (the last return's word stands).
  borrowType        BorrowType?
  siteLocation      String?
  contactNo         String?
  returnedCondition ReturnCondition?
  returnNote        String?
  inspectedById     String?
  inspectedBy       User?            @relation("BorrowInspector", fields: [inspectedById], references: [id], onDelete: SetNull)
  inspectedAt       DateTime?

  items BorrowSlipItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([dueAt])
  @@index([requestedById])
}

model BorrowSlipItem {
  id     String     @id @default(cuid())
  slipId String
  slip   BorrowSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  quantity      Decimal @db.Decimal(18, 3)
  returnedQty   Decimal @default(0) @db.Decimal(18, 3)
  serialNo      String?
  remarks       String?
  /// As it left, and as it came back (2026-10-15).
  conditionOut  String?
  conditionBack String?

  @@index([slipId])
}

/// Stock on hand per item per warehouse, with its moving-average cost.
model InventoryBalance {
  id          String    @id @default(cuid())
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  quantity    Decimal @default(0) @db.Decimal(18, 3)
  /// On loan via a borrow slip — still owned, not available to issue.
  borrowedQty Decimal @default(0) @db.Decimal(18, 3)

  /// Moving weighted average. Recomputed on every receipt; issues take it as
  /// given, which is what stops an issue changing the cost of what remains.
  averageCost Decimal @default(0) @db.Decimal(18, 4)

  /// Where it sits in the warehouse — the bin or rack (2026-10-15, the
  /// owner's inventory screen). Set from the stock card; a receipt into a
  /// named location fills it while it is empty.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@unique([itemId, warehouseId])
  @@index([warehouseId])
}

/// Goods bought for a project (a direct-to-job order) and received into a
/// warehouse rather than to site (2026-10-18, the owner's call: "project goods
/// received into the warehouse should show in inventory"). The project was
/// charged at receiving, so this is the project's stock, kept apart from the
/// company's: it never mixes into a balance's moving average, never counts in
/// the company's stock value, and leaving the warehouse — an Outgoing line
/// marked project stock or a PROJECT_STOCK pull-out — posts no cost again.
model ProjectStock {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  quantity    Decimal @default(0) @db.Decimal(18, 3)
  /// Moving average of what the project paid for it, as the company stock's.
  averageCost Decimal @default(0) @db.Decimal(18, 4)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@unique([jobId, itemId, warehouseId])
  @@index([warehouseId])
  @@index([itemId])
}

enum StockMoveType {
  RECEIPT
  ISSUE
  BORROW
  RETURN
  ADJUSTMENT
}

/// The stock card: every movement, in order, with the balance after it.
model InventoryTransaction {
  id          String    @id @default(cuid())
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  type         StockMoveType
  /// Signed: positive in, negative out.
  quantity     Decimal       @db.Decimal(18, 3)
  unitCost     Decimal       @default(0) @db.Decimal(18, 4)
  /// Balance after this movement, so the card reads without re-summing.
  balanceAfter Decimal       @db.Decimal(18, 3)

  sourceType   String
  sourceId     String?
  sourceNumber String?
  notes        String?

  /// A movement of a project's own stock (ProjectStock) — never of the
  /// company's. Null for company stock.
  jobId String?
  job   Job?    @relation("ProjectStockMoves", fields: [jobId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())

  @@index([jobId])
  @@index([itemId, warehouseId, occurredAt])
  @@index([sourceType, sourceId])
}

// ════════════════════════════════════════════════════════════════════
//  G-HR  (Phase 6)
//
//  Clock in/out → Attendance → Timesheet → Job labour cost.
//  Leave and Overtime route through the one approval engine.
//
//  The rule that matters (model §4.4): overtime posts to a project's
//  budget ONLY once the supervisor AND HR have both approved. That is
//  enforced by the workflow having two steps and the module subscribing
//  to the settled outcome — never to an intermediate approval.
// ════════════════════════════════════════════════════════════════════

/// A face sample captured at enrolment: three to five per employee
/// (MIN_FACE_SAMPLES / MAX_FACE_SAMPLES in shared/hr.ts), so a match holds
/// across lighting, glasses and angle.
///
/// The browser sends a photo and nothing else; the 128-float descriptor is
/// computed on the SERVER from it (`describeFace()` in shared/face.ts) and
/// matched there by Euclidean distance, so a client can never assert whose
/// face it is. The photo (`photoPath`, an attachment on `face_enrollment`
/// whose entityId is the employee) is kept as the evidence, and is what a
/// sample is re-derived from when the engine changes.
model FaceEnrollment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// 128 floats.
  descriptor Json
  /// The pipeline that computed `descriptor` (FACE_ENGINE in shared/face.ts).
  /// Only samples of the current engine are matched — two pipelines describe
  /// the same photo ~0.1 apart — so a null or older value is a LEGACY sample:
  /// counted and listed, never compared, until the boot-time re-derivation
  /// recomputes it from its photo (shared/faceSamples.ts).
  engine     String?
  /// How good the capture was (`FaceQuality`: score, eyeDistance, brightness,
  /// yaw, tilt, levelled, contrastRetry), or `{ rederiveFailed: <reason> }`
  /// for a legacy sample whose photo could not be described again.
  quality    Json?
  photoPath  String?
  label      String?

  enrolledById String?
  enrolledBy   User?    @relation("FaceEnroller", fields: [enrolledById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([employeeId])
}

enum ClockMethod {
  FACE
  PIN
  BIOMETRIC
  MANUAL
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  HALF_DAY
  REST_DAY
}

/// One row per employee per day.
model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  timeIn       DateTime?
  timeInMethod ClockMethod?
  timeInPhoto  String?
  /// Match distance at clock-in, kept so a questionable match can be reviewed.
  timeInScore  Decimal?     @db.Decimal(6, 4)

  timeOut       DateTime?
  timeOutMethod ClockMethod?
  timeOutPhoto  String?
  timeOutScore  Decimal?     @db.Decimal(6, 4)

  status           AttendanceStatus @default(PRESENT)
  lateMinutes      Int              @default(0)
  /// Net of the unpaid break, so it is hours actually worked.
  workedMinutes    Int              @default(0)
  /// Left before the working day's end (HR Settings' workEnd), at clock-out
  /// on the same Manila day; 0 for a day closed after midnight (2026-10-16).
  undertimeMinutes Int              @default(0)

  /// The clock-in fallback's written reason (or HR's note on a correction).
  notes        String?
  /// The clock-OUT fallback's written reason — a PIN or the biometric device
  /// always carries one, at either end of the day (Phase 6 notes).
  timeOutNotes String?
  recordedById String?
  recordedBy   User?   @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
}

model LeaveType {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  /// The yearly allotment — "Allotted counts of leave per type" in Settings.
  daysPerYear   Decimal @default(0) @db.Decimal(6, 2)
  isPaid        Boolean @default(true)
  /// Sick leave usually needs a medical certificate.
  requiresProof Boolean @default(false)
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  balances LeaveBalance[]
  requests LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// What an employee is entitled to, and has used, in one year.
model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  year        Int
  entitled    Decimal @default(0) @db.Decimal(6, 2)
  carriedOver Decimal @default(0) @db.Decimal(6, 2)
  /// Only APPROVED leave counts here — pending requests are shown separately.
  used        Decimal @default(0) @db.Decimal(6, 2)

  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([year])
}

enum LeaveStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id     String      @id @default(cuid())
  number String      @unique
  status LeaveStatus @default(DRAFT)

  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  /// Dates carry times so a half day accounts correctly — "Start Date – End
  /// Date with time so that anyone who file for half day will account."
  startDate DateTime @db.Date
  startTime String?
  endDate   DateTime @db.Date
  endTime   String?
  /// Working days, to 0.5.
  days      Decimal  @db.Decimal(6, 2)

  reason      String
  proofNote   String?
  decidedAt   DateTime?
  decidedById String?
  decidedBy   User?     @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([startDate])
}

enum OtStage {
  PRIOR
  PRIOR_APPROVED
  ACTUAL_FILED
  APPROVED
  REJECTED
  CANCELLED
}

/// Overtime, in two acts.
///
/// 1. PRIOR — filed BEFORE the work with estimated hours. Its whole purpose is
///    the employee's evidence that the overtime was authorised.
/// 2. ACTUAL — the real finish time, filed after. Any variance against the
///    estimate is shown to the approver rather than quietly absorbed.
///
/// Cost posts to the job only when the actual filing is fully approved.
model OvertimeRequest {
  id     String  @id @default(cuid())
  number String  @unique
  stage  OtStage @default(PRIOR)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  /// "HH:mm" local to the site — overtime is planned in wall-clock time.
  plannedStart   String
  plannedEnd     String
  estimatedHours Decimal @db.Decimal(6, 2)

  actualStart String?
  actualEnd   String?
  actualHours Decimal? @db.Decimal(6, 2)
  /// Dinner break 17:00–18:00, −60 min, pre-checked. Unchecking means
  /// continuous work.
  dinnerBreak Boolean  @default(true)

  reason       String
  varianceNote String?

  /// Where the cost is deducted from — "On approvals have an option to where
  /// project it will be deducted in G-Ops Project management Budget Monitoring."
  jobId          String?
  job            Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  costCategoryId String?
  costCategory   CostCategory? @relation(fields: [costCategoryId], references: [id], onDelete: SetNull)

  /// Snapshotted at posting so a later rate change does not rewrite history.
  hourlyRate Decimal? @db.Decimal(14, 4)
  multiplier Decimal? @db.Decimal(6, 3)
  amount     Decimal? @db.Decimal(18, 2)

  priorApprovedAt DateTime?
  postedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, stage])
  @@index([date])
  @@index([jobId])
}

// ════════════════════════════════════════════════════════════════════
//  PLANTILLA — the authorised staffing pattern (G-HR)
// ════════════════════════════════════════════════════════════════════

/// A job title, the department it sits in and how many the company has
/// approved. Filled and vacant are DERIVED by counting active employees on
/// the position — never stored.
model Position {
  id                  String              @id @default(cuid())
  code                String              @unique
  title               String
  departmentId        String?
  department          Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  authorisedHeadcount Int                 @default(1)
  description         String?
  sortOrder           Int                 @default(0)
  isActive            Boolean             @default(true)
  employees           Employee[]
  extraHolders        EmployeeExtraPosition[]
  /// The role this slot counts (2026-10-19: "keep plantilla, count by role") —
  /// filled is the active employees whose login holds it.
  roleId              String?
  role                Role?               @relation("PositionRole", fields: [roleId], references: [id], onDelete: SetNull)
  courseRequirements  CourseRequirement[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Who added it (2026-10-18): "Edit Own" on Admin › Roles reads it.
  createdById String?

  @@index([departmentId])
  @@index([roleId])
}

/// Who holds a team's management post (2026-10-19, the owner's call: "KAT's
/// Technical Manager and Aftermarket Manager are shared with GIB, UIT, HIT's;
/// later prepare the setting if someone is hired"). No row is OWN: the
/// holders of the role on the team, as before. Read by the approval engine
/// before its own-team rule (`teamPostHolders` in shared/teamPosts.ts).
model TeamPost {
  teamId        String
  team          Industry     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  roleKey       String
  mode          TeamPostMode @default(OWN)
  /// SHARED: the holders of the role on these teams decide for this one.
  sharedTeamIds String[]     @default([])
  /// PEOPLE: these logins decide.
  userIds       String[]     @default([])
  updatedAt     DateTime     @updatedAt
  updatedById   String?

  @@id([teamId, roleKey])
}

enum TeamPostMode {
  OWN
  SHARED
  PEOPLE
}

/// A plantilla position an employee ALSO holds (2026-10-19, the owner's call:
/// "Karen is Accounting and HR Manager"). The main one stays on
/// Employee.positionId; these count as filled too, and the mirrored title
/// reads "Main / Extra". Roles, not positions, decide what one approves.
model EmployeeExtraPosition {
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  positionId String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)

  @@id([employeeId, positionId])
  @@index([positionId])
}

// ════════════════════════════════════════════════════════════════════
//  CLEARANCE — turnover of accountabilities before someone leaves
// ════════════════════════════════════════════════════════════════════

enum SeparationReason {
  RESIGNATION
  END_OF_CONTRACT
  END_OF_PROJECT
  TERMINATION
  RETIREMENT
  AWOL
  OTHER
}

enum ClearanceStatus {
  OPEN
  PENDING_APPROVAL
  CLEARED
  REJECTED
  CANCELLED
}

/// Who clears an item — mapped to an existing right in areaRight().
enum ClearanceArea {
  SUPERVISOR
  WAREHOUSE
  FINANCE
  HR
  ADMIN
}

enum ClearanceItemStatus {
  PENDING
  CLEARED
  WAIVED
}

/// The checklist is built from records the system already holds (open borrow
/// slips, unpaid claims, pending filings, projects and people assigned to the
/// leaver) plus the company-property list in HR Settings. Items that point at
/// a record derive their status FROM that record on read. Approval of this
/// document is what records the separation.
model EmployeeClearance {
  id             String           @id @default(cuid())
  number         String           @unique
  status         ClearanceStatus  @default(OPEN)
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reason         SeparationReason
  lastWorkingDay DateTime         @db.Date
  raisedById     String
  raisedBy       User             @relation("ClearanceRaiser", fields: [raisedById], references: [id], onDelete: Restrict)
  /// Prints as "Received by" on the form.
  handedOverToId String?
  handedOverTo   User?            @relation("ClearanceReceiver", fields: [handedOverToId], references: [id], onDelete: SetNull)
  notes          String?
  submittedAt    DateTime?
  clearedAt      DateTime?
  items          ClearanceItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([employeeId, status])
  @@index([status])
}

model ClearanceItem {
  id          String              @id @default(cuid())
  clearanceId String
  clearance   EmployeeClearance   @relation(fields: [clearanceId], references: [id], onDelete: Cascade)
  area        ClearanceArea
  sortOrder   Int                 @default(0)
  description String
  /// Set when the item IS a record elsewhere: 'borrow_slip' | 'expense_claim' |
  /// 'leave_request' | 'overtime_request' | 'job' | 'tasks' | 'leads' |
  /// 'quotations' | 'visits' | 'activities' | 'approvals' | 'reports' |
  /// 'sessions'. Its status is derived by syncClearanceItems(); it cannot be
  /// cleared by hand, only waived with a written reason.
  sourceType  String?
  sourceId    String?
  link        String?
  status      ClearanceItemStatus @default(PENDING)
  clearedById String?
  clearedBy   User?               @relation("ClearanceClearer", fields: [clearedById], references: [id], onDelete: SetNull)
  clearedAt   DateTime?
  /// Mandatory on WAIVED.
  remarks     String?

  @@unique([clearanceId, sourceType, sourceId])
  @@index([clearanceId])
}

// ════════════════════════════════════════════════════════════════════
//  MEETINGS — an internal meeting with invitees; the Meet link is pasted
//  from the organiser's own Google account (G-Core holds no credentials)
// ════════════════════════════════════════════════════════════════════

enum InviteeResponse {
  PENDING
  ACCEPTED
  TENTATIVE
  DECLINED
}

model Meeting {
  id               String             @id @default(cuid())
  number           String             @unique
  title            String
  agenda           String?
  location         String?
  /// A Google Maps link for the place (2026-10-13), http(s) only — G-CORE
  /// holds no Google credentials, so a place is tagged by a pasted link.
  mapUrl           String?
  /// Minutes of meeting (2026-10-13): what was said and decided, written by
  /// the organiser or anyone invited once it has started; who last wrote
  /// them, and when.
  minutes          String?
  minutesAt        DateTime?
  minutesById      String?
  minutesBy        User?              @relation("MeetingMinutesBy", fields: [minutesById], references: [id], onDelete: SetNull)
  /// The attendees agree the minutes (2026-10-14, the owner's call: "approval
  /// of attendees agreeing the minutes" — those who said Going). DRAFT while
  /// they are written; FOR_AGREEMENT once the organiser sends them (round
  /// `minutesRound`, one `MinutesAgreement` row per attendee); AGREED once
  /// every one has agreed. A change to the minutes after sending sets that
  /// round aside (its rows are kept) and they go out again.
  minutesStatus    MinutesStatus      @default(DRAFT)
  minutesRound     Int                @default(0)
  minutesSentAt    DateTime?
  minutesAgreedAt  DateTime?
  agreements       MinutesAgreement[]
  startsAt         DateTime
  endsAt           DateTime
  status           ActivityStatus     @default(PLANNED)
  organizerId      String
  organizer        User               @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  /// The project it is held for — a kick-off, a site meeting, a turnover —
  /// so the project's Meetings & Records tab lists it. Optional: most
  /// meetings are nobody's project.
  jobId            String?
  job              Job?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// https://meet.google.com/abc-defg-hij — pasted back, never derived.
  meetLink         String?
  calendarEventUrl String?
  /// Reserved for a Calendar API integration. Null until that ships.
  googleEventId    String?
  /// RFC 5545 SEQUENCE — bumped on every time change so a re-downloaded .ics
  /// replaces the event instead of duplicating it.
  icsSequence      Int                @default(0)
  cancelReason     String?
  invitees         MeetingInvitee[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([startsAt])
  @@index([organizerId, startsAt])
  @@index([status, startsAt])
  @@index([jobId, startsAt])
}

enum MinutesStatus {
  DRAFT
  FOR_AGREEMENT
  AGREED
}

enum MinutesResponse {
  PENDING
  AGREED
  CHANGE_ASKED
}

/// One attendee's answer to one round of the minutes (2026-10-14). Rows are
/// never deleted: an earlier round is the record of what was agreed then.
model MinutesAgreement {
  id          String          @id @default(cuid())
  meetingId   String
  meeting     Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  round       Int
  userId      String
  user        User            @relation("MinutesAgreement", fields: [userId], references: [id], onDelete: Cascade)
  response    MinutesResponse @default(PENDING)
  comment     String?
  respondedAt DateTime?
  createdAt   DateTime        @default(now())

  @@unique([meetingId, round, userId])
  @@index([userId, response])
}

model MeetingInvitee {
  id          String          @id @default(cuid())
  meetingId   String
  meeting     Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation("MeetingInvitee", fields: [userId], references: [id], onDelete: Cascade)
  required    Boolean         @default(true)
  response    InviteeResponse @default(PENDING)
  respondedAt DateTime?
  /// null = the in-app invitation has not been sent yet.
  notifiedAt  DateTime?

  @@unique([meetingId, userId])
  @@index([userId])
}

// ════════════════════════════════════════════════════════════════════
//  EVALUATIONS — probationary and trainee feedback; approval regularises
// ════════════════════════════════════════════════════════════════════

enum EvaluationKind {
  PROBATIONARY
  TRAINEE
}

enum EvaluationStatus {
  SCHEDULED
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

/// REGULARIZE / EXTEND / END for PROBATIONARY; ABSORB / END for TRAINEE.
enum EvaluationRecommendation {
  REGULARIZE
  EXTEND
  END
  ABSORB
}

model EmployeeEvaluation {
  id                          String                    @id @default(cuid())
  number                      String                    @unique
  kind                        EvaluationKind
  status                      EvaluationStatus          @default(DRAFT)
  /// 'MONTH_3' | 'MONTH_5' | 'END' | 'ADHOC'
  milestone                   String
  employeeId                  String
  employee                    Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// The record OWNER for canEditRecord.
  evaluatorId                 String
  evaluator                   User                      @relation("Evaluator", fields: [evaluatorId], references: [id], onDelete: Restrict)
  scheduledById               String?
  scheduledBy                 User?                     @relation("EvaluationScheduler", fields: [scheduledById], references: [id], onDelete: SetNull)
  dueDate                     DateTime?                 @db.Date
  periodFrom                  DateTime?                 @db.Date
  periodTo                    DateTime?                 @db.Date
  strengths                   String?
  improvements                String?
  comments                    String?
  recommendation              EvaluationRecommendation?
  effectiveDate               DateTime?                 @db.Date
  extendedTo                  DateTime?                 @db.Date
  /// Weighted mean of rated lines, 2dp. Not money.
  score                       Decimal?                  @db.Decimal(5, 2)
  submittedAt                 DateTime?
  approvedAt                  DateTime?
  employeeAcknowledgedAt      DateTime?
  employeeAcknowledgementNote String?
  lines                       EmployeeEvaluationLine[]
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  @@index([employeeId, status])
  @@index([evaluatorId, status])
  @@index([status, dueDate])
}

/// A SNAPSHOT of the criterion (hr.evaluationCriteria) at creation, so a
/// renamed or retired criterion never rewrites a signed form.
model EmployeeEvaluationLine {
  id           String             @id @default(cuid())
  evaluationId String
  evaluation   EmployeeEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterionKey String
  sortOrder    Int
  name         String
  weight       Decimal            @db.Decimal(5, 2)
  rating       Int?
  remarks      String?

  @@index([evaluationId])
}

// ════════════════════════════════════════════════════════════════════
//  GRUNTECH ACADEMY — courses, sessions and the training passport
// ════════════════════════════════════════════════════════════════════

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendeeResult {
  PENDING
  PASSED
  FAILED
  NO_SHOW
}

enum TrainingSource {
  SESSION
  EXTERNAL
}

enum TrainingRecordStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

model Course {
  id                 String              @id @default(cuid())
  /// Human code typed by HR (SAF-01), not nextNumber.
  code               String              @unique
  title              String
  /// The category's NAME — a list, not a reference (Admin › Categories ›
  /// Course categories since 2026-10-20): the chip's colour is looked up by
  /// name, and a renamed category keeps the courses that carry the old name.
  category           String?
  description        String?
  hours              Decimal             @default(0) @db.Decimal(6, 2)
  /// null = never expires. expiresAt = addMonths(completedAt, validityMonths).
  validityMonths     Int?
  requiresAssessment Boolean             @default(false)
  isActive           Boolean             @default(true)
  requirements       CourseRequirement[]
  sessions           TrainingSession[]
  records            TrainingRecord[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Who added it (2026-10-18): "Edit Own" on Admin › Roles reads it.
  createdById String?

  // The owner's Academy UI (2026-10-20): the course's default instructor
  // and their credential ("Grundfos Certified Trainer" — a trainer with no
  // login), the format its duration is said in ("2-Day Workshop"), whether a
  // certificate is issued, and the syllabus outline as modules.
  instructor           String?
  instructorCredential String?
  format               String?
  certificateIncluded  Boolean        @default(false)
  modules              CourseModule[]

  @@index([isActive])
}

/// The syllabus outline (2026-10-20): "Module 1: Air Generation" with its
/// topics, one row per module in order. Replaced whole by the course form.
model CourseModule {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sequence Int
  title    String
  topics   String[] @default([])

  @@unique([courseId, sequence])
}

/// Admin › Categories › Course categories (2026-10-20, the owner's Academy
/// UI: PNEUMATICS & GAS, HYDRAULICS & FLOW …). The service document
/// categories' contract — seeded system rows renamable and undeletable, an
/// administrator may add more — with a colour for the chip on the course
/// list. A course carries the NAME (`Course.category`), as a quotation line
/// carries its group.
model CourseCategory {
  id        String   @id @default(cuid())
  name      String
  color     String?
  sortOrder Int      @default(0)
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  createdById String?
}

/// Both null = everyone; department only = everyone in it; position only =
/// every holder of that plantilla position; both = the intersection.
model CourseRequirement {
  id           String      @id @default(cuid())
  courseId     String
  course       Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  positionId   String?
  position     Position?   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@unique([courseId, departmentId, positionId])
  @@index([departmentId])
  @@index([positionId])
}

model TrainingSession {
  id           String             @id @default(cuid())
  number       String             @unique
  status       SessionStatus      @default(SCHEDULED)
  courseId     String
  course       Course             @relation(fields: [courseId], references: [id], onDelete: Restrict)
  /// The OWNER for canEditRecord.
  trainerId    String
  trainer      User               @relation("SessionTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  provider     String?
  startsAt     DateTime
  endsAt       DateTime
  venue        String?
  meetLink     String?
  capacity     Int?
  notes        String?
  icsSequence  Int                @default(0)
  completedAt  DateTime?
  cancelReason String?
  createdById  String?
  createdBy    User?              @relation("SessionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attendees    TrainingAttendee[]
  records      TrainingRecord[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([startsAt])
  @@index([trainerId, status])
  @@index([courseId])
}

model TrainingAttendee {
  id           String          @id @default(cuid())
  sessionId    String
  session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  result       AttendeeResult  @default(PENDING)
  score        Decimal?        @db.Decimal(6, 2)
  enrolledAt   DateTime        @default(now())
  /// null = self-enrolled.
  enrolledById String?
  enrolledBy   User?           @relation("AttendeeEnroller", fields: [enrolledById], references: [id], onDelete: SetNull)

  @@unique([sessionId, employeeId])
  @@index([employeeId])
}

/// Expiry is NOT stored — CURRENT/EXPIRING/EXPIRED is derived from expiresAt on
/// read (expiryState in shared/aftermarket.ts). `status` records verification.
model TrainingRecord {
  id             String               @id @default(cuid())
  /// GT-TC-… for an EXTERNAL certification (the approval's handle); null for a
  /// record written by a session completion.
  number         String?              @unique
  employeeId     String
  employee       Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  courseId       String
  course         Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)
  source         TrainingSource
  sessionId      String?
  session        TrainingSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  status         TrainingRecordStatus
  completedAt    DateTime             @db.Date
  expiresAt      DateTime?            @db.Date
  provider       String?
  certificateNo  String?
  notes          String?
  verifiedById   String?
  verifiedBy     User?                @relation("TrainingVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt     DateTime?
  /// When the expiring-soon notice went out — reset to null when expiresAt changes.
  expiryNoticeAt DateTime?
  createdById    String?
  createdBy      User?                @relation("TrainingRecordAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([sessionId, employeeId])
  @@index([employeeId, courseId])
  @@index([expiresAt])
  @@index([status])
}

// ════════════════════════════════════════════════════════════════════
//  PEOPLE FLOW — one person's path from start to separation (2026-10-13)
// ════════════════════════════════════════════════════════════════════

enum FlowItemStatus {
  PENDING
  DONE
  WAIVED
  NA
}

/// What HR recorded against one item of the People Flow checklist
/// (`hr.peopleFlow` in Settings, `shared/peopleFlow.ts`) for one person. A
/// row exists only once HR has said something about the item — the path is
/// the checklist merged with these rows and with the records that answer
/// for the derived items (an evaluation, training, the clearance), read
/// every time. A derived item is only ever WAIVED here, with a reason; its
/// DONE comes from its record. `itemKey` is the checklist's permanent key, so
/// an item dropped from the checklist leaves its rows as history.
model EmployeeFlowItem {
  id          String         @id @default(cuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  itemKey     String
  status      FlowItemStatus @default(PENDING)
  /// The day it was done (a DATE, the Manila day) — typed by HR, today by default.
  doneOn      DateTime?      @db.Date
  /// The 30-60-90 goals, the exit interview's feedback, a waiver's reason.
  notes       String?
  updatedById String?
  updatedBy   User?          @relation("FlowItemUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([employeeId, itemKey])
}

/// Saved filters for the shared list pattern (model §8.4).
model SavedFilter {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listKey       String
  name          String
  query         Json
  isShared      Boolean  @default(false)
  /// The list's columns this view hides (2026-10-12) — null keeps the viewer's own choice.
  hiddenColumns Json?
  /// The view the list opens with on a bare visit — one per person per list.
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([listKey])
  @@index([userId, listKey])
}

// ═══════════════════════════════════════════════════════════════════════════
//  G-FIN — Phase 7
//
//  Finance CONSUMES operational transactions; it does not re-key them
//  (model §4.6). An invoice is raised from an approved progress billing and
//  carries its figures forward. A supplier bill is raised against a purchase
//  order and its receivings. An expense claim is the only document here that
//  starts life in finance.
//
//  The rule that shapes all of it: invoiced ≠ collectible. EWT is withheld at
//  source by the customer and comes back as a tax certificate, not as cash, so
//  every outstanding balance is measured against NET COLLECTIBLE.
// ═══════════════════════════════════════════════════════════════════════════

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// What we billed the customer. Raised from a progress billing wherever one
/// exists, so the figures are carried rather than retyped.
model Invoice {
  id     String        @id @default(cuid())
  number String        @unique
  status InvoiceStatus @default(DRAFT)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  /// One invoice per progress billing. A billing that has been invoiced cannot
  /// be invoiced again — that is what makes double-billing impossible rather
  /// than merely discouraged.
  progressBillingId String?          @unique
  progressBilling   ProgressBilling? @relation(fields: [progressBillingId], references: [id], onDelete: Restrict)

  /// One invoice per chargeable job order — the same guarantee progressBillingId
  /// gives billings.
  jobOrderId String?   @unique
  jobOrder   JobOrder? @relation(fields: [jobOrderId], references: [id], onDelete: Restrict)

  /// An issued sales order this invoice bills (in part or whole). Not
  /// unique: an order is invoiced as it is delivered, never past its net.
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)

  invoiceDate   DateTime  @db.Date
  /// The day the customer received ("countered") the issued invoice. The
  /// expected collection counts from it; until it is recorded the invoice
  /// is awaiting countering and never overdue (2026-10-15, the owner's call).
  counteredDate DateTime? @db.Date
  /// Net days. dueDate = (counteredDate ?? invoiceDate) + termsDays — the
  /// expected collection. Null on an invoice raised before, which keeps the
  /// due date it was given.
  termsDays     Int?
  dueDate       DateTime  @db.Date
  terms         String?
  poReference   String?
  /// The number printed on the sales invoice booklet (BIR), typed by hand
  /// (2026-10-16, the owner's call); `number` stays G-CORE's own record.
  siNumber      String?

  /// Who sold it — credited with the collection. Filled from the document
  /// behind the invoice (the sales order's or quotation's owner), editable.
  salespersonId String?
  salesperson   User?     @relation("InvoiceSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  /// The team credited — the quotation's team, else the salesperson's, kept
  /// as raised (a quotation keeps the team it was raised under).
  teamId        String?
  team          Industry? @relation("InvoiceTeam", fields: [teamId], references: [id], onDelete: SetNull)

  /// Snapshotted from the billing, or entered on a standalone invoice. Never
  /// recomputed from Settings afterwards.
  grossAmount    Decimal @db.Decimal(18, 2)
  vatRate        Decimal @default(0.12) @db.Decimal(6, 4)
  vatAmount      Decimal @db.Decimal(18, 2)
  ewtRate        Decimal @default(0.02) @db.Decimal(6, 4)
  ewtAmount      Decimal @db.Decimal(18, 2)
  invoiceTotal   Decimal @db.Decimal(18, 2)
  /// invoiceTotal − ewtAmount. THE figure A/R is measured against.
  netCollectible Decimal @db.Decimal(18, 2)
  /// The EWT the invoice was raised with, kept while its collections say
  /// what the customer ACTUALLY withheld (2026-10-20): `ewtAmount` is then
  /// their sum, and this puts it back when no collection says so any more.
  ewtAsBilled    Decimal? @db.Decimal(18, 2)

  /// Maintained from allocations. Denormalised because every A/R screen reads
  /// it and the aging query cannot afford a join per row.
  amountCollected Decimal @default(0) @db.Decimal(18, 2)

  /// BIR Form 2307. Until it arrives the withheld tax is neither cash nor a
  /// credit — worth chasing, and invisible unless it is recorded.
  ewtCertificateNo String?
  ewtCertificateAt DateTime? @db.Date

  /// 'SCORO' on an invoice the SCORO invoices import raised (2026-10-17):
  /// a real receivable, its paper and number G-CORE's, its origin kept.
  importedFrom String?

  notes      String?
  issuedAt   DateTime?
  voidedAt   DateTime?
  voidReason String?

  createdById String
  createdBy   User   @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  lines       InvoiceLine[]
  allocations PaymentAllocation[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  /// The invoice request whose approval raised it (2026-10-15).
  invoiceRequest InvoiceRequest?

  @@index([status])
  @@index([customerId, status])
  @@index([dueDate])
  @@index([jobId])
  @@index([siNumber])
  @@index([salesOrderId])
  @@index([salespersonId])
  @@index([teamId])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  sortOrder   Int     @default(0)
  description String
  /// Percentage billed this period, where the line came from a scope item.
  detail      String?
  amount      Decimal @db.Decimal(18, 2)

  @@index([invoiceId])
}

enum BillStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// What a supplier billed us. Raised against a purchase order where one
/// exists.
///
/// A bill matched to a receiving posts NOTHING to the job cost ledger: the
/// receiving already incurred it, and posting again would charge the same peso
/// twice. A bill with no receiving behind it — a subcontractor certificate, a
/// service call, a utility — is the first time that cost appears, so that one
/// does post.
model SupplierBill {
  id     String     @id @default(cuid())
  number String     @unique
  status BillStatus @default(DRAFT)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  orderId String?
  order   PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Set when the bill covers goods already received. Its presence is what
  /// suppresses the cost posting.
  receivingId String?
  receiving   Receiving? @relation(fields: [receivingId], references: [id], onDelete: SetNull)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  costCategoryId String?
  costCategory   CostCategory? @relation("BillCategory", fields: [costCategoryId], references: [id], onDelete: SetNull)

  /// Theirs, not ours — printed on their invoice.
  supplierInvoiceNo String?
  billDate          DateTime @db.Date
  dueDate           DateTime @db.Date
  terms             String?

  /// When the goods or the work were delivered (2026-10-15, the owner's A/P
  /// sample): the receiving's date where one is matched, else typed. The
  /// terms run from it — due = delivery (else the bill date) + termsDays.
  deliveryDate  DateTime? @db.Date
  /// Net days — "30 Days". `terms` stays for what printed before.
  termsDays     Int?
  /// The purchaser / buyer: the purchase order's author, else picked.
  purchaserId   String?
  purchaser     User?     @relation("BillPurchaser", fields: [purchaserId], references: [id], onDelete: SetNull)
  /// A purchaser with no login, typed by name (2026-10-16, the owner's
  /// call); null when `purchaserId` names one.
  purchaserName String?

  subtotal  Decimal @db.Decimal(18, 2)
  vatRate   Decimal @default(0.12) @db.Decimal(6, 4)
  vatAmount Decimal @db.Decimal(18, 2)
  total     Decimal @db.Decimal(18, 2)

  /// Gruntech withholds from the supplier in turn — 1% on goods, 2% on
  /// services by default. Withheld on the subtotal, never on the VAT.
  ewtRate    Decimal @default(0) @db.Decimal(6, 4)
  ewtAmount  Decimal @default(0) @db.Decimal(18, 2)
  /// total − ewtAmount. What actually leaves the bank.
  netPayable Decimal @db.Decimal(18, 2)

  amountPaid Decimal @default(0) @db.Decimal(18, 2)

  /// True when a job cost entry was written for this bill, so a later status
  /// change cannot post it a second time.
  postedToJob Boolean   @default(false)
  postedAt    DateTime?

  notes      String?
  approvedAt DateTime?

  createdById String
  createdBy   User   @relation("BillCreator", fields: [createdById], references: [id], onDelete: Restrict)

  lines       SupplierBillLine[]
  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([supplierId, status])
  @@index([dueDate])
  @@index([jobId])
  @@index([purchaserId])
}

model SupplierBillLine {
  id     String       @id @default(cuid())
  billId String
  bill   SupplierBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  sortOrder   Int     @default(0)
  description String
  quantity    Decimal @default(1) @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  amount      Decimal @db.Decimal(18, 2)

  @@index([billId])
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REIMBURSED
  CANCELLED
  /// A liquidation the advance fully covered. Nothing is owed to the person.
  SETTLED
}

/// Money someone spent out of their own pocket on the company's behalf.
///
/// The only G-FIN document that does not come from an operational one, and
/// therefore the only one where a person keys the amounts. Approving it posts
/// INCURRED cost when it is tagged to a job.
model ExpenseClaim {
  id     String        @id @default(cuid())
  number String        @unique
  status ExpenseStatus @default(DRAFT)

  claimedById String
  claimedBy   User   @relation("Claimant", fields: [claimedById], references: [id], onDelete: Restrict)

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  costCategoryId String?
  costCategory   CostCategory? @relation("ExpenseCategory", fields: [costCategoryId], references: [id], onDelete: SetNull)

  /// Set when this claim LIQUIDATES a cash advance. The lines are the receipts
  /// against it; total − advance.amountReleased is the excess owed to the
  /// person (settled here like any claim) or, when negative, the unspent cash
  /// owed back (carried on the advance as REFUND_DUE). Not unique: a rejected
  /// liquidation is re-filed; the route allows one LIVE claim per advance.
  advanceId String?
  advance   CashAdvance? @relation(fields: [advanceId], references: [id], onDelete: Restrict)

  /// Set when this claim LIQUIDATES a budget request — project cash, the
  /// same arithmetic as an advance's liquidation. One or the other, never both.
  budgetRequestId String?
  budgetRequest   BudgetRequest? @relation(fields: [budgetRequestId], references: [id], onDelete: Restrict)

  claimDate DateTime @db.Date
  purpose   String

  total Decimal @default(0) @db.Decimal(18, 2)

  amountPaid Decimal @default(0) @db.Decimal(18, 2)

  postedToJob Boolean   @default(false)
  postedAt    DateTime?

  notes      String?
  approvedAt DateTime?

  lines       ExpenseClaimLine[]
  allocations PaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([claimedById, status])
  @@index([jobId])
  @@index([advanceId])
}

model ExpenseClaimLine {
  id      String       @id @default(cuid())
  claimId String
  claim   ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  sortOrder   Int      @default(0)
  spentOn     DateTime @db.Date
  description String
  /// Free text: fare, meals, accommodation, materials bought on site…
  category    String?
  /// The OR or receipt number, because a claim without one is not claimable.
  receiptNo   String?
  /// The company the receipt is from (2026-10-15, the owner's line pattern:
  /// Date — Company / receipt — Item / purpose).
  vendor      String?
  amount      Decimal  @db.Decimal(18, 2)

  @@index([claimId])
}

/// Money issued to a person BEFORE it is spent. It is a receivable from that
/// person until an approved liquidation (an ExpenseClaim with advanceId) says
/// what was spent. Nothing reaches a job's ledger until then; the liquidation
/// posts INCURRED at the amount actually spent.
enum CashAdvanceStatus {
  DRAFT
  PENDING_APPROVAL
  /// Approved; finance has not yet handed the cash over.
  APPROVED
  /// Cash handed over; waiting for the liquidation.
  RELEASED
  /// Liquidation approved and the person still holds unspent cash.
  REFUND_DUE
  /// Liquidation approved and nothing is owed either way.
  LIQUIDATED
  /// A loan (`repayable`) repaid in full — the owner's "Paid" (2026-10-15).
  PAID
  REJECTED
  CANCELLED
}

model CashAdvance {
  id     String            @id @default(cuid())
  number String            @unique
  status CashAdvanceStatus @default(DRAFT)

  requestedById String
  requestedBy   User   @relation("AdvanceRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  /// Where the spend will be charged. Fixed for the liquidation that follows.
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  costCategoryId String?
  costCategory   CostCategory? @relation("AdvanceCategory", fields: [costCategoryId], references: [id], onDelete: SetNull)

  requestDate DateTime  @db.Date
  neededBy    DateTime? @db.Date
  purpose     String

  amount Decimal @db.Decimal(18, 2)

  /// Re-derived by refreshAdvance(): Σ DISBURSEMENT allocations. 0 or amount —
  /// an advance is released in one voucher.
  amountReleased Decimal @default(0) @db.Decimal(18, 2)
  /// Re-derived by refreshAdvance(): the approved liquidation's total, else 0.
  amountSpent    Decimal @default(0) @db.Decimal(18, 2)
  /// Re-derived by refreshAdvance(): Σ RECEIPT allocations (unspent cash
  /// returned; on a loan, the repayments made — salary deductions included).
  amountRefunded Decimal @default(0) @db.Decimal(18, 2)

  /// MONEY LENT (2026-10-15, the owner's module 7): true on every advance
  /// raised from then on. Released, it is repaid in instalments (receipts,
  /// salary deductions) until PAID — never liquidated with receipts. An
  /// advance raised before keeps false and its liquidation.
  repayable Boolean   @default(false)
  /// When the last repayment cleared the balance.
  repaidAt  DateTime? @db.Date

  /// releasedAt + finance.rules.advanceLiquidationDays, snapshotted at release.
  liquidationDueDate DateTime? @db.Date

  approvedAt   DateTime?
  releasedAt   DateTime? @db.Date
  liquidatedAt DateTime?
  notes        String?

  liquidations         ExpenseClaim[]
  commissionDeductions CommissionShare[]
  allocations          PaymentAllocation[]
  /// The breakdown of what the cash buys (2026-10-19); the amount is their sum.
  items                CashAdvanceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([requestedById, status])
  @@index([jobId])
}

enum PaymentKind {
  /// Money in — a customer settling an invoice, or a person returning unspent
  /// cash from an advance. "Collections" means customer receipts only.
  RECEIPT
  /// Money out — a supplier bill or an expense reimbursement.
  DISBURSEMENT
}

enum PaymentMethod {
  CASH
  CHECK
  BANK_TRANSFER
  ONLINE
  OFFSET
  /// A cash advance repaid out of the employee's pay (2026-10-15) — entered
  /// by finance, cleared as recorded.
  SALARY_DEDUCTION
  /// A cash advance repaid out of a commission payout (2026-10-16) —
  /// written only by the commission's payout, cleared as recorded.
  COMMISSION_DEDUCTION
}

/// One movement of money, allocated across one or more documents.
///
/// Allocation matters: a customer rarely pays exactly one invoice. A single
/// cheque against three billings has to land on the right three, or A/R aging
/// is fiction.
model Payment {
  id     String        @id @default(cuid())
  number String        @unique
  kind   PaymentKind
  method PaymentMethod @default(BANK_TRANSFER)

  paymentDate DateTime @db.Date

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  /// For an expense reimbursement, the person being paid back.
  payeeUserId String?
  payeeUser   User?   @relation("Payee", fields: [payeeUserId], references: [id], onDelete: SetNull)

  amount Decimal @db.Decimal(18, 2)

  /// Cheque number or transfer reference.
  reference String?
  /// The official receipt a customer collection is given — G-CORE's
  /// numbering (`official_receipt`, 2026-10-15), issued on save. Indexed,
  /// not @unique: a unique constraint on an existing table stops the
  /// server's unattended db push; the counter keeps it unique.
  orNumber  String?
  bank      String?
  /// A cheque is not cash until it clears; until then it is a promise.
  clearedAt DateTime? @db.Date

  /// 'SCORO' on a collection the SCORO invoices import recorded (2026-10-17,
  /// the owner's call: "keep them out as history"). It settles its invoice,
  /// but no collection total, cash-flow actual or dashboard figure counts it
  /// (`LIVE_MONEY` in shared/finance.ts).
  importedFrom String?

  notes String?

  recordedById String
  recordedBy   User   @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  allocations       PaymentAllocation[]
  /// Lines typed by hand on a collection (2026-10-16, the owner's call): money
  /// received on account, against no invoice on file — applied to one later.
  commissionPayouts CommissionShare[]   @relation("CommissionPayout")
  lines             PaymentLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, paymentDate])
  @@index([orNumber])
  @@index([customerId])
  @@index([supplierId])
  @@index([payeeUserId])
}

/// A slice of a payment applied to one document. Exactly one of the four
/// document references is set.
/// A collection line typed by hand: a reference (an SI no., what it is for)
/// and an amount received ON ACCOUNT — part of the payment, settling no
/// invoice, until it is applied to one (`POST /payments/:id/lines/:lineId/apply`).
model PaymentLine {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)
  reference String
  amount    Decimal @db.Decimal(18, 2)

  @@index([paymentId])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// The EWT the customer withheld on THIS collection of the invoice, typed
  /// by finance (2026-10-20, the owner's call: "sometimes the collection is
  /// not matched from the invoice"). Null says nothing; once any collection
  /// of an invoice says it, the invoice's EWT is their sum.
  ewtWithheld Decimal? @db.Decimal(18, 2)

  billId String?
  bill   SupplierBill? @relation(fields: [billId], references: [id], onDelete: Cascade)

  claimId String?
  claim   ExpenseClaim? @relation(fields: [claimId], references: [id], onDelete: Cascade)

  /// A DISBURSEMENT allocation to an advance is the cash release; a RECEIPT
  /// allocation to an advance is the refund of unspent cash. Direction comes
  /// from Payment.kind, never from a second column.
  advanceId String?
  advance   CashAdvance? @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  /// A DISBURSEMENT allocation to a budget request is the release of project
  /// cash; a RECEIPT allocation is unspent cash coming back. Same rule as the
  /// advance: direction comes from Payment.kind.
  budgetRequestId String?
  budgetRequest   BudgetRequest? @relation(fields: [budgetRequestId], references: [id], onDelete: Cascade)

  /// A commission beneficiary's payout (2026-10-16): a DISBURSEMENT
  /// allocation to the share, written only by POST /commissions/:id/pay.
  commissionShareId String?
  commissionShare   CommissionShare? @relation("CommissionAllocation", fields: [commissionShareId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([invoiceId])
  @@index([billId])
  @@index([claimId])
  @@index([advanceId])
  @@index([budgetRequestId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  AFTERMARKET — Phase 8
//
//  What turns a finished project into a renewal pipeline (model §4.5):
//
//    Job turnover → installed asset register → warranty
//      → service contract → PM schedule → visit
//      → commissioning / PM / inspection report → billing → renewal
//
//  A service contract is NOT a new kind of commercial record: it is a Job of
//  type SERVICE_CONTRACT, with its own costing, budget across the same five
//  categories, schedule of values and progress billing. ServiceContract below
//  carries only what a job does not already have — what is covered, how often,
//  and when it runs out.
// ═══════════════════════════════════════════════════════════════════════════

enum AssetStatus {
  /// Installed and in service.
  ACTIVE
  /// Still installed, not running — mothballed, awaiting parts.
  INACTIVE
  /// Removed from site, or replaced.
  DECOMMISSIONED
}

/// One piece of equipment Gruntech installed, where it stands today.
///
/// The register is what makes aftermarket possible at all: without it nobody
/// can answer "what did we put in that hospital, and when does its warranty
/// run out".
/// The equipment types the register suggests — COMPRESSOR, DRYER, FILTER…
/// (seeded, CAPSLOCK) plus any typed on a registration since. A list, not a
/// reference: the asset keeps its type as text in `name`.
model EquipmentType {
  id        String   @id @default(cuid())
  name      String
  /// The name trimmed, single-spaced, upper-cased: one type per spelling.
  key       String   @unique
  sortOrder Int      @default(99)
  createdAt DateTime @default(now())
}

model InstalledAsset {
  id     String      @id @default(cuid())
  code   String      @unique
  status AssetStatus @default(ACTIVE)

  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  siteId     String?
  site       CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  /// The project that installed it. Kept even after the job closes — this link
  /// is how a turned-over project becomes a renewal lead.
  jobId String?
  job   Job?    @relation("AssetInstaller", fields: [jobId], references: [id], onDelete: SetNull)

  /// The catalogue item, where it was one Gruntech supplies.
  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  /// The equipment type — COMPRESSOR, DRYER, FIRE PUMP… — suggested from
  /// EquipmentType and remembered there when a new one is typed.
  name         String
  manufacturer String?
  model        String?
  serialNo     String?
  /// Specification: supply voltage, power, flow, pressure, application…
  capacity     String?
  /// Where on the premises the machine stands ("Plant room, 2nd floor").
  location     String?
  /// Where the machine is, as an address — the register asks for this rather
  /// than a CustomerSite; `siteId` stays for assets registered by turnover.
  address      String?

  installedAt    DateTime? @db.Date
  commissionedAt DateTime? @db.Date
  /// When free repair stops and billable service starts. The single most
  /// commercially useful date in this table.
  warrantyEndsAt DateTime? @db.Date

  notes String?

  createdById String?
  createdBy   User?   @relation("AssetCreator", fields: [createdById], references: [id], onDelete: SetNull)

  contracts ServiceContractAsset[]
  /// Technical documents filed against this machine (2026-10-20).
  documents ServiceDocument[]
  visits    ServiceVisit[]
  reports   ServiceReport[]
  jobOrders JobOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, status])
  @@index([siteId])
  @@index([warrantyEndsAt])
  @@index([serialNo])
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  RENEWED
  CANCELLED
}

/// The coverage terms of a service contract.
///
/// One-to-one with a Job of type SERVICE_CONTRACT, which holds the money: the
/// costing, the budget, the schedule of values and the progress billings. This
/// record answers only the questions a job cannot — which equipment is covered,
/// how often it is visited, what response time was promised, and when it runs
/// out.
model ServiceContract {
  id     String         @id @default(cuid())
  number String         @unique
  status ContractStatus @default(DRAFT)

  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  startsAt DateTime @db.Date
  endsAt   DateTime @db.Date

  /// Months between preventive-maintenance visits. 3 = quarterly.
  frequencyMonths Int @default(3)
  /// Planned visits over the whole term. Derived on generation, stored so a
  /// later change of frequency does not rewrite a schedule already agreed.
  plannedVisits   Int @default(0)

  /// The SLA coverage level in the customer's words — "24/7 Comprehensive
  /// PM", "Quarterly Labor & Parts" (2026-10-20, the owner's spec). Free
  /// text, suggested from the levels on file.
  coverageLevel String?
  /// Hours promised for a breakdown call. Free text because contracts say
  /// things like "next working day" as often as they say a number.
  responseTime  String?
  /// What the contract does NOT cover — consumables, parts, travel.
  exclusions    String?
  coverageNotes String?

  /// Set when this contract replaced an expiring one, so a renewal chain is
  /// readable backwards.
  renewedFromId String?          @unique
  renewedFrom   ServiceContract? @relation("Renewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedTo     ServiceContract? @relation("Renewal")

  assets    ServiceContractAsset[]
  visits    ServiceVisit[]
  reports   ServiceReport[]
  jobOrders JobOrder[]

  createdById String
  createdBy   User   @relation("ContractCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, endsAt])
}

model ServiceContractAsset {
  id         String          @id @default(cuid())
  contractId String
  contract   ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  assetId    String
  asset      InstalledAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([contractId, assetId])
  @@index([assetId])
}

enum ServiceKind {
  COMMISSIONING
  PREVENTIVE_MAINTENANCE
  INSPECTION
  CORRECTIVE
}

enum VisitStatus {
  SCHEDULED
  /// Booked AND agreed with the customer (2026-10-20): still open — overdue,
  /// missed and due read it as SCHEDULED — only confirmed.
  CONFIRMED
  COMPLETED
  MISSED
  CANCELLED
}

/// A planned or completed attendance on site.
///
/// Separate from the report on purpose: a visit that has not happened yet has
/// nothing to report, and "what is due this month" must be answerable without
/// reading half-empty documents. A report may also exist with no visit behind
/// it, because a breakdown call does not appear on a schedule.
model ServiceVisit {
  id     String      @id @default(cuid())
  number String      @unique
  kind   ServiceKind @default(PREVENTIVE_MAINTENANCE)
  status VisitStatus @default(SCHEDULED)

  contractId String?
  contract   ServiceContract? @relation(fields: [contractId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  siteId     String?
  site       CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  assetId String?
  asset   InstalledAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  /// Which visit of the contract's schedule this is — 1 of 4, 2 of 4.
  sequence    Int?
  dueDate     DateTime  @db.Date
  performedAt DateTime? @db.Date
  /// The slot on the day (2026-10-20, the owner's spec): "HH:MM" both, or
  /// neither for a full-day site visit — `visitSlot()` is the one rule.
  startTime   String?
  endTime     String?
  /// Confirmed with the customer — by the engineer on it or Edit All.
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?     @relation("VisitConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("VisitEngineer", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// The job order this visit was scheduled from, when it was not generated
  /// by a contract's PM schedule. A visit with a sequence is generated; a
  /// visit without one is a call-out and survives regeneration.
  jobOrderId String?   @unique
  jobOrder   JobOrder? @relation(fields: [jobOrderId], references: [id], onDelete: SetNull)

  notes String?

  report ServiceReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueDate])
  @@index([contractId])
  @@index([assignedToId, status])
}

/// Which register a job order belongs to (2026-10-20, the owner's revised
/// Aftermarket UI): PROJECT is the project work order under Project
/// Management, whose approval builds the project; SERVICE is the Service JO
/// under Aftermarket, whose approval books the service visit.
enum JobOrderCategory {
  PROJECT
  SERVICE
}

enum JobOrderStatus {
  DRAFT
  PENDING_APPROVAL
  /// Accepted; one ServiceVisit was scheduled from it.
  APPROVED
  /// The report on its visit was approved.
  COMPLETED
  REJECTED
  CANCELLED
}

enum ChargeBasis {
  WARRANTY
  CONTRACT
  CHARGEABLE
  GOODWILL
}

/// A request, usually from sales, for service work to be done. The
/// AUTHORISATION document: approval schedules exactly one ServiceVisit (the
/// attendance record) and the engineer's approved ServiceReport (the evidence)
/// completes it. It carries no cost of its own; cost reaches its jobId through
/// PRs, stock issues, overtime and expense claims that quote that job.
model JobOrder {
  id                 String         @id @default(cuid())
  /// The costing's Labor cost when the Technical Manager approved an Amount
  /// that differs from it — approval is the agreement (2026-10-16). Null when
  /// the two tallied or no costing stood behind it.
  laborCostingAmount Decimal?       @db.Decimal(18, 2)
  laborAgreedById    String?
  laborAgreedAt      DateTime?
  number             String         @unique
  status             JobOrderStatus @default(DRAFT)
  category           JobOrderCategory @default(PROJECT)
  kind               ServiceKind    @default(CORRECTIVE)
  urgent             Boolean        @default(false)

  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  siteId     String?
  site       CustomerSite?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  contactId  String?
  contact    CustomerContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assetId    String?
  asset      InstalledAsset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  title       String
  description String
  scope       String?

  /// When the customer wants it. Becomes the visit's dueDate.
  requestedFor DateTime @db.Date

  /// The DECISION. Defaulted from the facts, overridable, checked at approval.
  chargeBasis   ChargeBasis @default(CHARGEABLE)
  /// The FACT: asset.warrantyEndsAt >= requestedFor, computed server-side.
  underWarranty Boolean     @default(false)

  contractId   String?
  contract     ServiceContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  /// Charge-to job: the contract's job for CONTRACT, the installing project for
  /// WARRANTY, the requester's choice (or null) otherwise.
  jobId        String?
  job          Job?             @relation("JobOrderChargeTo", fields: [jobId], references: [id], onDelete: SetNull)
  quotationId  String?
  quotation    Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  /// The sales order the work was booked on, when there is one (2026-10-09).
  salesOrderId String?
  salesOrder   SalesOrder?      @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)

  /// The project work order's own facts (2026-10-09, the owner's call): the
  /// project's name, the contact's number, the target start and finish —
  /// the working days between them are computed, never stored — and the
  /// people to send. `kind`, `urgent`, `assetId`, `chargeBasis`, `contractId`
  /// and `requestedFor` are the service-call shape of before; orders raised
  /// since carry none of them (requestedFor mirrors targetStart).
  projectName   String?
  contactNumber String?
  /// The team asking for the work (the Industry/team master; 2026-10-16) —
  /// the requester's own team unless picked.
  teamId        String?
  team          Industry? @relation("JobOrderTeam", fields: [teamId], references: [id], onDelete: SetNull)
  targetStart   DateTime? @db.Date
  targetFinish  DateTime? @db.Date

  customerPoNumber String?
  /// Agreed price for chargeable work; null = billed on completion (T&M).
  amount           Decimal? @db.Decimal(18, 2)

  requestedById String
  requestedBy   User    @relation("JobOrderRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  assignedToId  String?
  assignedTo    User?   @relation("JobOrderEngineer", fields: [assignedToId], references: [id], onDelete: SetNull)

  /// Personnel to send: the project manager (who approves the order first),
  /// the project engineer, the project lead, and any number of support.
  projectManagerId  String?
  projectManager    User?             @relation("JobOrderProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  projectEngineerId String?
  projectEngineer   User?             @relation("JobOrderProjectEngineer", fields: [projectEngineerId], references: [id], onDelete: SetNull)
  projectLeadId     String?
  projectLead       User?             @relation("JobOrderProjectLead", fields: [projectLeadId], references: [id], onDelete: SetNull)
  support           JobOrderSupport[]

  customerAcknowledgedBy String?
  customerAcknowledgedAt DateTime?

  approvedAt   DateTime?
  completedAt  DateTime? @db.Date
  cancelledAt  DateTime?
  cancelReason String?
  notes        String?

  visit        ServiceVisit?
  invoice      Invoice?
  cadJobOrders CadJobOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, requestedFor])
  @@index([category, status])
  @@index([customerId])
  @@index([assetId])
  @@index([requestedById])
  @@index([assignedToId, status])
  @@index([salesOrderId])
}

/// Project support on a job order: one row per person sent (2026-10-09).
model JobOrderSupport {
  jobOrderId String
  jobOrder   JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([jobOrderId, userId])
}

/// A versioned form definition (model §4.5: "report templates are data").
///
/// A template is IMMUTABLE once a report has been written against it. Editing
/// publishes a new version under the same key; reports keep pointing at the
/// exact version they were filled in on, so an old report renders forever the
/// way it was signed.
model ReportTemplate {
  id          String      @id @default(cuid())
  /// Stable across versions. Duplicating a template gives a new key.
  key         String
  version     Int         @default(1)
  kind        ServiceKind
  name        String
  description String?

  /// [{ key, title, help?, fields: [{ key, label, type, options?, required?,
  ///    unit? }], allowPhotos?: boolean }]
  sections Json

  /// Only one version per key is the one new reports get.
  isCurrent Boolean @default(true)
  isActive  Boolean @default(true)

  createdById String?
  createdBy   User?   @relation("TemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  reports ServiceReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, version])
  @@index([kind, isCurrent])
}

enum ReportStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

/// A commissioning, PM, inspection or corrective report.
///
/// One document type with a kind, rather than three near-identical tables: the
/// fields that differ between them live in the template, which is data.
model ServiceReport {
  id     String       @id @default(cuid())
  number String       @unique
  kind   ServiceKind
  status ReportStatus @default(DRAFT)

  visitId String?       @unique
  visit   ServiceVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  contractId String?
  contract   ServiceContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  /// The project, for a commissioning report written at turnover.
  jobId String?
  job   Job?    @relation("ServiceReportJob", fields: [jobId], references: [id], onDelete: SetNull)

  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  siteId     String?
  site       CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  assetId String?
  asset   InstalledAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  /// The exact template VERSION this was filled in on.
  templateId String
  template   ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  performedAt   DateTime @db.Date
  performedById String
  performedBy   User     @relation("ReportAuthor", fields: [performedById], references: [id], onDelete: Restrict)

  /// The filled form: { [sectionKey]: { [fieldKey]: value, __photos?: [id] } }.
  data Json

  findings        String?
  recommendations String?
  /// Whether the work was covered — warranty, contract, or billable. Decided
  /// when the report is written, because that is when someone knows.
  billable        Boolean @default(false)
  underWarranty   Boolean @default(false)

  /// Acknowledged on site. A service report nobody signed is an assertion.
  customerSignedBy String?
  customerSignedAt DateTime?

  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, status])
  @@index([customerId])
  @@index([assetId])
  @@index([performedAt])
}

// ═══════════════════════════════════════════════════════════════════════════
//  CAD JOB ORDERS (2026-10-09, the owner's call)
// ═══════════════════════════════════════════════════════════════════════════

/// Where a CAD job order stands. Requested → In progress → For review (a
/// revision was submitted) → Completed (the requestor accepts) or Changes
/// requested (back to In progress for the next revision); On hold and
/// Cancelled from either side. Overdue is derived from `neededBy`, never stored.
enum CadJobOrderStatus {
  /// Raised, not yet sent to the requester's Team Leader (2026-10-16).
  DRAFT
  /// With the requester's Team Leader ("TL Approval").
  PENDING_APPROVAL
  REQUESTED
  IN_PROGRESS
  FOR_REVIEW
  CHANGES_REQUESTED
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum CadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// What kind of drawing is asked for — Layout plan, P&ID, single-line… Admin
/// › Categories; the seeded rows are system rows (renamable, undeletable).
/// What a service document is (2026-10-20, the owner's revised Aftermarket
/// UI): Admin › Categories › Service document categories — Manual, Electrical
/// drawing, Test report … System rows: renamable, undeletable, switched off
/// rather than removed; an administrator may add more.
model ServiceDocumentCategory {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  documents   ServiceDocument[]
  createdById String?
}

/// A technical document on the Aftermarket side (2026-10-20): a manual, an
/// electrical drawing, a test report, a datasheet — filed against a MACHINE
/// on the Installation Base or against a MODEL (an item), either. The file
/// itself is an attachment on `service_document` (a PDF, a picture, a CAD
/// file — the CAD ceiling applies).
model ServiceDocument {
  id          String  @id @default(cuid())
  title       String
  description String?

  categoryId String
  category   ServiceDocumentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  assetId String?
  asset   InstalledAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  itemId  String?
  item    Item?           @relation(fields: [itemId], references: [id], onDelete: SetNull)

  /// The document's own version and date, as printed on it.
  version      String?
  documentDate DateTime? @db.Date
  isActive     Boolean   @default(true)

  createdById String
  createdBy   User     @relation("ServiceDocumentFiler", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([assetId])
  @@index([itemId])
  @@index([categoryId])
}

model CadDrawingType {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  requests    CadJobOrder[]
  // Who added it (2026-10-18): "Edit Own" on Admin › Roles reads it.
  createdById String?
}

/// A request to the design team for a drawing: the design team's one queue.
/// Sales, project managers and engineers raise it for a customer, linked to
/// the quotation, project or job order it is for; the Designer Lead
/// dispatches it (or a designer takes it), the designer reports progress and
/// submits REVISIONS (R0, R1 … each with its own files, never overwritten),
/// and the requestor accepts or asks for changes in the comment thread. It
/// carries no money and routes through no approval: it is work, not a
/// decision.
model CadJobOrder {
  id          String            @id @default(cuid())
  number      String            @unique
  status      CadJobOrderStatus @default(REQUESTED)
  /// Set by the design team, never by the requestor (the owner's call).
  priority    CadPriority       @default(NORMAL)
  /// 0–100, the designer's own estimate; 100 once a revision is submitted.
  progressPct Int               @default(0)

  title         String
  drawingTypeId String?
  drawingType   CadDrawingType? @relation(fields: [drawingTypeId], references: [id], onDelete: SetNull)
  /// The complete details of what is wanted, in one box.
  scope         String

  customerId  String
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  jobId       String?
  job         Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  jobOrderId  String?
  jobOrder    JobOrder?  @relation(fields: [jobOrderId], references: [id], onDelete: SetNull)

  requestedById String
  requestedBy   User      @relation("CadRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  /// When the design work is planned to start (the requestor's form).
  plannedStart  DateTime? @db.Date
  /// When the requestor needs the drawing. A DATE; overdue is derived from it.
  neededBy      DateTime? @db.Date

  assignedToId String?
  assignedTo   User?     @relation("CadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?
  /// When a designer first took it or was given it ("Date started"; 2026-10-16).
  startedAt    DateTime?

  /// The requester's team (the Industry/team master), set at raising.
  teamId String?
  team   Industry? @relation("CadJobOrderTeam", fields: [teamId], references: [id], onDelete: SetNull)
  /// What the drawing work is worth, when the requester says (PHP).
  amount Decimal?  @db.Decimal(18, 2)

  holdReason       String?
  /// Where it stood when it was put on hold, so Resume puts it back there.
  statusBeforeHold CadJobOrderStatus?
  cancelReason     String?
  cancelledAt      DateTime?
  completedAt      DateTime?
  completedById    String?
  completedBy      User?              @relation("CadCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  /// What was said when the request was closed — the requestor's acceptance
  /// note, or the designer's reason for closing it unanswered.
  completionNote   String?

  /// The Approved Plan the accepted revision was filed as, on the linked project.
  approvedPlanId String?       @unique
  approvedPlan   ApprovedPlan? @relation(fields: [approvedPlanId], references: [id], onDelete: SetNull)

  revisions CadRevision[]
  comments  CadComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, priority])
  @@index([assignedToId, status])
  @@index([requestedById, status])
  @@index([customerId])
  @@index([jobId])
  @@index([neededBy])
}

/// One submission of the drawing: R0, R1, R2… Its files are attachments on
/// `cad_revision`; a revision is never edited or overwritten, so every earlier
/// one can still be opened — that is the traceability.
model CadRevision {
  id            String      @id @default(cuid())
  cadJobOrderId String
  cadJobOrder   CadJobOrder @relation(fields: [cadJobOrderId], references: [id], onDelete: Cascade)
  /// 0 for R0.
  sequence      Int
  /// What changed, or what this first issue covers.
  note          String
  /// A link to a file too big to upload (a shared drive), http(s) only.
  externalUrl   String?
  submittedById String
  submittedBy   User        @relation("CadRevisionSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt   DateTime    @default(now())

  comments CadComment[]

  @@unique([cadJobOrderId, sequence])
}

/// The thread between the requestor and the designer: a change request, a
/// clarification, a detail update. Permanent. May carry files (attachments on
/// `cad_comment`) and may name the revision it is about.
model CadComment {
  id              String       @id @default(cuid())
  cadJobOrderId   String
  cadJobOrder     CadJobOrder  @relation(fields: [cadJobOrderId], references: [id], onDelete: Cascade)
  revisionId      String?
  revision        CadRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  authorId        String
  author          User         @relation("CadCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body            String
  /// A comment that asked for changes, so the thread shows it as such.
  isChangeRequest Boolean      @default(false)
  createdAt       DateTime     @default(now())

  @@index([cadJobOrderId, createdAt])
}

// ── Help tickets (2026-10-11) ───────────────────────────────────────────────
// The Help box on every page: anybody signed in raises a ticket for an
// improvement, a fault or a question, with a screenshot of the screen they
// were on; super admins are told and answer it in Admin › Help Tickets.

enum HelpTicketKind {
  IMPROVEMENT
  PROBLEM
  QUESTION
}

enum HelpTicketStatus {
  NEW
  IN_PROGRESS
  DONE
  WONT_DO
}

model HelpTicket {
  id          String            @id @default(cuid())
  number      String            @unique
  kind        HelpTicketKind    @default(IMPROVEMENT)
  subject     String
  description String
  status      HelpTicketStatus  @default(NEW)
  /// Where the person was when they raised it — the page's path and query.
  pagePath    String?
  /// The browser and the window size, for a fault that shows on one screen only.
  userAgent   String?
  viewport    String?
  createdById String
  createdBy   User              @relation("HelpTicketRaiser", fields: [createdById], references: [id], onDelete: Cascade)
  /// When it was last marked Done or Won't do; null while it is open.
  closedAt    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  replies     HelpTicketReply[]

  @@index([createdById, createdAt])
  @@index([status, createdAt])
}

model HelpTicketReply {
  id        String            @id @default(cuid())
  ticketId  String
  ticket    HelpTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Null once the login that wrote it is gone; the reply stays in the thread.
  authorId  String?
  author    User?             @relation("HelpTicketReplyAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  /// The status this reply moved the ticket to, when it did.
  status    HelpTicketStatus?
  createdAt DateTime          @default(now())

  @@index([ticketId, createdAt])
}

/// Where a Back Support person supports (2026-10-12, the owner's call: "even
/// they are reporting to specific manager, allow me to set where they support
/// in back admin"). A team-scoped ROLE step goes to the holders who support the
/// requester's team; nobody set means every holder, as before.
model UserSupportTeam {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  industryId String
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@id([userId, industryId])
  @@index([industryId])
}

enum InvoiceRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  CANCELLED
}

/// An INVOICE REQUEST (2026-10-15, the owner's call): the project's
/// salesperson or their Team Leader asks for an approved progress billing to
/// be invoiced against the project's sales order; Back Support approves it,
/// and the approval raises the DRAFT invoice in Accounts Receivable. The
/// money is the billing's, never re-keyed; the order lends its PO and terms.
model InvoiceRequest {
  id      String               @id @default(cuid())
  number  String
  /// The withholding rate the invoice will carry (2026-10-16: editable, e.g.
  /// 1% or 2%); null takes the billing's, else the company's.
  ewtRate Decimal?             @db.Decimal(5, 4)
  status  InvoiceRequestStatus @default(DRAFT)

  /// The progress billing it asks to be invoiced — or none, when the request
  /// is raised straight from an issued sales order (2026-10-16, the owner's
  /// call: "after Sales Order, route to invoice request").
  progressBillingId String?
  progressBilling   ProgressBilling? @relation(fields: [progressBillingId], references: [id], onDelete: Cascade)
  jobId             String?
  job               Job?             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  salesOrderId      String
  salesOrder        SalesOrder       @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  /// A request from a sales order: what to invoice of it, before VAT, and
  /// the invoice line's words. Null on a billing's request (its gross is the
  /// billing's).
  grossAmount       Decimal?         @db.Decimal(18, 2)
  description       String?

  /// The BIR printed sales invoice number set aside for it (2026-10-20, the
  /// owner's call: "invoice request for uncountered / reserved S.I."): typed
  /// on the request, carried to the invoice its approval raises — which reads
  /// "Reserved SI …" until the customer counters it. One live request or
  /// invoice holds a number.
  siNumber      String?
  /// What the invoice will carry.
  invoiceDate   DateTime? @db.Date
  termsDays     Int?
  poReference   String?
  salespersonId String?
  salesperson   User?     @relation("InvoiceRequestSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  teamId        String?
  team          Industry? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  notes         String?

  requestedById String
  requestedBy   User      @relation("InvoiceRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  submittedAt   DateTime?
  approvedAt    DateTime?
  cancelReason  String?

  /// The DRAFT invoice its approval raised.
  invoiceId String?  @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([number])
  @@index([siNumber])
  @@index([progressBillingId, status])
  @@index([salesOrderId, status])
  @@index([status, createdAt])
}

/// COMMISSION REQUESTS (2026-10-16, the owner's "Commission Request System"):
/// a sales order's commission, raised once the order is fully collected,
/// split among the people who earned it, approved by the Finance Manager
/// then the CEO / President, and paid by finance — each beneficiary's cash
/// advance deduction recorded as a repayment of that advance.
enum CommissionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

enum CommissionType {
  INDIVIDUAL
  GROUP
}

model CommissionRequest {
  id     String           @id @default(cuid())
  number String
  status CommissionStatus @default(DRAFT)

  salesOrderId  String
  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  customerId    String
  customer      Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  jobId         String?
  job           Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  requestedById String
  requestedBy   User       @relation("CommissionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  salespersonId String?
  salesperson   User?      @relation("CommissionSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  teamId        String?
  team          Industry?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  commissionType CommissionType @default(INDIVIDUAL)
  /// The total commission rate, a fraction (0.10 = 10%).
  ratePct        Decimal        @default(0) @db.Decimal(9, 6)

  /// The sales order's figures, snapshotted when saved (shared/commission.ts).
  totalAmount     Decimal @default(0) @db.Decimal(18, 2)
  netOfVat        Decimal @default(0) @db.Decimal(18, 2)
  vatAmount       Decimal @default(0) @db.Decimal(18, 2)
  totalCost       Decimal @default(0) @db.Decimal(18, 2)
  margin          Decimal @default(0) @db.Decimal(18, 2)
  collectedAmount Decimal @default(0) @db.Decimal(18, 2)
  grossCommission Decimal @default(0) @db.Decimal(18, 2)
  totalTax        Decimal @default(0) @db.Decimal(18, 2)
  totalCa         Decimal @default(0) @db.Decimal(18, 2)
  totalNet        Decimal @default(0) @db.Decimal(18, 2)

  /// The collections' official receipt numbers and the latest collection's day.
  orNumbers   String?
  collectedOn DateTime? @db.Date

  notes        String?
  cancelReason String?
  submittedAt  DateTime?
  approvedAt   DateTime?
  paidAt       DateTime?

  shares CommissionShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([number])
  @@index([salesOrderId])
  @@index([requestedById])
  @@index([status])
}

model CommissionShare {
  id        String            @id @default(cuid())
  requestId String
  request   CommissionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation("CommissionBeneficiary", fields: [userId], references: [id], onDelete: Restrict)
  position  String?

  sharePct      Decimal      @default(1) @db.Decimal(9, 6)
  share         Decimal      @default(0) @db.Decimal(18, 2)
  taxPct        Decimal      @default(0.1) @db.Decimal(9, 6)
  tax           Decimal      @default(0) @db.Decimal(18, 2)
  caDeduction   Decimal      @default(0) @db.Decimal(18, 2)
  /// The repayable cash advance the deduction repays.
  cashAdvanceId String?
  cashAdvance   CashAdvance? @relation(fields: [cashAdvanceId], references: [id], onDelete: SetNull)
  net           Decimal      @default(0) @db.Decimal(18, 2)
  sortOrder     Int          @default(0)

  /// The payout voucher, once paid.
  paymentId   String?
  payment     Payment?            @relation("CommissionPayout", fields: [paymentId], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[] @relation("CommissionAllocation")

  @@index([requestId])
  @@index([userId])
}

/// One line of a cash advance's breakdown — what the cash buys.
model CashAdvanceItem {
  id          String      @id @default(cuid())
  advanceId   String
  advance     CashAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  sortOrder   Int         @default(0)
  name        String
  description String?
  quantity    Decimal     @db.Decimal(18, 3)
  unit        String      @default("pcs")
  unitCost    Decimal     @db.Decimal(18, 2)
  amount      Decimal     @db.Decimal(18, 2)

  @@index([advanceId])
}

/// A quotation revision quoted from more than one costing (2026-10-19, the
/// owner's call: "sometimes there will be 2 costings to generate the quotation
/// or project"). `QuotationRevision.costingId` stays the FIRST costing; these
/// rows are the others, in order — `revisionCostingIds()` in
/// `shared/costingSets.ts` reads both as one list.
model QuotationRevisionCosting {
  revisionId String
  revision   QuotationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  costingId  String
  costing    Costing           @relation(fields: [costingId], references: [id], onDelete: Cascade)
  sortOrder  Int               @default(0)

  @@id([revisionId, costingId])
  @@index([costingId])
}

/// A project built from more than one costing (2026-10-19). `Job.costingId`
/// stays the FIRST; these are the others, in order. Each one's scope is
/// snapshotted into the project's scope items, its buckets into the opening
/// budget, and it is marked FINAL — a costing that produced a project is a
/// commercial record, so the link restricts its deletion as the first does.
model JobCostingLink {
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  costingId String
  costing   Costing @relation(fields: [costingId], references: [id], onDelete: Restrict)
  sortOrder Int     @default(0)

  @@id([jobId, costingId])
  @@index([costingId])
}
