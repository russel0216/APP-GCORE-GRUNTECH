# Copy to api/.env and adjust.

# Local Postgres from docker-compose.yml (host port 5433 to avoid collisions)
DATABASE_URL="postgresql://gcore:gcore@localhost:5433/gcore"

PORT=5100
NODE_ENV=development

# Generate a real secret before this ever leaves the laptop:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="12h"

# Where uploads and the company logo live
# Leave blank to use api/uploads
# UPLOAD_DIR=""
MAX_UPLOAD_MB=25

# Vite dev server
CORS_ORIGIN="http://localhost:5173"

# Email for invitations and password resets — off while SMTP_HOST is empty,
# and then each link is shown to the administrator to pass on instead.
# See deploy/env.production.example for the providers.
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="G-CORE <no-reply@example.com>"

# Only read by the seed script
SEED_ADMIN_EMAIL="admin@gruntech.com"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
